#!/usr/bin/env bash
# wt-enter — rerun-safely resolve a task worktree under this container's
# .worktrees/$CONTAINER_NAME/ subdir and print its absolute path.
#
# Usage: wt-enter <slug> <branch> [<base>]
#
#   <slug>    worktree directory name (task identifier; [A-Za-z0-9._-], must
#             not start with a dot or dash)
#   <branch>  the branch that must be checked out in that worktree
#   <base>    ref to create <branch> from when it does not exist yet; OMIT it
#             for stages that must never create work (e.g. a reviewer attaching
#             to an implementer's worktree — a missing branch is then an error,
#             not a silent fresh checkout that reviews an empty diff)
#
# Exactly one of three rerun-safe outcomes (matching the worktree-running skills):
#   * worktree exists and is on <branch>  -> reuse it (prior commits intact)
#   * branch exists without its worktree  -> attach it (no -b)
#   * neither exists                      -> create branch off <base> (-b)
# An orphaned dir (stale from a recycled container) is pruned and recreated.
#
# When <branch> cannot be attached because it is already checked out elsewhere,
# the blocking worktree is named — and, when it is the repository's PRIMARY
# checkout (shared with humans and peer agents), the error says so explicitly
# instead of leaving git's bare "already used by worktree at ..." to be misread
# as a stale worktree. Nothing is ever auto-detached or auto-switched, and no
# remedy that could DISCARD the blocking worktree is ever suggested (see the
# note above worktree_add).
#
# stdout is ONLY the worktree path, so callers can `WT="$(wt-enter ...)"`;
# diagnostics go to stderr. Non-zero exit means the caller must STOP and
# report, never improvise a checkout.
set -euo pipefail

die() {
	echo "wt-enter: $*" >&2
	exit 1
}

# shq <string> — render <string> as ONE shell-safe token, for the inspection
# commands the diagnostics below suggest. Repository and worktree paths are not
# guaranteed to be free of spaces or shell metacharacters (a human-created
# worktree can live anywhere), and a suggested command is only useful if it can
# be pasted verbatim — and only safe if pasting it cannot run something else.
# `printf %q` leaves an ordinary path byte-identical, so the common case still
# reads as a plain path.
shq() { printf '%q' "$1"; }

# Shared worktree helpers (safe orphan reaping). Prefer the sibling copy so
# tests exercise the checked-out version; fall back to the baked one. BASH_SOURCE
# resolves to the full script path even when invoked via PATH, so dirname is safe.
_wt_common=""
for _cand in "$(dirname "${BASH_SOURCE[0]}")/wt-common.sh" "/usr/local/bin/wt-common.sh"; do
	if [ -r "$_cand" ]; then
		_wt_common="$_cand"
		break
	fi
done
[ -n "$_wt_common" ] || die "cannot locate wt-common.sh"
# shellcheck source=docker/shared/wt-common.sh
. "$_wt_common"
unset _wt_common _cand

if [ $# -lt 2 ] || [ $# -gt 3 ]; then die "usage: wt-enter <slug> <branch> [<base>]"; fi
SLUG="$1"
BRANCH="$2"
BASE="${3:-}"

case "$SLUG" in
[A-Za-z0-9_]*) ;;
*) die "invalid slug '$SLUG' (must start with an alphanumeric or underscore)" ;;
esac
printf '%s' "$SLUG" | LC_ALL=C grep -Eq '^[A-Za-z0-9._-]+$' ||
	die "invalid slug '$SLUG' (allowed: A-Za-z0-9._-)"

GIT_COMMON="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
	die "not inside a git repository"
case "$GIT_COMMON" in
*/.git) ROOT="${GIT_COMMON%/.git}" ;;
*) die "cannot resolve the main repo root from $GIT_COMMON" ;;
esac
WT_BASE="$ROOT/.worktrees/${CONTAINER_NAME:?CONTAINER_NAME must be set}"
WT="$WT_BASE/$SLUG"

if [ -d "$WT" ]; then
	if git -C "$WT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		TOP="$(git -C "$WT" rev-parse --show-toplevel)"
		[ "$TOP" = "$WT" ] ||
			die "$WT is inside another worktree (toplevel: $TOP); refusing"
		CUR="$(git -C "$WT" branch --show-current)"
		[ "$CUR" = "$BRANCH" ] ||
			die "worktree $WT is on branch '$CUR', expected '$BRANCH'; refusing to switch — resolve manually"
		printf '%s\n' "$WT"
		exit 0
	fi
	# Not a live worktree. With durable metadata a recycled worktree is reused
	# above, so this is a partial create or a PRE-durable-metadata orphan whose
	# tmpfs .git/worktrees was lost. Reap it SAFELY: empty dirs are removed;
	# a non-empty dir (possibly the sole copy of dirty work) is moved to a
	# quarantine dir, never deleted, and we recreate the worktree fresh beside it.
	_outcome="$(wt_reap_orphan_dir "$WT")"
	case "$_outcome" in
	quarantined:*)
		echo "wt-enter: preserved orphan at ${_outcome#quarantined:}; recreating $WT fresh" >&2
		;;
	kept)
		die "orphaned dir $WT holds unsaved work that could not be quarantined; move it aside manually, then retry"
		;;
	*)
		echo "wt-enter: cleared empty orphaned worktree dir $WT" >&2
		;;
	esac
	unset _outcome
	git -C "$ROOT" worktree prune
fi

# worktree_add <git worktree add args...>
#   Run `git worktree add` and, when it fails, diagnose the one failure agents
#   routinely misread: <branch> is already checked out in another worktree. The
#   blocking worktree is identified from `git worktree list --porcelain` (a
#   documented machine format) — never by matching git's localizable fatal text —
#   and the message is tailored when the blocker is the PRIMARY checkout, which
#   is shared with humans and peer agents and must not be detached blindly.
#   Nothing is remediated automatically. git's own output is redirected — not
#   captured — so stdout stays path-only for callers while git keeps streaming
#   live to a terminal on fd 2; only its exit status is taken, and preserved.
#
#   The diagnosis NAMES the blocker and stops there: it never suggests removing
#   or otherwise discarding that worktree, not even conditionally, and it does not
#   prescribe how to clear what is in flight there either — "finish or abort it"
#   is the same loss by another route, since every `--abort` throws away whatever
#   conflict resolution has been done. Deciding that a worktree is safe to delete
#   would mean enumerating every state git can leave behind (rebase, am,
#   cherry-pick, revert/sequencer, merge, bisect, ...) and keeping that list in
#   lockstep with wt-remove's independently maintained guards; the gap between the
#   two lists is a deleted worktree, and it has bitten more than once. The one
#   remedy offered is git's own `worktree prune`, for a blocker whose directory is
#   already gone — it drops a stale record and can destroy nothing. Everything
#   else is "go look at it yourself, or ask whoever owns it", which is
#   non-destructive by construction and needs no such list.
#
#   The diagnosis is deliberately SUPPRESSED when the resolved blocker is the
#   destination worktree itself: `git worktree add` also fails when $WT is
#   registered but missing on disk (a hand-deleted dir, or a pre-durable-metadata
#   leftover), and git's own message then already carries the right remedy
#   ("prune"/"remove"). Appending "that branch is used by another worktree at
#   <the very path you asked for>" would displace correct advice with a dead end.
worktree_add() {
	local rc=0 blocker primary
	# `>&2` (rather than a command substitution) keeps both of git's streams
	# unbuffered and tty-attached, so progress rendering still works; folding
	# git's stdout into ours would break the path-only stdout contract.
	git -C "$ROOT" worktree add "$@" >&2 || rc=$?
	[ "$rc" -ne 0 ] || return 0

	# A non-zero return from the resolver means "unknown" (git's failure had
	# some other cause, or no worktree could be identified) — then git's own
	# message above is all we have, and that is fine. So is a blocker that IS
	# the destination (see the note above).
	if blocker="$(wt_worktree_for_branch "$ROOT" "$BRANCH")" && [ "$blocker" != "$WT" ]; then
		primary="$(wt_primary_checkout "$ROOT" || printf '%s\n' "$ROOT")"
		if [ "$blocker" = "$primary" ] || [ "$blocker" = "$ROOT" ]; then
			echo "wt-enter: branch '$BRANCH' is checked out in the repository's PRIMARY (main) working tree at $blocker — not in a task worktree." >&2
			echo "wt-enter: that checkout is SHARED with humans and with any peer agent in this container; someone may be working on '$BRANCH' there right now." >&2
			echo "wt-enter: nothing was changed. Do NOT detach or switch the main checkout blindly — either run this task on a different branch, or coordinate with whoever owns that checkout before moving it off '$BRANCH', then rerun wt-enter." >&2
		else
			echo "wt-enter: branch '$BRANCH' is already checked out in another worktree at $blocker; git refuses to check one branch out twice." >&2
			if [ ! -d "$blocker" ]; then
				echo "wt-enter: nothing was changed. That worktree is registered in git's metadata but MISSING on disk. Run 'git -C $(shq "$ROOT") worktree prune' to drop the stale record, then rerun wt-enter." >&2
			else
				# No remedy is suggested, whatever state that worktree is in:
				# git may have left a rebase, am, cherry-pick, revert or bisect
				# there that `git status` does not flag, and only its owner can
				# see which — or decide what it is worth. Naming it and handing
				# over is what cannot go wrong.
				echo "wt-enter: nothing was changed. That worktree may hold uncommitted work, or an unfinished rebase, am, cherry-pick, revert or bisect that 'git status' does not show — so wt-enter neither touches it nor tells you what to do with it." >&2
				echo "wt-enter: look at it yourself: 'git -C $(shq "$blocker") status' (plus 'git -C $(shq "$blocker") bisect log' if a bisect may be running), or coordinate with whoever owns that worktree. Rerun wt-enter once '$BRANCH' is free." >&2
				echo "wt-enter: running this task on a different branch avoids the conflict entirely." >&2
			fi
		fi
	fi
	exit "$rc"
}

mkdir -p "$WT_BASE"
if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
	# Existing branch (interrupted run / post-cleanup rerun): attach, never -b.
	# git itself refuses if the branch is checked out in another worktree.
	worktree_add "$WT" "$BRANCH"
else
	[ -n "$BASE" ] ||
		die "branch '$BRANCH' does not exist and no <base> was given (this stage must not create it)"
	git -C "$ROOT" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null ||
		die "base ref '$BASE' does not resolve to a commit"
	worktree_add "$WT" -b "$BRANCH" "$BASE"
fi

TOP="$(git -C "$WT" rev-parse --show-toplevel)"
[ "$TOP" = "$WT" ] || die "post-create verification failed: toplevel is $TOP, expected $WT"
CUR="$(git -C "$WT" branch --show-current)"
[ "$CUR" = "$BRANCH" ] || die "post-create verification failed: on branch '$CUR', expected '$BRANCH'"

printf '%s\n' "$WT"
