#!/usr/bin/env bash
# peer-review-run — bidirectional, provider-neutral peer-review runner.
#
# A Claude-led workflow reviews with Codex, and a Codex-led workflow reviews
# with Claude, through ONE command interface and ONE machine-readable result
# contract. The helper owns the mechanics that peer reviews previously required
# by hand: a private owner-only artifact directory, literal (never shell-eval'd)
# prompt handling, read-only provider execution, process-group supervision with
# a timeout, a retry-once policy for transient failures, result parsing, and
# process reaping on every exit path.
#
# Usage:
#   peer-review-run --provider <claude|codex> \
#                   --worktree <ABS_DIR> \
#                   --prompt-file <FILE> \
#                   --artifact-root <ABS_DIR> \
#                   [--base <REF>] [--timeout <SECONDS>]
#
#   --provider       claude | codex — the PEER that reviews (the opposite agent).
#   --worktree       absolute path to the checkout the peer reviews (read-only).
#   --prompt-file    file whose CONTENTS are the literal review prompt; fed to
#                    the provider on stdin, never interpolated through a shell.
#   --artifact-root  absolute directory OUTSIDE the worktree under which a
#                    per-invocation owner-only (0700) session dir is created, with
#                    a fresh owner-only attempt dir per attempt nested inside it
#                    (so the provider only ever sees this invocation's attempts).
#   --base           optional base/reference metadata (recorded, not injected).
#   --timeout        wall-clock seconds before the provider tree is reaped
#                    (default 900).
#
# Result contract (schema powbox.peer-review-run/v1): the FINAL line of stdout
# is a single JSON object:
#   { schema, provider, outcome, verdict, elapsedSeconds, exitStatus, attempts,
#     retried, liveProgress, artifactDir, reason }
#   outcome  ∈ passed | issues | unavailable | timeout | forfeited | failed
#   verdict  ∈ pass | issues | none   (normalized from the peer's final message)
#   exitStatus  the provider exit code, or null when unknown (missing binary /
#               killed on timeout).
# The helper NEVER reports success because an output file is absent or empty.
# It exits 0 for ANY produced outcome (the outcome is a non-blocking signal for
# the caller to weigh) and non-zero ONLY for its own usage/operational errors.
#
# Progress: while running, `liveProgress:true` providers (Codex, when the
# installed CLI supports `--json`) stream normalized progress events to STDERR;
# a buffered provider (Claude) is represented honestly with liveProgress:false
# and a single up-front note rather than a simulated heartbeat. stdout stays a
# single parseable JSON object regardless.
#
# This helper SUPPLEMENTS but does not replace a fresh reviewer subagent gate,
# and no peer outcome is required for publication.
set -uo pipefail

readonly SCHEMA="powbox.peer-review-run/v1"
readonly DEFAULT_TIMEOUT=900

# EX_USAGE-style exit for the helper's OWN errors (never a peer outcome).
EX_USAGE=64

usage() {
	sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//'
}

die_usage() {
	echo "peer-review-run: $*" >&2
	echo "Try: peer-review-run --provider <claude|codex> --worktree <dir> --prompt-file <file> --artifact-root <dir>" >&2
	exit "$EX_USAGE"
}

# --- process-group supervision ----------------------------------------------
# The currently supervised job's leader pid and validated process-group id. The
# EXIT/INT/TERM trap reaps the tree so a helper interrupted mid-review never
# leaves a live peer process. CURRENT_PGID is set ONLY after we confirm the child
# is the leader of its own group (pgid == leader pid); it stays empty otherwise
# so we never send a negative-PID (whole-group) signal against an unvalidated —
# possibly the helper's own — process group.
CURRENT_LEADER=""
CURRENT_PGID=""

# group_alive <leader_pid> <pgid|""> — is any member of the supervised tree still
# alive? Uses the validated group when we have one, else just the leader pid.
group_alive() {
	local pid="$1" pgid="$2"
	if [ -n "$pgid" ]; then
		kill -0 "-${pgid}" 2>/dev/null
	else
		kill -0 "$pid" 2>/dev/null
	fi
}

# signal_tree <SIG> <leader_pid> <pgid|""> — deliver a signal to the whole
# validated group, or (fallback) only the leader pid. NEVER a negative,
# unvalidated PID; never pkill -f.
signal_tree() {
	local sig="$1" pid="$2" pgid="$3"
	if [ -n "$pgid" ]; then
		kill "-${sig}" "-${pgid}" 2>/dev/null || true
	else
		kill "-${sig}" "$pid" 2>/dev/null || true
	fi
}

# reap_tree <leader_pid> <pgid|""> — TERM the tree, WAIT a bounded grace, then
# escalate to KILL for survivors, and confirm nothing remains. Used on EVERY
# terminating path (timeout AND normal/failed exit) so no descendant outlives the
# run. Returns 0 when the tree is gone, 1 if something survived even after KILL.
reap_tree() {
	local pid="$1" pgid="$2" i
	group_alive "$pid" "$pgid" || return 0
	signal_tree TERM "$pid" "$pgid"
	# Bounded grace (~3s) for a well-behaved tree to exit on TERM.
	for ((i = 0; i < 30; i++)); do
		group_alive "$pid" "$pgid" || return 0
		sleep 0.1
	done
	# Survivors ignored TERM: escalate to KILL and confirm they actually die.
	signal_tree KILL "$pid" "$pgid"
	for ((i = 0; i < 20; i++)); do
		group_alive "$pid" "$pgid" || return 0
		sleep 0.1
	done
	return 1
}

on_exit() {
	# shellcheck disable=SC2317  # invoked indirectly by the EXIT trap
	[ -n "$CURRENT_LEADER" ] && reap_tree "$CURRENT_LEADER" "$CURRENT_PGID"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# --- argument parsing --------------------------------------------------------
PROVIDER=""
WORKTREE=""
PROMPT_FILE=""
ARTIFACT_ROOT=""
BASE=""
TIMEOUT="$DEFAULT_TIMEOUT"

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--provider)
		PROVIDER="${2:-}"
		shift 2 || die_usage "--provider needs a value"
		;;
	--worktree)
		WORKTREE="${2:-}"
		shift 2 || die_usage "--worktree needs a value"
		;;
	--prompt-file)
		PROMPT_FILE="${2:-}"
		shift 2 || die_usage "--prompt-file needs a value"
		;;
	--artifact-root)
		ARTIFACT_ROOT="${2:-}"
		shift 2 || die_usage "--artifact-root needs a value"
		;;
	--base)
		BASE="${2:-}"
		shift 2 || die_usage "--base needs a value"
		;;
	--timeout)
		TIMEOUT="${2:-}"
		shift 2 || die_usage "--timeout needs a value"
		;;
	--)
		shift
		break
		;;
	-*) die_usage "unknown flag '$1'" ;;
	*) die_usage "unexpected argument '$1'" ;;
	esac
done

# --- validation --------------------------------------------------------------
command -v jq >/dev/null 2>&1 || die_usage "jq is required but not on PATH"

case "$PROVIDER" in
claude | codex) ;;
"") die_usage "--provider is required (claude|codex)" ;;
*) die_usage "unsupported --provider '$PROVIDER' (claude|codex)" ;;
esac

[ -n "$WORKTREE" ] || die_usage "--worktree is required"
case "$WORKTREE" in
/*) ;;
*) die_usage "--worktree must be an absolute path (got '$WORKTREE')" ;;
esac
[ -d "$WORKTREE" ] || die_usage "--worktree '$WORKTREE' is not a directory"
WORKTREE="$(realpath -- "$WORKTREE")" || die_usage "cannot resolve --worktree"

[ -n "$PROMPT_FILE" ] || die_usage "--prompt-file is required"
[ -f "$PROMPT_FILE" ] || die_usage "--prompt-file '$PROMPT_FILE' is not a regular file"
[ -r "$PROMPT_FILE" ] || die_usage "--prompt-file '$PROMPT_FILE' is not readable"
PROMPT_FILE="$(realpath -- "$PROMPT_FILE")" || die_usage "cannot resolve --prompt-file"

[ -n "$ARTIFACT_ROOT" ] || die_usage "--artifact-root is required"
case "$ARTIFACT_ROOT" in
/*) ;;
*) die_usage "--artifact-root must be an absolute path (got '$ARTIFACT_ROOT')" ;;
esac
mkdir -p -- "$ARTIFACT_ROOT" 2>/dev/null || die_usage "cannot create --artifact-root '$ARTIFACT_ROOT'"
ARTIFACT_ROOT="$(realpath -- "$ARTIFACT_ROOT")" || die_usage "cannot resolve --artifact-root"
# The artifact root must live OUTSIDE the worktree: a read-only provider rooted
# at the worktree must not be able to see attempt artifacts, and sibling
# attempts stay isolated (0700). Rooting artifacts under the worktree would
# leak them into the review surface.
case "$ARTIFACT_ROOT/" in
"$WORKTREE/"*) die_usage "--artifact-root must be OUTSIDE --worktree (got '$ARTIFACT_ROOT' under '$WORKTREE')" ;;
esac

# Sibling-attempt isolation. All attempt dirs share ONE Unix owner, so 0700 keeps
# OTHER users out but does NOT stop this owner's read-only provider from reading a
# concurrent invocation's artifacts if it can locate them. We therefore nest every
# attempt of THIS invocation under one per-invocation, unpredictably-named session
# dir (0700) and only ever hand the provider a path INSIDE its own session — the
# directory it is told about (and whose neighbourhood it can list) contains only
# this invocation's own attempts, never a sibling invocation's. Residual, honest:
# a read-only sandbox running as the same UID could still enumerate ARTIFACT_ROOT
# and read another invocation's session by its random name; filesystem permissions
# alone cannot prevent a same-UID reader. The provider's read-only sandbox scope is
# the real trust boundary — this nesting removes trivial "by default" exposure.
SESSION_DIR="$(mktemp -d "${ARTIFACT_ROOT}/prr-XXXXXXXXXXXX")" ||
	die_usage "cannot create a session directory under '$ARTIFACT_ROOT'"
chmod 700 "$SESSION_DIR"

case "$TIMEOUT" in
'' | *[!0-9.]* | '.' | *.*.*) die_usage "--timeout must be a positive number of seconds (got '$TIMEOUT')" ;;
esac
awk -v t="$TIMEOUT" 'BEGIN{exit !(t>0)}' || die_usage "--timeout must be > 0 (got '$TIMEOUT')"

# The peer binary is the OPPOSITE agent's CLI, resolved by provider name.
PEER_BIN="$PROVIDER"

# --- provider capability probe ----------------------------------------------
# Codex can stream structured events with `codex exec --json`, but only when the
# installed CLI supports it. Probe once; represent the result honestly in
# liveProgress rather than assuming. Claude's `-p --output-format json` buffers
# its single final result — no live events — so it is always liveProgress:false.
CODEX_JSON_SUPPORTED=""
codex_supports_json() {
	if [ -z "$CODEX_JSON_SUPPORTED" ]; then
		# Bound the probe: `codex exec --help` should return instantly, but it must
		# never be able to hang or leak descendants, so it runs under `timeout`
		# (which reaps the whole probe tree on expiry). If the probe times out or
		# fails, grep matches nothing and we fall back to the safe no-live-progress
		# default rather than assuming --json support.
		if timeout 10 codex exec --help 2>&1 | grep -q -- '--json'; then
			CODEX_JSON_SUPPORTED=yes
		else
			CODEX_JSON_SUPPORTED=no
		fi
	fi
	[ "$CODEX_JSON_SUPPORTED" = yes ]
}

# LIVE=1 when the provider streams progress this run; drives forward_tick and
# the liveProgress result field.
LIVE=0

# --- provider command builders ----------------------------------------------
# Each builder populates the CMD array. The prompt is NEVER placed on argv or
# expanded by a shell — it is fed on stdin from the attempt's prompt.txt.
CMD=()

build_cmd_claude() {
	# Read-only headless review. Omitting --dangerously-skip-permissions is what
	# keeps it read-only: in non-interactive `-p` mode a tool outside the
	# allowlist cannot prompt, so it is denied and the model continues. The
	# allowlist grants read/inspect tools and safe git reads ONLY — no
	# write-capable command (note `sed` is intentionally absent: `sed -i` writes;
	# every reading need is served by cat/head/tail/rg/grep). The explicit disallow
	# list is defense-in-depth against any edit/write/push tool.
	#   --safe-mode disables CLAUDE.md, skills, plugins, hooks, MCP servers, custom
	#     commands/agents and other customizations, so an untrusted review run
	#     cannot inherit user hooks/MCP state (auth, tools and permissions still
	#     work normally).
	#   --no-session-persistence keeps the prompt and result off disk (no resumable
	#     session), so nothing persists outside this attempt's artifact dir.
	local allow="Read Grep Glob Bash(git diff:*) Bash(git log:*) Bash(git show:*) Bash(git status:*) Bash(git blame:*) Bash(cat:*) Bash(ls:*) Bash(rg:*) Bash(head:*) Bash(tail:*)"
	local deny="Write Edit MultiEdit NotebookEdit Bash(git push:*) Bash(git commit:*) Bash(git reset:*) Bash(rm:*)"
	CMD=(claude -p
		--safe-mode
		--no-session-persistence
		--output-format json
		--allowedTools "$allow"
		--disallowedTools "$deny"
		--add-dir "$WORKTREE")
	LIVE=0
}

build_cmd_codex() {
	# Read-only sandbox rooted at the worktree. `-c mcp_servers={}` stops any
	# configured MCP/server state from leaking into an untrusted review run.
	# --ephemeral runs without persisting session files to disk, so the prompt and
	# transcript do not persist outside this attempt's artifact dir (the explicit
	# --output-last-message file is still written — it is an output target, not a
	# session file). --output-last-message captures the peer's final message for
	# verdict parsing. `-` reads the prompt from stdin. --json (when supported)
	# adds the live event stream we forward.
	local dir="$1"
	CMD=(codex exec
		--sandbox read-only
		--cd "$WORKTREE"
		--ephemeral
		-c "mcp_servers={}"
		--output-last-message "$dir/codex-last-message.txt")
	if codex_supports_json; then
		CMD+=(--json)
		LIVE=1
	else
		LIVE=0
	fi
	CMD+=(-)
}

# --- progress forwarding -----------------------------------------------------
# Forward newly-appended provider stdout lines to STDERR as normalized progress
# events, without a second supervised process: the poll loop calls this each
# tick. Only active when LIVE=1 (Codex --json).
FWD_LINES=0
forward_tick() {
	[ "$LIVE" = 1 ] || return 0
	local f="$1" total i line
	total=$(wc -l <"$f" 2>/dev/null || echo 0)
	i="$FWD_LINES"
	while [ "$i" -lt "$total" ]; do
		i=$((i + 1))
		line=$(sed -n "${i}p" "$f")
		printf '{"event":"progress","provider":"%s","line":%s}\n' \
			"$PROVIDER" "$(printf '%s' "$line" | jq -Rs .)" >&2
	done
	FWD_LINES="$total"
}

# --- classification helpers --------------------------------------------------
# An unavailable peer: missing binary, no/expired login, or exhausted usage.
# These are NON-transient — retrying wastes quota — so they short-circuit retry.
looks_unavailable() {
	grep -Eiq \
		'not (logged|signed) ?in|please (run )?[^ ]*login|log ?in (again|required)|re-?authenticate|unauthorized|(^|[^0-9])401([^0-9]|$)|(^|[^0-9])429([^0-9]|$)|usage limit|rate.?limit|too many requests|quota (exceeded|exhausted|reached)|(credits?|usage|balance) (exhausted|exceeded|depleted)|insufficient (quota|credit)' \
		"$@"
}

# A DETERMINISTIC (non-transient) execution failure: a bad flag, usage/config
# error, permission problem, or malformed command. These fail identically on a
# retry, so retrying only wastes time and quota — they are NOT retried. Detected
# both by well-known "your invocation is wrong" exit codes (2 bad usage, 64
# EX_USAGE, 126 not executable, 127 not found) and by canonical CLI error
# phrasing on stdout/stderr. Everything else that exits non-zero is treated as a
# transient execution failure and retried once.
looks_deterministic() {
	local rc="$1"
	shift
	case "$rc" in
	2 | 64 | 126 | 127) return 0 ;;
	esac
	grep -Eiq \
		'unknown (option|flag|argument|command|subcommand)|unrecognized (option|argument|subcommand)|invalid (option|flag|argument|value|choice)|unexpected argument|arguments? (are|is) required|missing (value|argument)|conflicting arguments|usage:|permission denied|no such file or directory|not a git repository|command not found|bad configuration|invalid config' \
		"$@"
}

# Extract the peer's final message text for the given provider from the captured
# output. Prints the text; returns 1 when a structured response is malformed.
extract_final_message() {
	local provider="$1" out="$2" dir="$3"
	case "$provider" in
	claude)
		# `--output-format json` emits ONE JSON object. Honor the result envelope:
		# only a `type == "result"`, non-error object carries a trustworthy final
		# message. A malformed (non-JSON) response, a non-result `type`, or an
		# `is_error == true` envelope is NOT a usable verdict — return 1 so a pass
		# token buried inside an error/malformed envelope can never become `passed`.
		jq -e . "$out" >/dev/null 2>&1 || return 1
		local etype is_err
		etype="$(jq -r '.type // ""' "$out" 2>/dev/null)"
		is_err="$(jq -r 'if (.is_error == true) then "1" else "0" end' "$out" 2>/dev/null)"
		if [ "$etype" != "result" ] || [ "$is_err" = "1" ]; then
			return 1
		fi
		jq -r '.result // ""' "$out"
		;;
	codex)
		# The final assistant message is captured verbatim in the -o file.
		cat "$dir/codex-last-message.txt" 2>/dev/null || true
		;;
	esac
}

# Normalize a peer's final message to pass | issues | none. The runner parses a
# documented VERDICT token the reviewer emits; it does NOT judge review content
# (that is the caller's/prompt's policy). A missing token is never a pass.
detect_verdict() {
	local text="$1"
	# Anchor to a VERDICT line: the token must begin the line (after only optional
	# markdown/quote decoration — spaces, `>`, `*`, `#`, `-`, backticks), NOT sit
	# mid-sentence, so an inline example like "reviewers end with 'VERDICT: PASS'"
	# is not mistaken for the real verdict. ISSUES is tested FIRST and takes
	# precedence over PASS: a body that both quotes an example pass token and
	# renders a real issues verdict must resolve to issues, never false-pass.
	local anchor='^[[:space:]>*#`-]*VERDICT[[:space:]]*[:=][[:space:]]*'
	if printf '%s\n' "$text" | grep -Eiq "${anchor}(issues?|changes?|blocking|block|reject|rejected|fail|failed|request[[:space:]_-]*changes?)"; then
		echo issues
		return
	fi
	if printf '%s\n' "$text" | grep -Eiq "${anchor}(pass|passed|approve|approved|lgtm|no[[:space:]_-]*issues?)"; then
		echo pass
		return
	fi
	echo none
}

# --- a single attempt --------------------------------------------------------
# Sets: ATTEMPT_DIR ATT_OUTCOME ATT_VERDICT ATT_EXIT ATT_ELAPSED ATT_REASON
#       ATT_TRANSIENT (1 when the failure is retryable)
run_attempt() {
	local attempt_no="$1"
	ATT_VERDICT=none
	ATT_EXIT=null
	ATT_TRANSIENT=0

	ATTEMPT_DIR="$(mktemp -d "${SESSION_DIR}/peer-review-${PROVIDER}-XXXXXX")" ||
		die_usage "cannot create an attempt directory under '$SESSION_DIR'"
	chmod 700 "$ATTEMPT_DIR"
	local dir="$ATTEMPT_DIR"
	local out="$dir/provider.stdout" err="$dir/provider.stderr"
	: >"$out"
	: >"$err"

	# Literal prompt: copied in, then fed on stdin. Never on argv, never eval'd.
	cp -- "$PROMPT_FILE" "$dir/prompt.txt"

	# Preflight: a missing peer binary is an unavailable outcome, not a crash.
	if ! command -v "$PEER_BIN" >/dev/null 2>&1; then
		ATT_OUTCOME=unavailable
		ATT_ELAPSED=0
		ATT_REASON="provider binary '$PEER_BIN' is not installed on PATH"
		write_meta "$dir" "$attempt_no" "unavailable-preflight"
		return 0
	fi

	case "$PROVIDER" in
	claude) build_cmd_claude ;;
	codex) build_cmd_codex "$dir" ;;
	esac
	write_meta "$dir" "$attempt_no" "launched"

	if [ "$LIVE" = 1 ]; then
		printf '{"event":"note","provider":"%s","liveProgress":true,"message":"streaming provider events"}\n' "$PROVIDER" >&2
	else
		printf '{"event":"note","provider":"%s","liveProgress":false,"message":"buffered final result; no live progress"}\n' "$PROVIDER" >&2
	fi

	# Launch the provider as its OWN process group (set -m gives each job its own
	# group) so the whole tree can be reaped by group id. The subshell exec's into
	# the provider and is the group leader.
	FWD_LINES=0
	local start end child pgid rc timed_out=0
	start=$(date +%s.%N)
	set -m
	(cd "$WORKTREE" && exec "${CMD[@]}" <"$dir/prompt.txt" >"$out" 2>"$err") &
	child=$!
	set +m
	# VALIDATE that the child leads its own process group before we ever send a
	# negative-PID (whole-group) signal: confirm its PGID equals its own PID.
	#   * probe == child            → validated group; signal it by PGID.
	#   * probe non-empty && != child → job control did NOT isolate the child (it
	#     shares another group, possibly the helper's own): leave pgid empty and
	#     fall back to single-PID signalling — NEVER TERM/KILL an unowned group.
	#   * probe empty (child already exited before we could read it) → under
	#     `set -m` the job had its own group whose PGID equalled its PID BY
	#     CONSTRUCTION, so trust that. Signalling that group only reaches the
	#     provider's own descendants (an already-empty group is a harmless ESRCH);
	#     this avoids losing group-reaping when a provider exits faster than the
	#     probe and leaves a stray grandchild behind.
	pgid="$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')"
	if [ -z "$pgid" ]; then
		pgid="$child"
	elif [ "$pgid" != "$child" ]; then
		pgid=""
	fi
	CURRENT_LEADER="$child"
	CURRENT_PGID="$pgid"

	# Poll: forward progress and enforce the deadline. On the deadline we only flag
	# the timeout and break; the single reap_tree below handles termination for
	# BOTH the timeout and the normal/failed-exit paths identically.
	while kill -0 "$child" 2>/dev/null; do
		forward_tick "$out"
		end=$(date +%s.%N)
		if awk -v a="$end" -v b="$start" -v t="$TIMEOUT" 'BEGIN{exit !((a-b)>t)}'; then
			timed_out=1
			break
		fi
		sleep 0.1
	done

	if [ "$timed_out" = 1 ]; then
		# Deadline hit while the tree was still running: TERM it, wait a bounded
		# grace, escalate to KILL for survivors, and confirm nothing remains.
		reap_tree "$child" "$pgid" ||
			printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL after timeout"}\n' "$PROVIDER" >&2
		wait "$child" 2>/dev/null || true
	else
		# The leader exited on its own (that is why the poll loop ended). Collect
		# its real status first, then sweep any stray descendant a completed OR
		# failed provider left behind in the group — TERM, grace, KILL, confirm —
		# so no grandchild outlives the run.
		if wait "$child"; then rc=0; else rc=$?; fi
		reap_tree "$child" "$pgid" ||
			printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL after exit"}\n' "$PROVIDER" >&2
	fi
	CURRENT_LEADER=""
	CURRENT_PGID=""
	forward_tick "$out" # flush any trailing lines
	end=$(date +%s.%N)
	ATT_ELAPSED=$(awk -v a="$end" -v b="$start" 'BEGIN{printf "%.3f", (a-b)}')

	if [ "$timed_out" = 1 ]; then
		ATT_OUTCOME=timeout
		ATT_EXIT=null
		ATT_REASON="provider exceeded the ${TIMEOUT}s timeout and its process group was reaped"
		write_meta "$dir" "$attempt_no" "timeout"
		return 0
	fi

	ATT_EXIT="$rc"

	if [ "$rc" -ne 0 ]; then
		# Classify the non-zero exit (scan only on failure so a successful review
		# that merely DISCUSSES rate limits or usage errors is never misread):
		#   * auth/login or usage/quota problem  → UNAVAILABLE (non-transient;
		#     retrying wastes quota).
		#   * deterministic invocation failure (bad flag/config/permission/usage) →
		#     FAILED, NOT retried (a retry fails identically).
		#   * anything else                       → transient FAILED, retried once
		#     with a fresh attempt dir.
		if looks_unavailable "$out" "$err"; then
			ATT_OUTCOME=unavailable
			ATT_REASON="provider reported an authentication or usage/quota problem (exit $rc)"
			write_meta "$dir" "$attempt_no" "unavailable"
			return 0
		fi
		if looks_deterministic "$rc" "$out" "$err"; then
			ATT_OUTCOME=failed
			ATT_TRANSIENT=0
			ATT_REASON="provider failed deterministically (exit $rc); not retried"
			write_meta "$dir" "$attempt_no" "failed-deterministic"
			return 0
		fi
		ATT_OUTCOME=failed
		ATT_TRANSIENT=1
		ATT_REASON="provider exited non-zero ($rc); transient, retrying"
		write_meta "$dir" "$attempt_no" "failed-exit"
		return 0
	fi

	# Exit 0: parse the final message.
	local text
	if ! text="$(extract_final_message "$PROVIDER" "$out" "$dir")"; then
		# Ran to a clean exit but its final message is malformed / an error
		# envelope / otherwise unintelligible: the peer FORFEITED a usable verdict.
		# This is a DISTINCT outcome from a deterministic retry-exhausted `failed`
		# (an execution failure) — the process succeeded, the verdict did not. Not
		# retried: a clean exit that produced garbage is deterministic. Never a pass.
		ATT_OUTCOME=forfeited
		ATT_VERDICT=none
		ATT_TRANSIENT=0
		ATT_REASON="provider exited 0 but produced a malformed/unparseable response"
		write_meta "$dir" "$attempt_no" "malformed"
		return 0
	fi

	if [ -z "${text//[[:space:]]/}" ]; then
		# Ran, exited 0, but delivered no usable message: the peer forfeited a
		# verdict. NEVER a pass on empty output.
		ATT_OUTCOME=forfeited
		ATT_REASON="provider exited 0 with an empty final message"
		write_meta "$dir" "$attempt_no" "forfeited-empty"
		return 0
	fi

	ATT_VERDICT="$(detect_verdict "$text")"
	case "$ATT_VERDICT" in
	pass)
		ATT_OUTCOME=passed
		ATT_REASON="provider exited 0 with an explicit pass verdict"
		;;
	issues)
		ATT_OUTCOME=issues
		ATT_REASON="provider exited 0 and reported an issues verdict"
		;;
	none)
		ATT_OUTCOME=forfeited
		ATT_REASON="provider exited 0 but emitted no recognizable VERDICT token"
		;;
	esac
	write_meta "$dir" "$attempt_no" "$ATT_OUTCOME"
	return 0
}

# Record per-attempt metadata for the retained artifact (the invocation record).
write_meta() {
	local dir="$1" attempt_no="$2" phase="$3"
	jq -n \
		--arg provider "$PROVIDER" \
		--arg worktree "$WORKTREE" \
		--arg base "$BASE" \
		--arg timeout "$TIMEOUT" \
		--arg attempt "$attempt_no" \
		--arg phase "$phase" \
		'{provider:$provider,worktree:$worktree,base:$base,timeoutSeconds:($timeout|tonumber),attempt:($attempt|tonumber),phase:$phase}' \
		>"$dir/meta.json" 2>/dev/null || true
}

# --- run with retry-once for transient failures ------------------------------
ATTEMPTS=0
RETRIED=false

run_attempt 1
ATTEMPTS=1

if [ "$ATT_TRANSIENT" = 1 ]; then
	# Retry ONCE, with a brand-new attempt directory (never reuse the first).
	printf '{"event":"note","provider":"%s","message":"transient failure; retrying once"}\n' "$PROVIDER" >&2
	run_attempt 2
	ATTEMPTS=2
	RETRIED=true
	if [ "$ATT_TRANSIENT" = 1 ]; then
		# Both attempts failed transiently → exhausted.
		ATT_OUTCOME=failed
		ATT_REASON="provider failed on two attempts (retry exhausted); last exit ${ATT_EXIT}"
	fi
fi

# --- emit the versioned result ----------------------------------------------
exit_json="$ATT_EXIT"
case "$exit_json" in
'' | null) exit_json=null ;;
*[!0-9]*) exit_json=null ;;
esac
live_json=false
[ "$LIVE" = 1 ] && live_json=true

jq -nc \
	--arg schema "$SCHEMA" \
	--arg provider "$PROVIDER" \
	--arg outcome "$ATT_OUTCOME" \
	--arg verdict "$ATT_VERDICT" \
	--argjson elapsed "$ATT_ELAPSED" \
	--argjson exitStatus "$exit_json" \
	--argjson attempts "$ATTEMPTS" \
	--argjson retried "$RETRIED" \
	--argjson liveProgress "$live_json" \
	--arg artifactDir "$ATTEMPT_DIR" \
	--arg reason "$ATT_REASON" \
	'{schema:$schema,provider:$provider,outcome:$outcome,verdict:$verdict,elapsedSeconds:$elapsed,exitStatus:$exitStatus,attempts:$attempts,retried:$retried,liveProgress:$liveProgress,artifactDir:$artifactDir,reason:$reason}'

exit 0
