#!/usr/bin/env bash
# peer-review-run — bidirectional, provider-neutral peer-review runner.
#
# A Claude-led workflow reviews with Codex, and a Codex-led workflow reviews
# with Claude, through ONE command interface and ONE machine-readable result
# contract. The helper owns the mechanics that peer reviews previously required
# by hand: a private owner-only artifact directory, literal (never shell-eval'd)
# prompt handling, read-only provider execution, process-group supervision with
# a timeout, a retry-once policy for transient failures, result parsing, and
# process reaping on every exit path.
#
# Usage:
#   peer-review-run --provider <claude|codex> \
#                   --worktree <ABS_DIR> \
#                   --prompt-file <FILE> \
#                   --artifact-root <ABS_DIR> \
#                   [--base <REF>] [--timeout <SECONDS>] \
#                   [--model <ID>] [--effort <LEVEL>]
#
#   --provider       claude | codex — the PEER that reviews (the opposite agent).
#   --worktree       absolute path to the checkout the peer reviews (read-only).
#   --prompt-file    file whose CONTENTS are the literal review prompt; fed to
#                    the provider on stdin, never interpolated through a shell.
#   --artifact-root  absolute directory OUTSIDE the worktree under which a
#                    per-invocation owner-only (0700) session dir is created, with
#                    a fresh owner-only attempt dir per attempt nested inside it, so
#                    the provider is only ever POINTED AT this invocation's own
#                    attempts, never a sibling's (see the sibling-isolation note by
#                    SESSION_DIR for the honest same-UID traversal residual).
#   --base           optional base/reference metadata (recorded, not injected).
#   --timeout        wall-clock seconds before the provider tree is reaped
#                    (default 900).
#   --model          model the PEER reviews with. Default: `opus` for claude.
#                    For codex with no --model, the ROOT top-level `model` in
#                    ${CODEX_HOME:-~/.codex}/config.toml is recovered and passed
#                    as `-m`, so the container's rolling /model selection
#                    survives this adapter's own --ignore-user-config — but ONLY
#                    when no root `profile` and no root `model_provider` is set,
#                    since either makes that bare name meaningless without the
#                    configuration this helper deliberately does not forward
#                    ([profiles.*] and [model_providers.*] are never consulted).
#                    A missing config, or one carrying no root `model`, is the
#                    unconfigured case and stays SILENT: no `-m`, `model:null`,
#                    no warning, exactly as before this passthrough existed.
#                    A profile/provider-dependent selection, or an
#                    unreadable/unparseable/unusable value, degrades to the bare
#                    CLI default with a stderr warning and `model:null` — never
#                    a failed review. An explicit --model wins and skips the
#                    lookup entirely. Passed as `--model` (claude) or `-m`
#                    (codex).
#   --effort         reasoning effort: low | medium | high | xhigh | max
#                    (`max` is claude-only). Default: high, for BOTH providers.
#
# Why the strength knobs default rather than inherit: without them the peer runs
# at whatever model and effort a container most recently selected, because
# `~/.claude/settings.json` and `~/.codex/config.toml` are shared mutable state
# that every container writes through `/model`. A review is not the place to
# discover that someone picked an economy tier an hour ago in another container.
# Worse for codex specifically — the adapter's own `--ignore-user-config`
# (config/hook isolation, see build_cmd_codex) DISCARDS that config, so before
# these defaults a codex peer ran at `reasoning effort: none`. Both knobs are
# per-invocation and never write back to the shared configuration.
#
# Result contract (schema powbox.peer-review-run/v1): the FINAL line of stdout
# is a single JSON object:
#   { schema, provider, outcome, verdict, elapsedSeconds, exitStatus, attempts,
#     retried, liveProgress, model, effort, artifactDir, reviewFile, reason }
#   outcome  ∈ passed | issues | unavailable | timeout | forfeited | failed
#   verdict  ∈ pass | issues | none   (normalized from the peer's final message)
#   elapsedSeconds  total wall time across ALL attempts — a retried run reports
#               the sum, never the final attempt alone.
#   exitStatus  the provider exit code, or null when unknown (missing binary /
#               killed on timeout).
#   model / effort  the strength the peer ACTUALLY ran at, or null where the
#               knob was not applied — an unset --model for codex, or an
#               installed CLI whose probe shows no `--effort` support. These
#               report the effective value rather than the requested one
#               precisely so a caller can VERIFY review strength instead of
#               trusting that its flags landed; a null `effort` is the honest
#               signal that the pin degraded, which no exit status would show.
#               Additive within schema v1: consumers read keys by name, and
#               every field the contract already promised is unchanged.
#   reviewFile  for `passed`/`issues`, the absolute path of
#               <artifactDir>/review.txt: the peer's FULL final review message as
#               PLAIN TEXT, provider JSON envelopes already decoded, identical
#               for both providers. A caller relays the prose from this one path
#               instead of knowing codex's final-message filename or claude's
#               JSON shape. null for every other outcome. The guarantee is
#               "plain text, byte-identical to the parsed message" and no more:
#               that message reaches the writer through a command substitution,
#               which drops NUL bytes AND strips trailing newlines, and nothing
#               here validates UTF-8. The file is created O_CREAT|O_EXCL at 0600
#               and its bytes are read back and compared before the result is
#               emitted, so a refused creation or unprovable content EXITS 70
#               with no result — a completed review CAN be discarded by a
#               post-review write failure. The mode is defence in depth on top of
#               the 0700 attempt dir, so a mode problem only WARNS. And the
#               fail-closed promise is against a STANDING obstacle at that path:
#               O_EXCL protects the final path component only, and a same-UID
#               descendant can still swap the path after the helper exits.
#               <artifactDir> keeps its provider-native artifacts unchanged for
#               debugging; review.txt is an additional consumption surface, not a
#               replacement for them.
# The helper NEVER reports success because an output file is absent or empty.
# It exits 0 for any produced outcome (the outcome is a non-blocking signal for
# the caller to weigh) EXCEPT one whose reviewFile could not be created or
# verified — that exits 70 and emits NO result, discarding an otherwise complete
# review rather than reporting one whose prose cannot be trusted — and non-zero
# otherwise ONLY for its own usage/operational errors.
#
# Requires: `jq`, and `python3` — which creates, writes, verifies and modes the
# reviewFile, making the interpreter a HARD precondition: it is preflighted
# before any provider is launched and its absence exits 70, because discovering
# it after a completed review would throw away work nobody can get back. Python 3
# is baked into the agent image this helper ships in, so this is a documented
# precondition rather than a live degradation path. Its `tomllib` module is
# OPTIONAL: an interpreter without it (it arrived in 3.11) degrades codex
# configured-model passthrough with a warning, exactly like an unparseable config.
#
# Progress: while running, `liveProgress:true` providers (Codex, when the
# installed CLI supports `--json`) stream normalized progress events to STDERR;
# a buffered provider (Claude) is represented honestly with liveProgress:false
# and a single up-front note rather than a simulated heartbeat. stdout stays a
# single parseable JSON object regardless.
#
# This helper SUPPLEMENTS but does not replace a fresh reviewer subagent gate,
# and no peer outcome is required for publication.
set -uo pipefail

readonly SCHEMA="powbox.peer-review-run/v1"
readonly DEFAULT_TIMEOUT=900

# EX_USAGE-style exit for the helper's OWN errors (never a peer outcome).
EX_USAGE=64

usage() {
	# Range end tracks the LAST line of the header comment block (the line above
	# `set -uo pipefail`); extend it whenever that block grows, or --help starts
	# truncating mid-sentence.
	sed -n '2,127p' "$0" | sed 's/^# \{0,1\}//'
}

die_usage() {
	echo "peer-review-run: $*" >&2
	echo "Try: peer-review-run --provider <claude|codex> --worktree <dir> --prompt-file <file> --artifact-root <dir>" >&2
	exit "$EX_USAGE"
}

# ensure_private_dir <dir> — enforce mode 0700 and FAIL CLOSED if the filesystem
# does not honor it. mktemp -d already creates 0700 and this re-asserts it, but a
# mount that rejects or IGNORES Unix mode changes (some FUSE/network/host shares)
# lets the chmod silently no-op — leaving prompt and provider artifacts readable
# to other users/processes while the helper still claims a private 0700 layout.
# Because the script runs without `set -e`, a bare `chmod` failure would be
# swallowed; so we require the chmod to succeed AND verify the mode actually took
# (GNU `stat -c`, BSD `stat -f` fallback). Anything but 0700 REJECTS the run
# rather than handing the peer a directory whose privacy cannot be guaranteed.
ensure_private_dir() {
	local d="$1" mode
	chmod 700 "$d" 2>/dev/null ||
		die_usage "cannot chmod 0700 '$d' (does the --artifact-root filesystem honor Unix modes?)"
	mode="$(stat -c '%a' "$d" 2>/dev/null || stat -f '%Lp' "$d" 2>/dev/null)" ||
		die_usage "cannot read the mode of '$d' to confirm it is private"
	[ "$mode" = 700 ] ||
		die_usage "'$d' is not private after chmod (mode ${mode:-unknown}, want 700); the --artifact-root filesystem does not enforce Unix modes"
}

# --- process-group supervision ----------------------------------------------
# The currently supervised job's leader pid and validated process-group id. The
# EXIT/INT/TERM trap reaps the tree so a helper interrupted mid-review never
# leaves a live peer process. CURRENT_LEADER is assigned IMMEDIATELY after each
# spawn ($!) — before the start-time read, the captured-set seed, and the PGID
# probe — and the reap primitives treat that bare leader PID as an IMPLICIT
# MEMBER of the supervised tree while it has no captured entry (see the
# implicit-member rule above group_alive), so trap coverage of the leader
# begins at that first assignment, not at the captured-set seed.
# CURRENT_PGID is set ONLY after we confirm the child is the leader of its own
# group (pgid == leader pid); it stays empty otherwise so we never send a
# negative-PID (whole-group) signal against an unvalidated — possibly the
# helper's own — process group.
CURRENT_LEADER=""
CURRENT_PGID=""
# Set to 1 if reap_tree ever reports a survivor after SIGKILL, so the returned
# outcome's `reason` HONESTLY reflects that a descendant may still be running
# rather than reporting a clean result as if the tree were fully reaped.
REAP_WARN=0

# Captured descendant set. Each entry is "PID:STARTTIME" (STARTTIME = field 22
# of /proc/PID/stat, the process's boot-relative start jiffies), space-padded
# for whole-word membership tests. Populated on EVERY supervised run — seeded
# with the leader (and its launch-time start time) at spawn, then merged from a
# live walk each poll tick:
#   * validated-PGID path: the group signal reaps the group itself, and the
#     captured set ADDITIONALLY reaches a descendant that has LEFT the group —
#     e.g. a provider tool starting a new session/process group via setsid —
#     which a group signal alone would miss entirely;
#   * unvalidated fallback: the captured set is the only reach we have.
# Recording the start time next to the PID lets the later liveness/signal steps
# DETECT PID reuse: if the kernel recycled a captured PID for an unrelated
# process, that process's start time differs, so we SKIP it rather than
# TERM/KILL a stranger. A PID whose start time was UNREADABLE at capture (empty
# baseline) is likewise skipped — see pid_matches' fail-safe: we never signal a
# PID we cannot positively re-identify. The set is accumulated WHILE THE LEADER
# IS STILL ALIVE — a live tree-walk rooted at a leader that has ALREADY exited
# finds nothing, because its children have by then reparented to init. Capturing
# eagerly (during the poll loop and before we wait on / reap the leader) means
# we still hold a stray grandchild's PID after the leader dies and can terminate
# it.
CAPTURED_DESC=" "

# proc_ppid_start <pid> — print "<ppid> <starttime>" (fields 4 and 22 of
# /proc/<pid>/stat) from ONE read, so the parent link and the identity token come
# from the SAME snapshot — capture_walk depends on that atomicity: a child is
# recorded only when a single snapshot shows both WHO its parent is and WHICH
# process incarnation it is. Prints nothing and returns non-zero when the process
# is gone or /proc is unreadable. Robust to a comm field containing spaces or
# ')': everything up to the LAST ')' is the "pid (comm)" prefix, so the fields
# after it begin at `state`, which makes ppid the 2nd and start time the 20th of
# those.
proc_ppid_start() {
	local stat
	stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
	stat="${stat##*) }"
	# shellcheck disable=SC2086  # deliberate word-split of the stat fields
	set -- $stat
	[ "$#" -ge 20 ] || return 1
	printf '%s %s' "${2}" "${20}"
}

# proc_starttime <pid> — the start-time half of proc_ppid_start: a stable
# per-process token that changes when the kernel reuses the PID (a later holder
# of the same PID always has a LATER start time, so the original baseline can
# never match again).
proc_starttime() {
	local ps
	ps="$(proc_ppid_start "$1")" || return 1
	printf '%s' "${ps#* }"
}

# proc_state <pid> — the single-letter process state (field 3 of
# /proc/<pid>/stat, the first field after the "pid (comm)" prefix; same
# comm-safe parse as proc_ppid_start). Prints nothing and returns non-zero when
# the process is gone or /proc is unreadable. Used to tell a RUNNABLE process
# from a dead-but-uncollected one: a zombie ("Z", or the transient "X"/"x"
# dying states) still answers `kill -0` and still shows its original start
# time, but it cannot execute code or spawn — for supervision purposes it is
# already dead.
proc_state() {
	local stat
	stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
	stat="${stat##*) }"
	printf '%s' "${stat%% *}"
}

# pid_matches <pid> <starttime> — does <pid> STILL name the same process we
# captured? True ONLY when a NON-EMPTY baseline start time was recorded at capture
# AND the process's current start time equals it. FAIL SAFE: if the baseline is
# empty (its /proc start time was unreadable at capture) OR the current
# /proc/<pid>/stat cannot be read now, treat the PID as NON-matching — do NOT count
# it alive and do NOT signal it. Rationale: this is the near-unreachable,
# unvalidated-PGID fallback, where the harm to avoid is SIGTERM/SIGKILL hitting an
# unrelated same-UID process after PID reuse; leaving a possibly-orphaned descendant
# we cannot even identify is the lesser, bounded risk (and set -m's validated
# whole-group signal path — which never consults per-PID start times — is the norm).
pid_matches() {
	local pid="$1" want="$2" cur
	[ -n "$want" ] || return 1
	cur="$(proc_starttime "$pid")" || return 1
	[ "$cur" = "$want" ]
}

# captured_start <pid> — print the baseline start time recorded for <pid> in
# CAPTURED_DESC (possibly empty); returns 1 when the pid was never captured.
captured_start() {
	local pid="$1" entry
	for entry in $CAPTURED_DESC; do
		if [ "${entry%%:*}" = "$pid" ]; then
			printf '%s' "${entry#*:}"
			return 0
		fi
	done
	return 1
}

# capture_walk <parent_pid> <parent_baseline> — record every CURRENT child of a
# VERIFIED <parent> into CAPTURED_DESC, then recurse. This is a VERIFIED-LINEAGE
# walk, not a bare PID enumeration: for each candidate child it takes ONE /proc
# snapshot yielding the child's parent link AND start time together
# (proc_ppid_start), requires that snapshot to name <parent> as the parent, and
# only THEN re-verifies that <parent> still matches its own baseline. The order
# matters — the parent check runs AFTER the child snapshot — so if <parent>'s
# PID was recycled for an unrelated process at ANY point before the snapshot
# (making the pgrep-enumerated "children" a stranger's), the post-snapshot
# re-verification cannot match the original baseline (a later holder of a PID
# always has a later start time) and the whole level is discarded unrecorded.
# Recursion hands each child its own just-snapshotted start time as baseline, so
# verification CHAINS from every recorded PID back to the root's launch-time
# seed: a PID enters the set only when a snapshot proved it a child of a
# verified tree member. That closes the recycled-INTERMEDIATE-node hazard — one
# level deeper than the root recapture guard below: without the per-level check,
# `pgrep -P` on an intermediate PID recycled mid-walk would enumerate an
# unrelated process's children with fresh, valid start times, and the later
# start-time-verified sweep would TERM/KILL them as captured descendants.
# A child whose snapshot fails or whose parent link has already moved (its
# parent died and it reparented) is skipped — fail-safe over-skip, the same
# bounded direction as pid_matches. Best-effort as any PID walk: a process
# re-parented away entirely (double-fork daemonization) is out of scope, exactly
# as it is for a group signal.
capture_walk() {
	local parent="$1" parent_base="$2" kid snap pp st cur
	for kid in $(pgrep -P "$parent" 2>/dev/null || true); do
		snap="$(proc_ppid_start "$kid")" || continue
		pp="${snap%% *}"
		st="${snap#* }"
		[ "$pp" = "$parent" ] || continue
		pid_matches "$parent" "$parent_base" || return 0
		if cur="$(captured_start "$kid")"; then
			# Already captured. A differing baseline means the PID died and was
			# recycled INTO the tree (a NEW child of a verified member): update
			# to the current incarnation so the sweep reaches the genuine
			# descendant instead of skipping a stale entry.
			if [ "$cur" != "$st" ]; then
				CAPTURED_DESC="${CAPTURED_DESC// ${kid}:${cur} / ${kid}:${st} }"
			fi
		else
			CAPTURED_DESC="${CAPTURED_DESC}${kid}:${st} "
		fi
		capture_walk "$kid" "$st"
	done
}

# capture_descendants <leader_pid> — merge the leader's CURRENT descendant subtree
# into CAPTURED_DESC via the verified-lineage walk above. Call repeatedly while
# the leader is alive so a grandchild is recorded BEFORE it can reparent away on
# the leader's exit; once captured a PID stays in the set even after the leader
# dies.
#
# RECAPTURE GUARD: a live walk runs ONLY while the walk root still matches the
# baseline start time recorded for it at capture (the leader is seeded with its
# launch-time start time). Once the original leader is gone — or its bare PID
# has been RECYCLED for an unrelated process — a fresh walk rooted at that PID
# would enumerate a STRANGER's children, and the later start-time-verified sweep
# would then TERM/KILL unrelated same-UID processes as if they were captured
# descendants. Refusing to re-walk a root we cannot positively re-identify
# (unmatched or empty baseline) closes that hazard at the root, and
# capture_walk's per-level parent re-verification closes it for every
# intermediate node too; the already-captured set remains fully usable for
# liveness/signals.
capture_descendants() {
	local root="$1" base
	base="$(captured_start "$root")" || base=""
	pid_matches "$root" "$base" || return 0
	capture_walk "$root" "$base"
}

# IMPLICIT LEADER MEMBERSHIP (shared by group_alive and signal_tree): the
# <leader_pid> argument is itself part of the supervised tree even BEFORE it has
# a captured entry. During the spawn-setup gap — CURRENT_LEADER already assigned
# from $!, captured set not yet seeded — the set-based sweep alone finds nothing
# (and an empty pgid skips the group probe), so a trap-time reap_tree would
# return "all gone" without ever signalling the fresh child, leaking it. So
# while captured_start has NO entry for the leader, group_alive probes the bare
# PID directly — counting it alive only in a RUNNABLE (non-zombie) /proc state,
# so a dead-but-uncollected leader can never spin the grace loops "alive" until
# they exhaust — and signal_tree kills the bare PID directly (always a positive
# PID, NEVER a group). Once the seed lands, the leader HAS an entry and the
# direct path goes inert: the start-time-verified sweep alone governs, so a
# leader PID the kernel recycles after the helper has collected the child (the
# normal-exit path waits BEFORE its reap, and on_exit can fire between that
# wait and the CURRENT_LEADER clear) fails pid_matches and is never signalled.
# The direct path is thus live exactly in the setup gap, where the child was
# forked moments ago; a stranger on that bare PID would require the child to
# die, the parent shell to collect it (bash reaps background children
# asynchronously, well before the `wait` builtin), AND the kernel's PID space
# to wrap onto that exact PID, all within that sub-millisecond window — the
# same class of irreducible residual as the $!-to-CURRENT_LEADER assignment
# window, and strictly narrower than the guaranteed leak it closes. A seeded
# entry with an EMPTY baseline (the leader's /proc was unreadable at seed time,
# i.e. it was already gone) also suppresses the direct path — matching
# pid_matches' fail-safe: never signal a PID we cannot positively re-identify.

# group_has_runnable <pgid> — is any process in process group <pgid> in a
# RUNNABLE state? A bare `kill -0 -<pgid>` answers only "is any member PRESENT",
# and a ZOMBIE/dying member counts as present — a dead-but-uncollected leader the
# inner `timeout` killed before the helper's wait, or a child collected only
# later — so the group probe alone would make reap_tree spin its whole TERM/KILL
# grace on a group holding nothing but a corpse no signal can remove. This
# narrows the group probe to "is any member ALIVE": scan /proc for a process
# whose process-group id (field 5 of /proc/PID/stat) equals <pgid> and whose
# state is not Z/X/x. Same comm-safe parse as proc_ppid_start — after stripping
# the "pid (comm) " prefix, state is field 1 and pgrp is field 3 of the
# remainder. It runs only after the cheap `kill -0 -<pgid>` pre-check already
# found the group non-empty, and short-circuits on the first runnable member, so
# a live group still answers fast; a zombie-only group returns 1 so group_alive
# falls through to the start-time-verified (and now zombie-filtered) sweep and
# reap_tree returns at once instead of burning the grace.
group_has_runnable() {
	local want="$1" pidpath pid stat
	for pidpath in /proc/[0-9]*; do
		[ -e "$pidpath" ] || continue
		pid="${pidpath#/proc/}"
		stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || continue
		stat="${stat##*) }"
		# shellcheck disable=SC2086  # deliberate word-split of the stat fields
		set -- $stat
		[ "$#" -ge 3 ] || continue
		[ "$3" = "$want" ] || continue
		case "$1" in
		Z | X | x) ;;
		*) return 0 ;;
		esac
	done
	return 1
}

# group_alive <leader_pid> <pgid|""> — is any member of the supervised tree still
# alive? A validated group with a RUNNABLE member answers immediately (the group
# probe is `kill -0 -<pgid>` for cheap presence, then group_has_runnable so a
# group holding only a zombie/dying member does NOT count as alive — otherwise
# reap_tree would spin its full grace on an unreapable corpse); in EVERY case the
# CAPTURED descendant set (accumulated while the leader lived, refreshed with a
# live walk only while the leader still matches its baseline — see
# capture_descendants) is also swept: on the validated-PGID path that catches a
# descendant that has LEFT the group (setsid), which the group probe alone would
# report as gone; on the fallback it is the only check there is. A captured PID
# counts as alive ONLY when it still names the same process (start-time match)
# AND is in a runnable state, so neither a recycled PID standing in for an
# unrelated process nor a zombie is mistaken for a live provider descendant. The
# bare leader is covered from before the seed by the implicit-member rule above.
group_alive() {
	local pid="$1" pgid="$2" entry p st
	if [ -n "$pgid" ] && kill -0 "-${pgid}" 2>/dev/null && group_has_runnable "$pgid"; then
		return 0
	fi
	if ! captured_start "$pid" >/dev/null && st="$(proc_state "$pid")"; then
		# Implicit-member rule: an unseeded leader in a runnable state is alive;
		# a zombie ("Z") or dying ("X"/"x") one is dead for supervision purposes
		# (it cannot run or spawn — only its collector can clear the entry).
		case "$st" in
		Z | X | x) ;;
		*) return 0 ;;
		esac
	fi
	capture_descendants "$pid"
	for entry in $CAPTURED_DESC; do
		p="${entry%%:*}"
		st="${entry#*:}"
		# A captured PID counts as alive ONLY when it still names the same process
		# AND is in a runnable state. A zombie ("Z") or dying ("X"/"x") descendant
		# still answers kill -0 and keeps its start time, but it is already dead for
		# supervision — no signal can remove it, only its reaping ancestor's wait()
		# — so treating it alive would make reap_tree spin its whole TERM/KILL grace
		# on an unreapable process. This closes the SEEDED-leader gap the implicit-
		# member filter above cannot reach: a seeded leader the inner `timeout`
		# killed before the helper waited on it (the hung-probe path) is a zombie
		# with a captured entry, so the direct probe is inert and only this sweep
		# governs. An empty state (the PID vanished between checks) is not alive.
		pid_matches "$p" "$st" || continue
		kill -0 "$p" 2>/dev/null || continue
		case "$(proc_state "$p")" in
		'' | Z | X | x) ;;
		*) return 0 ;;
		esac
	done
	return 1
}

# signal_tree <SIG> <leader_pid> <pgid|""> — deliver a signal to the whole
# validated group (when we have one) AND to every CAPTURED descendant PID
# (leader included) that STILL names the same process. NEVER a negative,
# unvalidated PID (which could hit the helper's own group); never pkill -f. The
# per-PID sweep runs on BOTH paths: with a validated group it reaches a
# descendant that moved itself into a NEW session/process group (setsid) and so
# escaped the group signal (a still-grouped member is merely signalled twice —
# harmless); on the fallback it is the only delivery. The start-time check
# before each kill means a captured PID the kernel has since recycled for an
# unrelated process is skipped, not signalled. Signalling the captured set — not
# a fresh walk rooted at the possibly-dead leader — keeps this a real tree reap:
# a grandchild recorded while the leader was alive is still terminated after the
# leader exits and the grandchild reparents to init. The bare leader is covered
# from before the seed by the implicit-member rule above group_alive.
signal_tree() {
	local sig="$1" pid="$2" pgid="$3" entry p st
	if [ -n "$pgid" ]; then
		kill "-${sig}" "-${pgid}" 2>/dev/null || true
	fi
	if ! captured_start "$pid" >/dev/null; then
		# Implicit-member rule: an unseeded leader is signalled directly by its
		# positive PID (never a group). Signalling a zombie is a harmless no-op,
		# so no state check is needed here — only the liveness probe needs one.
		kill "-${sig}" "$pid" 2>/dev/null || true
	fi
	capture_descendants "$pid"
	for entry in $CAPTURED_DESC; do
		p="${entry%%:*}"
		st="${entry#*:}"
		pid_matches "$p" "$st" || continue
		kill "-${sig}" "$p" 2>/dev/null || true
	done
}

# reap_tree <leader_pid> <pgid|""> — TERM the tree, WAIT a bounded grace, then
# escalate to KILL for survivors, and confirm nothing remains. Used on EVERY
# terminating path (timeout AND normal/failed exit) so no descendant outlives the
# run. Returns 0 when the tree is gone, 1 if something survived even after KILL.
#
# Zombie collection: a descendant killed AFTER the leader has already exited has
# by then reparented to the nearest reaping ancestor, and only THAT process can
# collect its exit status — the helper can kill it but cannot wait() on it. The
# powbox runtime provides the collector: every agent container launches with
# `init: true` (compose.shared.yml), so PID 1 is docker-init, a real init that
# promptly reaps reparented children — which is why the hermetic test's reap
# assertions (kill -0 must FAIL after the reap; a lingering zombie would still
# answer kill -0) hold in-container. Under a NON-reaping PID 1 outside such a
# container, KILLed orphans still die — no live peer process remains, the
# guarantee this helper makes — but their process-table entries would linger
# until an init/subreaper collects them; providing one is the runtime's job,
# not this helper's.
reap_tree() {
	local pid="$1" pgid="$2" i
	group_alive "$pid" "$pgid" || return 0
	signal_tree TERM "$pid" "$pgid"
	# Bounded grace (~3s) for a well-behaved tree to exit on TERM.
	for ((i = 0; i < 30; i++)); do
		group_alive "$pid" "$pgid" || return 0
		sleep 0.1
	done
	# Survivors ignored TERM: escalate to KILL and confirm they actually die.
	signal_tree KILL "$pid" "$pgid"
	for ((i = 0; i < 20; i++)); do
		group_alive "$pid" "$pgid" || return 0
		sleep 0.1
	done
	return 1
}

on_exit() {
	# shellcheck disable=SC2317  # invoked indirectly by the EXIT trap
	if [ -n "$CURRENT_LEADER" ] && ! reap_tree "$CURRENT_LEADER" "$CURRENT_PGID"; then
		# This trap-path reap runs only when the helper is torn down MID-ATTEMPT
		# (INT/TERM or an unexpected exit) — the paths that emit the result JSON
		# all clear CURRENT_LEADER after their own reap first. A KILL-surviving
		# descendant therefore cannot be reflected in the result's `reason` the
		# way the timeout/normal-exit reaps do it (no result is emitted here);
		# the stderr warn event is the one honest channel left, so a reap_tree
		# failure must not be silently discarded.
		printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL during exit cleanup"}\n' "$PROVIDER" >&2
	fi
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# --- embedded python programs -------------------------------------------------
# Two `python3 -I -c` programs, distinguishable by their FIRST argv element
# (--prr-config-model / --prr-write-review) so a test shim can replace one
# without disturbing the other.
#
# Both are embedded in SINGLE-QUOTED shell strings and therefore must contain no
# ASCII single quote anywhere in their source.
#
# `-I` is load-bearing, not hygiene. A plain `python3 -c` puts the invocation's
# working directory at sys.path[0], and this helper is routinely run FROM the
# checkout under review — so a reviewed branch that adds a `tomllib.py` would
# execute arbitrary code inside the unsandboxed helper before the peer is ever
# launched. Isolated mode also ignores PYTHONPATH, PYTHONSTARTUP and the user
# site directory, closing the same vector through a poisoned `sitecustomize.py`.
# Dropping `-I` is a silent reintroduction of code execution from the reviewed
# tree, not a style regression.

# Root configured-model reader for the codex adapter. Exit status is the
# interface: 0 = the usable model on stdout; 3 = nothing configured, which is the
# backward-compatible silent case; anything else = degraded, with the reason
# already written to stderr.
#
# The config file is ordinary user state read before any artifact root, session
# dir or supervised deadline exists, so nothing downstream could interrupt a bad
# read: a FIFO, or a symlink to an unbounded character device, would turn the
# documented warn-and-degrade path into a hang or an unbounded allocation. Hence
# the non-blocking open, the fstat classification on THAT SAME descriptor (a
# stat-then-open sequence is check-then-act on a path a same-UID process may
# control), and the read cap. Symlinks are followed as normal — a config.toml
# symlinked to a regular file is ordinary user state, and the final target's type
# is what decides.
#
# CAP is the largest payload ACCEPTED; the read asks for one sentinel byte past
# it, so reaching that byte is how over-cap is detected rather than a larger cap.
# A few hundred KiB is generous for a file whose whole job is a handful of keys.
#
# A value this program cannot hand back verbatim is rejected rather than
# silently altered: the caller reads stdout through a Bash command substitution,
# which strips trailing newlines, so a model ending in one would ride as a
# DIFFERENT string than the file names. Non-printable is where that line is
# drawn — no real model ID carries a control character, and it keeps "the
# configured value is passed exactly" true for everything that is passed at all.
#
# PRR_TEST_CONFIG_SHORT_READ is a TEST-ONLY injection: unset in every non-test
# path, it exists because a single os.read behaves identically to a looped one on
# an ordinary regular file, so nothing else would ever exercise the loop.
PRR_CONFIG_MODEL_PY='
import os, stat, sys

CAP = 262144
path = sys.argv[2]

def degrade(msg):
    sys.stderr.write("peer-review-run: configured-model passthrough degraded: " + msg + "; running codex at its CLI default (model:null)\n")
    sys.exit(2)

try:
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
except FileNotFoundError:
    sys.exit(3)
except OSError as exc:
    degrade("cannot open " + path + " (" + str(exc.strerror) + ")")

short = os.environ.get("PRR_TEST_CONFIG_SHORT_READ") == "1"
try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        degrade(path + " is not a regular file (rejected by type)")
    buf = b""
    while len(buf) < CAP + 1:
        want = CAP + 1 - len(buf)
        if short:
            short = False
            want = 1
        try:
            chunk = os.read(fd, want)
        except OSError as exc:
            degrade("cannot read " + path + " (" + str(exc.strerror) + ")")
        if not chunk:
            break
        buf += chunk
finally:
    os.close(fd)

if len(buf) > CAP:
    degrade(path + " is larger than the " + str(CAP) + " byte read cap (rejected by size)")

try:
    import tomllib
except ImportError:
    degrade("this python3 has no tomllib (it arrived in 3.11)")

try:
    cfg = tomllib.loads(buf.decode("utf-8"))
except Exception as exc:
    degrade("cannot parse " + path + " as TOML (" + str(exc) + ")")

if not isinstance(cfg, dict):
    degrade(path + " is not a TOML table")
if "profile" in cfg or "model_provider" in cfg:
    degrade("a root profile or model_provider is selected in " + path + ", and a profile- or provider-dependent model cannot be preserved through isolated execution")
if "model" not in cfg:
    sys.exit(3)
chosen = cfg["model"]
if not isinstance(chosen, str):
    degrade("the root model in " + path + " is not a string")
if chosen.strip() == "":
    degrade("the root model in " + path + " is empty")
if chosen.startswith("-"):
    degrade("the root model in " + path + " is flag-shaped (" + chosen + ")")
if not chosen.isprintable():
    degrade("the root model in " + path + " contains a newline or other non-printable character")
sys.stdout.write(chosen)
sys.exit(0)
'

# Review-file writer: create, write, mode, verify — all on ONE descriptor, in one
# invocation. The path arrives in argv, the prose on stdin.
#
# One descriptor is what makes the guarantee whole: after the exclusive create
# nothing is re-resolved by path, so neither the read-back nor the mode set can
# be steered onto a replica, a FIFO or /dev/null by a live descendant.
#
# O_CREAT|O_EXCL, and the two mechanisms that look equivalent are not. `test ! -e`
# follows symlinks, so a dangling one reads as absent and the write lands on the
# attacker's target out of tree; shell `noclobber` stats first and adds O_EXCL
# only when that stat FAILS, so it writes THROUGH an existing non-regular target
# — silently through a /dev/null symlink, by blocking on a FIFO. Only the atomic
# pair refuses every shape, symlinks included whatever they point at.
#
# The umask is cleared around the create so the mode really is 0600: under a
# restrictive umask the create could land at 0400/0200/0000, and the
# warn-and-continue mode rule below would then report `passed` pointing at a file
# the caller can neither read nor write.
#
# Exit convention: NON-ZERO for any failure — refused creation (3), failed write,
# seek, read, or a content mismatch (4) — EXCEPT the mode set, which warns on
# stderr and exits 0. The mode is defence in depth over a 0700 directory
# ensure_private_dir already proved enforces modes; failing over it would discard
# a completed, already-paid-for review. Content is the opposite case and stays
# fail-closed, because the full-prose contract is what callers actually consume.
# The refused-creation diagnostic is deliberately distinguishable from the
# content one: an exit 70 that arrived by the wrong route must not read as the
# right one.
#
# The read-back is bounded to len(expected)+1 and looped: a regular-file read may
# legally return short, so a single call would fail closed on a complete file and
# discard a paid-for review, while an unbounded read-to-EOF would consume every
# byte an appending survivor writes before noticing. The bound doubles as the
# assertion — exactly the expected bytes passes, anything shorter or a byte more
# fails, so truncation and overrun are caught by one read.
#
# Every PRR_TEST_* name below is a TEST-ONLY injection point, inert in normal
# operation because each is unset in every non-test path. They exist because the
# behaviors they drive — a short syscall, a failing or wrong-applying mode set, a
# silently truncated write, an ambient umask — live INSIDE this invocation, so a
# PATH shim replacing it would prove nothing about the shipped code.
PRR_WRITE_REVIEW_PY='
import os, stat, sys

path = sys.argv[2]
data = sys.stdin.buffer.read()
env = os.environ.get

def fail_create(msg):
    sys.stderr.write("peer-review-run: refused to create the review file " + path + ": " + msg + "\n")
    sys.exit(3)

def fail_content(msg):
    sys.stderr.write("peer-review-run: could not verify the review file contents at " + path + ": " + msg + "\n")
    sys.exit(4)

def warn(msg):
    sys.stderr.write("peer-review-run: " + msg + "\n")

injected_umask = env("PRR_TEST_WRITER_UMASK")
if injected_umask:
    os.umask(int(injected_umask, 8))

previous_umask = os.umask(0)
try:
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
except OSError as exc:
    fail_create(str(exc.strerror) + " (the path was already taken)")
finally:
    os.umask(previous_umask)

short_write = env("PRR_TEST_WRITER_SHORT_WRITE") == "1"
short_read = env("PRR_TEST_WRITER_SHORT_READ") == "1"

view = memoryview(data)
offset = 0
while offset < len(data):
    part = view[offset:]
    if short_write:
        short_write = False
        part = view[offset:offset + 1]
    try:
        written = os.write(fd, part)
    except OSError as exc:
        fail_content("write failed (" + str(exc.strerror) + ")")
    if written <= 0:
        fail_content("write made no progress")
    offset += written

if env("PRR_TEST_WRITER_TRUNCATE") == "1":
    os.ftruncate(fd, max(0, len(data) - 1))

try:
    if env("PRR_TEST_WRITER_MODE_FAIL") == "1":
        raise OSError(1, "injected mode failure")
    os.fchmod(fd, 0o644 if env("PRR_TEST_WRITER_MODE_WRONG") == "1" else 0o600)
    applied = stat.S_IMODE(os.fstat(fd).st_mode)
    if applied != 0o600:
        warn("the review file " + path + " reads back as mode " + oct(applied) + ", not 0600; continuing, its privacy rests on the 0700 attempt directory")
except OSError as exc:
    warn("could not set the review file " + path + " to mode 0600 (" + str(exc.strerror) + "); continuing, its privacy rests on the 0700 attempt directory")

try:
    os.lseek(fd, 0, os.SEEK_SET)
except OSError as exc:
    fail_content("cannot rewind for the read-back (" + str(exc.strerror) + ")")

expected = len(data)
got = b""
while len(got) < expected + 1:
    want = expected + 1 - len(got)
    if short_read:
        short_read = False
        want = 1
    try:
        chunk = os.read(fd, want)
    except OSError as exc:
        fail_content("read-back failed (" + str(exc.strerror) + ")")
    if not chunk:
        break
    got += chunk
if got != data:
    fail_content(str(len(got)) + " bytes read back, " + str(expected) + " written")
sys.exit(0)
'

# --- argument parsing --------------------------------------------------------
PROVIDER=""
WORKTREE=""
PROMPT_FILE=""
ARTIFACT_ROOT=""
BASE=""
TIMEOUT="$DEFAULT_TIMEOUT"
# Empty means "not requested"; the provider-specific defaults are resolved after
# --provider is known (see the strength-knob validation below).
MODEL=""
EFFORT=""

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--provider)
		PROVIDER="${2:-}"
		shift 2 || die_usage "--provider needs a value"
		;;
	--worktree)
		WORKTREE="${2:-}"
		shift 2 || die_usage "--worktree needs a value"
		;;
	--prompt-file)
		PROMPT_FILE="${2:-}"
		shift 2 || die_usage "--prompt-file needs a value"
		;;
	--artifact-root)
		ARTIFACT_ROOT="${2:-}"
		shift 2 || die_usage "--artifact-root needs a value"
		;;
	--base)
		BASE="${2:-}"
		shift 2 || die_usage "--base needs a value"
		;;
	--timeout)
		TIMEOUT="${2:-}"
		shift 2 || die_usage "--timeout needs a value"
		;;
	--model)
		MODEL="${2:-}"
		shift 2 || die_usage "--model needs a value"
		;;
	--effort)
		EFFORT="${2:-}"
		shift 2 || die_usage "--effort needs a value"
		;;
	--)
		shift
		break
		;;
	-*) die_usage "unknown flag '$1'" ;;
	*) die_usage "unexpected argument '$1'" ;;
	esac
done

# --- validation --------------------------------------------------------------
command -v jq >/dev/null 2>&1 || die_usage "jq is required but not on PATH"
# python3 is a HARD precondition, preflighted here rather than discovered later:
# every `passed`/`issues` result must carry a verified reviewFile, and finding
# the interpreter missing AFTER a completed review would throw away work nobody
# can get back — a run that cannot produce a reviewFile should never have paid a
# provider. It exits 70 (operational), NOT die_usage's 64: the invocation was
# well-formed, and this path introduces no new exit-64 case.
command -v python3 >/dev/null 2>&1 || {
	echo "peer-review-run: python3 is required but not on PATH (it writes and verifies the result's reviewFile)" >&2
	exit 70
}

case "$PROVIDER" in
claude | codex) ;;
"") die_usage "--provider is required (claude|codex)" ;;
*) die_usage "unsupported --provider '$PROVIDER' (claude|codex)" ;;
esac

# --- strength knobs ----------------------------------------------------------
# Resolved here, before any filesystem side effect, for the same reason --timeout
# is: a usage error must exit 64 without littering the artifact root.
#
# Effort defaults to `high` for BOTH providers. This is a deliberate floor, not a
# preference: the caller that omits --effort is the caller that has not thought
# about review strength, and the failure mode of guessing low is a peer that
# passes work it should have caught.
[ -n "$EFFORT" ] || EFFORT=high
case "$EFFORT" in
low | medium | high | xhigh) ;;
max)
	# claude documents `max`; codex has no such level. Rejecting it here beats
	# passing it through, because `codex exec -c model_reasoning_effort=<junk>`
	# does NOT fail fast — it echoes the bogus level in its session header and
	# then dies on a 400 from the API, mid-review, after the timeout budget has
	# already been spent.
	[ "$PROVIDER" = claude ] ||
		die_usage "--effort max is claude-only (got provider '$PROVIDER'; use xhigh)"
	;;
*) die_usage "--effort must be low|medium|high|xhigh|max (got '$EFFORT')" ;;
esac
# `none` and `minimal` are deliberately NOT accepted. `none` is precisely the
# silent-weakness this flag exists to prevent (it is what a codex peer inherited
# before these defaults), and `minimal` is rejected by the API on current models
# anyway — neither is a level anyone should be able to ask a REVIEWER for.

# Model defaults per provider. Claude has stable rolling aliases, so `opus` names
# the current top tier without going stale. Codex's families (gpt-5.6-luna /
# -sol / -terra) expose no rolling alias, and hard-coding one dated ID here would
# rot into a WRONG pin that outlives the model — worse than the CLI's own default,
# which at least tracks the installed release. So codex stays unpinned unless the
# caller names a model explicitly.
if [ -z "$MODEL" ] && [ "$PROVIDER" = claude ]; then
	MODEL=opus
fi
# A model spelled like a flag would silently become one on the provider's argv.
case "$MODEL" in
-*) die_usage "--model must not start with '-' (got '$MODEL')" ;;
esac

# Codex, and ONLY when the caller named no model: recover the root top-level
# `model` from $CODEX_HOME/config.toml — the file the container's rolling /model
# workflow writes — which this adapter's own --ignore-user-config would otherwise
# discard, leaving the peer on the bare CLI default. Only a ROOT `model` crosses
# the isolation boundary, and only when NO root `profile` and NO root
# `model_provider` is selected: either makes the name profile- or
# provider-dependent, and forwarding it without the configuration that interprets
# it would silently review with something else. Any explicit provider selection
# is conservatively provider-dependent even when its value resembles a built-in,
# so no provider identity is hard-coded as safe.
#
# Resolved HERE, in the strength-knob block, before the artifact root, the
# session dir, the help-probe capture, or any other filesystem side effect —
# never deferred to build_cmd_codex() — so the degradation warning is on stderr
# even for a run that later dies creating its artifact root, and so the lookup
# can never be influenced by the reviewed worktree.
#
# The parsed value is data: it rides through the Bash argv array in
# build_cmd_codex, so whitespace, quotes or shell metacharacters in it can never
# become shell syntax.
if [ -z "$MODEL" ] && [ "$PROVIDER" = codex ]; then
	CODEX_CONFIG_FILE="${CODEX_HOME:-$HOME/.codex}/config.toml"
	CONFIGURED_MODEL="$(python3 -I -c "$PRR_CONFIG_MODEL_PY" --prr-config-model "$CODEX_CONFIG_FILE" </dev/null)"
	case "$?" in
	0) MODEL="$CONFIGURED_MODEL" ;;
	3) ;; # nothing usable configured — the documented no-`-m`, model:null default
	*) ;; # degraded; the reader has already named the reason on stderr
	esac
fi

# Validate --timeout BEFORE any filesystem side effect (the artifact-root mkdir
# and session-dir mktemp below): a usage error must exit 64 without littering
# the artifact root with an empty session directory.
case "$TIMEOUT" in
'' | *[!0-9.]* | '.' | *.*.*) die_usage "--timeout must be a positive number of seconds (got '$TIMEOUT')" ;;
esac
awk -v t="$TIMEOUT" 'BEGIN{exit !(t>0)}' || die_usage "--timeout must be > 0 (got '$TIMEOUT')"

[ -n "$WORKTREE" ] || die_usage "--worktree is required"
case "$WORKTREE" in
/*) ;;
*) die_usage "--worktree must be an absolute path (got '$WORKTREE')" ;;
esac
[ -d "$WORKTREE" ] || die_usage "--worktree '$WORKTREE' is not a directory"
# Keep the RAW (symlink-unresolved) worktree spelling too: the artifact-root
# containment check below rejects an in-worktree spelling as well as an
# in-worktree physical target, and matching the raw spelling covers a worktree
# that is ITSELF reached through a symlink.
RAW_WORKTREE="$WORKTREE"
WORKTREE="$(realpath -- "$WORKTREE")" || die_usage "cannot resolve --worktree"
# Reject the filesystem ROOT as a worktree. Containment ("artifact-root OUTSIDE
# the worktree") is impossible when the worktree is `/` — every absolute path
# lives under it — and the prefix check below silently DEGENERATES there: the
# `"$_wt/"` prefix becomes `//`, which no ordinary absolute artifact root (e.g.
# `/tmp/prr`) matches, so a root worktree would WRONGLY be accepted even though
# the read-only peer can reach the attempt artifacts. A root spelled `//`, `/.`,
# a symlink to `/`, etc. all resolve here to `/`, so this one check covers them.
# Reviewing the entire filesystem root is never a legitimate peer-review target.
[ "$WORKTREE" != "/" ] || die_usage "--worktree must not be the filesystem root '/' (got '$RAW_WORKTREE')"

[ -n "$PROMPT_FILE" ] || die_usage "--prompt-file is required"
[ -f "$PROMPT_FILE" ] || die_usage "--prompt-file '$PROMPT_FILE' is not a regular file"
[ -r "$PROMPT_FILE" ] || die_usage "--prompt-file '$PROMPT_FILE' is not readable"
PROMPT_FILE="$(realpath -- "$PROMPT_FILE")" || die_usage "cannot resolve --prompt-file"

[ -n "$ARTIFACT_ROOT" ] || die_usage "--artifact-root is required"
case "$ARTIFACT_ROOT" in
/*) ;;
*) die_usage "--artifact-root must be an absolute path (got '$ARTIFACT_ROOT')" ;;
esac
# Reject any `..` path component up front. A legitimate caller passes a clean
# absolute artifact path; `..` only matters as an ATTACK on the containment check
# below: `<worktree>/link/../../root` traverses an in-worktree symlink (`link`)
# yet, because normalization COLLAPSES the `..`, its resolved spellings can land
# outside both worktree prefixes and slip past the checks — while the path, walked
# from the `--cd` worktree, still reaches the artifacts. Forbidding `..` removes
# that whole class (the padding makes a leading/trailing/standalone `..` match too,
# while a dir literally named `..foo` does not).
case "/$ARTIFACT_ROOT/" in
*/../*) die_usage "--artifact-root must not contain a '..' path component (got '$ARTIFACT_ROOT')" ;;
esac
# Resolve the artifact root in TWO spellings, WITHOUT creating anything (both
# tolerate missing trailing components), so the containment checks below run
# BEFORE any mkdir — creating the dir first and rejecting after would MUTATE the
# read-only review target by leaving a directory inside the worktree for a
# rejected in-worktree root.
#   PHYS (`realpath -m`, symlinks RESOLVED) — the real directory we create and use.
#   LEX  (`realpath -ms`, symlinks NOT resolved, `.`/`..` normalized) — the spelling
#         the caller handed us.
ARTIFACT_ROOT_PHYS="$(realpath -m -- "$ARTIFACT_ROOT")" || die_usage "cannot resolve --artifact-root"
ARTIFACT_ROOT_LEX="$(realpath -ms -- "$ARTIFACT_ROOT")" || die_usage "cannot resolve --artifact-root"
RAW_WORKTREE_LEX="$(realpath -ms -- "$RAW_WORKTREE")" || die_usage "cannot resolve --worktree"
# The artifact root must live OUTSIDE the worktree: the peer is `--cd`'d into the
# worktree read-only and can traverse anything reachable from it, so attempt
# artifacts (and sibling 0700 attempts) must not be reachable from the review
# surface. We reject BOTH:
#   * an in-worktree PHYSICAL target (the obvious `--artifact-root <wt>/sub` case), and
#   * an in-worktree LEXICAL spelling — a `--artifact-root` that IS, or passes
#     THROUGH, a symlink LIVING in the worktree. `realpath -m` would rewrite such
#     a spelling to its external target (passing the physical check), yet the
#     peer can still reach the artifacts by traversing that in-worktree link, so
#     the resolved-path check alone is not enough.
# Both raw and resolved worktree prefixes are tested so a worktree reached through
# a symlink is covered from either side, and with `..` already forbidden a
# collapsed spelling cannot escape the prefix while still routing through an
# in-worktree symlink. Checked before mkdir so a rejected root is never created
# inside the worktree.
# Residual (same class as the same-UID traversal note by SESSION_DIR): this closes
# an artifact root ROUTED through an in-worktree symlink, not an arbitrary blind
# symlink a repo might commit pointing at the caller's external root — whose
# unpredictable per-invocation session-dir name it would still have to guess.
for _art in "$ARTIFACT_ROOT_PHYS" "$ARTIFACT_ROOT_LEX"; do
	for _wt in "$WORKTREE" "$RAW_WORKTREE_LEX"; do
		case "$_art/" in
		"$_wt/"*) die_usage "--artifact-root must be OUTSIDE --worktree (got '$ARTIFACT_ROOT' → '$_art' under '$_wt'); an in-worktree or in-worktree-symlinked root stays reachable by the read-only peer" ;;
		esac
	done
done
ARTIFACT_ROOT="$ARTIFACT_ROOT_PHYS"
mkdir -p -- "$ARTIFACT_ROOT" 2>/dev/null || die_usage "cannot create --artifact-root '$ARTIFACT_ROOT'"

# Sibling-attempt isolation — the BY-DEFAULT guarantee, and its honest residual.
# All attempt dirs share ONE Unix owner, so 0700 keeps OTHER users out but does
# NOT stop this owner's provider from reading a concurrent invocation's artifacts
# if it can LOCATE them. We make the by-default guarantee as strong as filesystem
# permissions allow:
#   * every attempt of THIS invocation is nested under one per-invocation,
#     unpredictably-named session dir (0700), never a direct child of ARTIFACT_ROOT;
#   * the provider is handed only the MINIMAL paths it needs — it is `--cd`'d into
#     the WORKTREE under review (artifacts stay OUT of that tree), and given only
#     the one specific output-file path inside its OWN attempt dir; it is never
#     handed ARTIFACT_ROOT, the session dir, or a sibling/retry path on argv,
#     stdin, --cd, or --output-last-message;
#   * so the only directory the provider is pointed at, and whose neighbourhood it
#     can list, contains just this invocation's own attempts — a normal review
#     never encounters a sibling or a retry sibling.
# Residual, stated honestly (NOT complete isolation): the providers' read-only
# sandboxes are permission/read-only, NOT a private mount namespace, and they run
# as the SAME UID as these artifacts. A DETERMINED provider that manually traverses
# the filesystem — climbing `..` out of its handed attempt dir to ARTIFACT_ROOT and
# enumerating sibling session dirs by name — CAN therefore read paths it was never
# handed. Filesystem permissions alone cannot prevent a same-UID reader, and this
# nesting does not claim to: it removes trivial "by default" exposure only. Complete
# traversal-proof isolation would require a filesystem sandbox (bubblewrap / a
# private mount namespace) confining the provider to the worktree plus its own
# attempt dir, which is OUT OF SCOPE for this helper. The guarantee here is
# precisely: the helper does not HAND a sibling/parent path and a normal review
# does not encounter one — not that a hostile provider cannot manually traverse to
# one. See scripts/test-peer-review-run.sh case 11c, which asserts both the handed-
# path guarantee AND (honestly) the traversable residual.
SESSION_DIR="$(mktemp -d "${ARTIFACT_ROOT}/prr-XXXXXXXXXXXX")" ||
	die_usage "cannot create a session directory under '$ARTIFACT_ROOT'"
ensure_private_dir "$SESSION_DIR"

# The peer binary is the OPPOSITE agent's CLI, resolved by provider name.
PEER_BIN="$PROVIDER"

# --- provider capability probe ----------------------------------------------
# Both adapters adapt to the INSTALLED CLI: codex's `--json` live streaming and
# config/hook-isolation flags, and claude's `--effort`, all exist only on
# sufficiently new CLIs, so each is probed against ONE cached help capture and
# omitted when absent — honest degradation, never an unknown-flag hard failure.
# Only the selected provider is ever probed (PROVIDER is fixed for the run), so
# this stays one subprocess whichever side we are on. The help COMMAND differs
# per provider; everything below it — the bounded budget, the process-group
# supervision, the reaping — is provider-neutral and shared verbatim.
#
# Claude's `-p --output-format json` still buffers its single final result — no
# live events — so it remains liveProgress:false regardless of what the probe
# finds; the probe exists for `--effort`, not for progress.
case "$PROVIDER" in
codex) PROVIDER_HELP_CMD=(codex exec --help) ;;
claude) PROVIDER_HELP_CMD=(claude --help) ;;
esac
PROVIDER_HELP_FILE="$SESSION_DIR/$PROVIDER-help.txt"
PROVIDER_HELP=""
PROVIDER_HELP_PROBED=0
provider_supports() {
	if [ "$PROVIDER_HELP_PROBED" = 0 ]; then
		# Bound the probe: the provider help command should return instantly, but it must
		# never be able to hang or leak descendants, so it runs under the SAME
		# process-group supervision as an attempt — `set -m` isolates it into its
		# own validated group, the captured-descendant set is seeded/refreshed
		# while it lives, and reap_tree runs on EVERY probe exit (fast success
		# included), so a background child the help path leaves behind (an
		# updater, a wrapper's helper) is swept by the group signal instead of
		# outliving the run — the helper's no-live-peer-process guarantee covers
		# the probe, not only the attempts. The WHOLE probe is bounded by
		# min(--timeout, 10s) (see the budget derivation below) — an inner
		# `timeout -k <grace> <term>` plus a poll deadline at that budget, belt-and-
		# suspenders against a hanging `--help` — so a small --timeout caps the probe
		# too: a help command that hangs cannot stall the run past the
		# requested deadline before any attempt even starts, honoring the timeout
		# contract. If the probe
		# times out or fails, the capture stays empty, no flag matches, and every
		# probed feature falls back to its safe default (no --json live progress,
		# no extra flags) rather than assuming support. ACCEPTED RESIDUAL, same
		# class as the attempt poll loop's: a probe child that BOTH daemonizes
		# into a new session (setsid, escaping the group signal) AND is orphaned
		# before a poll tick could snapshot it — for a sub-second probe that
		# window spans most of its lifetime — cannot be reached by any PID walk;
		# an in-group stray is always reaped via the group.
		#
		# The capture goes through a FILE, never a command substitution over a
		# pipe: a stray descendant that INHERITED stdout would hold a pipe's
		# write end open, and a $(...) read would then block on EOF long after
		# the probe itself died — hanging the helper before any attempt timeout
		# applies. With a file there is no pipe reader, and a stray inheritor of
		# the file descriptor delays nothing. stdin comes from /dev/null so a
		# misbehaving probe cannot sit reading the helper's own stdin either. The
		# capture lands in the session dir as a retained diagnostic artifact.
		local probe_child probe_pgid probe_lead probe_t0 probe_now
		local probe_budget probe_term probe_grace probe_bs
		# Bound the WHOLE probe by min(--timeout, 10s): that budget is the hard poll
		# backstop, with the inner `timeout` TERM at 1/2 the budget and SIGKILL at
		# 3/4 (leaving a 1/4-budget cushion so the child is already dead by the
		# backstop and reap_tree's group_alive returns immediately). For any realistic
		# --timeout a hung `--help` is thus reaped within the deadline — not
		# deadline+grace+slack — honoring the timeout contract. TIMEOUT is validated
		# > 0 and may be fractional; `timeout` and `awk` both accept fractional
		# seconds. The 10s cap keeps a hung `--help` from waiting the full default
		# 900s. Two bounded residuals, both irreducible here: (1) the poll loop's
		# ~0.1s tick is the effective floor, so a sub-0.1s budget (a degenerate
		# --timeout no review could meet anyway) is bounded to ~0.1s rather than the
		# tinier budget — and a budget that rounds a term/grace to 0.000 just disables
		# the inner timer, leaving the poll backstop as the bound; (2) a probe
		# descendant that BOTH escapes the group via setsid AND ignores TERM adds
		# reap_tree's fixed TERM+grace+KILL window (~5s) — the same stubborn-escapee
		# residual documented above, not reachable by any deadline the group timer
		# enforces.
		probe_budget="$(awk -v t="$TIMEOUT" 'BEGIN{b=(t<10)?t:10; printf "%.3f", b}')"
		probe_term="$(awk -v b="$probe_budget" 'BEGIN{printf "%.3f", b/2}')"
		probe_grace="$(awk -v b="$probe_budget" 'BEGIN{printf "%.3f", b/4}')"
		probe_bs="$probe_budget"
		set -m
		(exec timeout -k "$probe_grace" "$probe_term" "${PROVIDER_HELP_CMD[@]}" \
			>"$PROVIDER_HELP_FILE" 2>&1 </dev/null) &
		probe_child=$!
		# Register the probe with the EXIT trap IMMEDIATELY, mirroring the
		# attempt launch (see run_attempt for the full ordering rationale):
		# leader first with an EMPTY pgid — from this very assignment the reap
		# primitives cover the bare probe child directly (implicit-member rule:
		# probed and signalled by positive PID while it has no captured entry),
		# never an unvalidated group signal — captured-set seed next (the
		# leader's identity baseline, extending coverage to descendants and
		# handing the leader over to the start-time-verified sweep), validated
		# pgid last, so the ps probe below runs fully covered. The signal
		# window between $! and this assignment is the irreducible residual.
		CURRENT_LEADER="$probe_child"
		CURRENT_PGID=""
		set +m
		probe_lead="$(proc_starttime "$probe_child" || true)"
		CAPTURED_DESC=" ${probe_child}:${probe_lead} "
		# Same PGID validation as an attempt: signal a group only when it is
		# provably the probe's own (see the attempt launch for the rationale).
		probe_pgid="$(ps -o pgid= -p "$probe_child" 2>/dev/null | tr -d ' ')"
		if [ -z "$probe_pgid" ]; then
			probe_pgid="$probe_child"
		elif [ "$probe_pgid" != "$probe_child" ]; then
			probe_pgid=""
		fi
		CURRENT_PGID="$probe_pgid"
		probe_t0=$(date +%s.%N)
		while kill -0 "$probe_child" 2>/dev/null; do
			capture_descendants "$probe_child"
			probe_now=$(date +%s.%N)
			# Backstop deadline over the inner timeout's own term+grace bound.
			if awk -v a="$probe_now" -v b="$probe_t0" -v d="$probe_bs" 'BEGIN{exit !((a-b)>d)}'; then
				break
			fi
			sleep 0.1
		done
		reap_tree "$probe_child" "$probe_pgid" || {
			REAP_WARN=1
			printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL after the help probe"}\n' "$PROVIDER" >&2
		}
		wait "$probe_child" 2>/dev/null || true
		CURRENT_LEADER=""
		CURRENT_PGID=""
		CAPTURED_DESC=" "
		PROVIDER_HELP="$(cat "$PROVIDER_HELP_FILE" 2>/dev/null || true)"
		PROVIDER_HELP_PROBED=1
	fi
	printf '%s' "$PROVIDER_HELP" | grep -Eq -- "$1"
}

# LIVE=1 when the provider streams progress this run; drives forward_tick and
# the liveProgress result field.
LIVE=0

# The strength the peer ACTUALLY ran at, as opposed to what was requested. Empty
# means "not applied" and is reported as JSON null. Seeded empty because the
# builders are the only writers and an `unavailable` run (missing binary) never
# reaches one — under `set -u` an unset variable at the emit site would abort the
# result the caller is waiting for.
EFFECTIVE_MODEL=""
EFFECTIVE_EFFORT=""

# --- provider command builders ----------------------------------------------
# Each builder populates the CMD array. The prompt is NEVER placed on argv or
# expanded by a shell — it is fed on stdin from the attempt's prompt.txt.
CMD=()

build_cmd_claude() {
	# Read-only headless review. Claude has NO filesystem sandbox, so its
	# read-only guarantee is purely permission/tool-surface based. We therefore do
	# NOT rely on allowlisted read *commands*: an allowlisted `Bash(cat:*)` (or any
	# command-prefix rule) still permits shell REDIRECTION — `cat secret > file`
	# WRITES, because the permission match is on the command prefix, not the
	# redirection. That is the same write vector as the earlier `sed -i` hole.
	#
	# Instead we shrink the very TOOL SET Claude can use to the native read-only
	# tools (Read/Grep/Glob) via `--tools`, so no shell (Bash) tool exists at all —
	# there is no command to redirect, and no write-capable tool in the set. The
	# allowlist auto-approves exactly those read tools (in `-p` mode a tool that is
	# not allowed cannot prompt, so it is denied), and the disallow list is
	# defense-in-depth naming Bash and every write tool explicitly.
	#   --safe-mode disables CLAUDE.md, skills, plugins, hooks, MCP servers, custom
	#     commands/agents and other customizations, so an untrusted review run
	#     cannot inherit user hooks/MCP state (auth, tools and permissions still
	#     work normally).
	#   --no-session-persistence keeps the prompt and result off disk (no resumable
	#     session), so nothing persists outside this attempt's artifact dir.
	# Residual, honest: Read/Grep/Glob can still READ any path Claude's own user can
	# read (that is the point of a review), but none of them can WRITE. Because
	# there is no Bash tool, the Claude reviewer cannot run `git diff`/`git log`
	# itself — a diff-oriented prompt should embed the diff or reference the base;
	# the file tree is reviewable directly over --add-dir. Omitting
	# --dangerously-skip-permissions keeps permissions enforced.
	#
	# Rule-list form: `--allowedTools`/`--disallowedTools` are variadic
	# (`<tools...>`) and the documented permission-rule syntax is one `Tool` /
	# `Tool(specifier)` rule per value, so every rule rides as its OWN argv
	# element — never one space-joined string, which a strict rule parser would
	# read as a single (unmatched) rule and therefore approve nothing.
	CMD=(claude -p
		--safe-mode
		--no-session-persistence
		--output-format json
		--tools "Read,Grep,Glob"
		--allowedTools Read Grep Glob
		--disallowedTools Bash Write Edit MultiEdit NotebookEdit WebFetch WebSearch
		--add-dir "$WORKTREE")
	# Strength pin. `--model` is unprobed: it has been part of `claude -p` for as
	# long as the headless mode has existed, so probing it would buy nothing and
	# cost a branch. `--effort` IS probed, because it is recent enough that a
	# lagging image can lack it — and an unknown flag would abort the review
	# outright rather than merely losing the pin.
	#
	# When the probe says no, we drop the flag and record effort as null. That is
	# the ONE case where the peer runs at inherited strength, and it must be
	# visible: silently omitting the flag would leave the caller believing it got
	# `high` while the CLI quietly used whatever the shared config last said,
	# which is the exact failure this knob exists to end.
	CMD+=(--model "$MODEL")
	EFFECTIVE_MODEL="$MODEL"
	if provider_supports '--effort'; then
		CMD+=(--effort "$EFFORT")
		EFFECTIVE_EFFORT="$EFFORT"
	else
		EFFECTIVE_EFFORT=""
		echo "peer-review-run: installed claude has no --effort; running at the CLI's inherited effort (result reports effort:null)" >&2
	fi
	# Auth mode is chosen by the orchestrator (see "Claude peer auth precedence"):
	# in `login` mode ALL inherited env credentials — ANTHROPIC_API_KEY,
	# ANTHROPIC_AUTH_TOKEN, AND CLAUDE_CODE_OAUTH_TOKEN — are cleared so the
	# logged-in subscription session (`.credentials.json`) is used. Claude Code's
	# credential order checks every one of these env vars AHEAD of the stored
	# login (ANTHROPIC_AUTH_TOKEN, then ANTHROPIC_API_KEY, then apiKeyHelper, then
	# CLAUDE_CODE_OAUTH_TOKEN, then the /login credentials) with NO fall-through
	# within a single invocation, so a stray/stale value in ANY of them would
	# shadow a working login — turning the peer `unavailable`, or billing to the
	# pricier API account. CLAUDE_CODE_OAUTH_TOKEN is a SETUP-TOKEN env credential,
	# not the on-disk login, so it must be cleared here too: clearing only the two
	# ANTHROPIC_* vars would let a stale setup token still shadow the login. In
	# `key` mode all three are left so the documented env-credential fallback
	# authenticates the peer. The clear rides as an `env -u` prefix — it execs in
	# place, so no extra process and the supervised leader PID is still the provider.
	# Non-credential settings (e.g. ANTHROPIC_BASE_URL) are never touched.
	if [ "${CLAUDE_AUTH_MODE:-login}" = login ]; then
		CMD=(env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN "${CMD[@]}")
	fi
	LIVE=0
}

build_cmd_codex() {
	# Read-only sandbox rooted at the worktree. `-c mcp_servers={}` stops any
	# configured MCP/server state from leaking into an untrusted review run.
	# --ephemeral runs without persisting session files to disk, so the prompt and
	# transcript do not persist outside this attempt's artifact dir (the explicit
	# --output-last-message file is still written — it is an output target, not a
	# session file). --output-last-message captures the peer's final message for
	# verdict parsing. `-` reads the prompt from stdin. --json (when supported)
	# adds the live event stream we forward.
	local dir="$1"
	# -c approval_policy=never: a headless read-only review must never stop to
	# ask for approval — under an inherited `on-request`/`untrusted` policy a
	# reviewer that needs to run `git diff`/`rg` would stall or burn the timeout
	# instead of returning a verdict. The config override is version-independent
	# (highest precedence; an unrecognized key is ignored without
	# --strict-config), so it also covers older CLIs that inherit an approval
	# policy from user config; the flag spelling (--ask-for-approval never) is
	# probed below and added only where `codex exec` accepts it.
	# -c project_doc_max_bytes=0: do NOT read the reviewed worktree's AGENTS.md
	# as instructions. --ignore-user-config/--ignore-rules leave project docs
	# enabled, so without this the code under review could steer its own
	# reviewer through its (possibly PR-modified) AGENTS.md.
	CMD=(codex exec
		--sandbox read-only
		--cd "$WORKTREE"
		--ephemeral
		-c "mcp_servers={}"
		-c "approval_policy=never"
		-c "project_doc_max_bytes=0"
		-c "model_reasoning_effort=$EFFORT"
		--output-last-message "$dir/codex-last-message.txt")
	# The effort override rides unprobed and unconditionally, on the same
	# version-independence argument as approval_policy above: `-c` is the highest
	# precedence layer and an unrecognized key is ignored without --strict-config,
	# so it cannot become an unknown-flag failure on an older CLI.
	#
	# It also has to ride LAST among the strength inputs for a reason specific to
	# this adapter: --ignore-user-config (below) drops $CODEX_HOME/config.toml to
	# stop the reviewed worktree steering its own reviewer, and that same drop
	# takes `model_reasoning_effort` with it. Without this line the isolation we
	# want silently buys a peer reviewing at `reasoning effort: none`.
	EFFECTIVE_EFFORT="$EFFORT"
	# Model stays unpinned unless asked for — see the --model default rationale in
	# the header. `-m` is a long-standing `codex exec` flag, so it needs no probe.
	if [ -n "$MODEL" ]; then
		CMD+=(-m "$MODEL")
		EFFECTIVE_MODEL="$MODEL"
	else
		EFFECTIVE_MODEL=""
	fi
	# Config/hook isolation — the Codex analog of the Claude adapter's
	# --safe-mode: the code under review must not be able to steer its own
	# reviewer. Clearing mcp_servers alone is not enough — for a TRUSTED project,
	# Codex still loads the repo's project-local config and hooks, letting the
	# reviewed worktree inject behavior into the supposedly isolated peer run.
	#   --ignore-user-config  skips $CODEX_HOME/config.toml (auth still works).
	#     Because persisted project TRUST lives in that user config's `projects`
	#     table, ignoring it also drops the trust mark, so trusted-project
	#     behaviors (project-local config/hooks) do not activate for the
	#     reviewed worktree.
	#   --ignore-rules        skips user AND project execpolicy `.rules` files.
	#   --disable hooks       turns the hooks feature off for this invocation
	#     (defense in depth against repo hooks, e.g. <repo>/.codex/hooks.json).
	# Each flag is probed (one cached `codex exec --help`) and omitted on an
	# older CLI that lacks it — degrading to the mcp-only isolation rather than
	# failing on an unknown flag.
	provider_supports '--ignore-user-config' && CMD+=(--ignore-user-config)
	provider_supports '--ignore-rules' && CMD+=(--ignore-rules)
	provider_supports '--disable( |=|<)' && CMD+=(--disable hooks)
	# The explicit flag form of the approvals-off policy, where `codex exec`
	# accepts it (current CLIs, e.g. 0.144.6, do not list it on exec — there the
	# `-c approval_policy=never` override above already applies).
	provider_supports '--ask-for-approval' && CMD+=(--ask-for-approval never)
	if provider_supports '--json'; then
		CMD+=(--json)
		LIVE=1
	else
		LIVE=0
	fi
	CMD+=(-)
}

# --- progress forwarding -----------------------------------------------------
# Forward newly-appended provider stdout lines to STDERR as normalized progress
# events, without a second supervised process: the poll loop calls this each
# tick. Only active when LIVE=1 (Codex --json).
FWD_LINES=0
forward_tick() {
	[ "$LIVE" = 1 ] || return 0
	local f="$1" total i line
	total=$(wc -l <"$f" 2>/dev/null || echo 0)
	i="$FWD_LINES"
	while [ "$i" -lt "$total" ]; do
		i=$((i + 1))
		line=$(sed -n "${i}p" "$f")
		printf '{"event":"progress","provider":"%s","line":%s}\n' \
			"$PROVIDER" "$(printf '%s' "$line" | jq -Rs .)" >&2
	done
	FWD_LINES="$total"
}

# --- classification helpers --------------------------------------------------
# An unavailable peer: missing binary, no/expired login, or exhausted usage.
# These are NON-transient — retrying wastes quota — so they short-circuit retry.
looks_unavailable() {
	grep -Eiq \
		'not (logged|signed) ?in|please (run )?[^ ]*login|log ?in (again|required)|re-?authenticate|unauthorized|(^|[^0-9])401([^0-9]|$)|(^|[^0-9])429([^0-9]|$)|usage limit|rate.?limit|too many requests|quota (exceeded|exhausted|reached)|(credits?|usage|balance) (exhausted|exceeded|depleted)|insufficient (quota|credit)' \
		"$@"
}

# A TRANSIENT execution failure: one that a second attempt could plausibly
# recover from — a network/connection error, an explicit timeout, or a server-side
# 5xx/overloaded/"try again" signal. The retry policy is an ALLOWLIST, not a
# denylist: we retry ONLY when a failure is positively identified as transient
# here. An unclassified/unknown non-zero exit is NOT transient and is NOT retried
# (retrying an unknown deterministic failure just wastes time and quota). Rate
# limit / quota / auth signals are handled earlier as `unavailable` (also
# non-transient), so they never reach this test.
looks_transient() {
	grep -Eiq \
		'network (error|is unreachable|unreachable)|connection (refused|reset|closed|timed out|error|aborted)|could not (connect|resolve)|failed to (connect|resolve)|name resolution|dns (error|lookup)|socket hang ?up|broken pipe|error sending request|temporar(y|ily) (unavailable|fail)|(^|[^a-z])(etimedout|econnreset|econnrefused|econnaborted|enetunreach|ehostunreach|eai_again|epipe)([^a-z]|$)|timed out|timeout (of|while|waiting|exceeded|error)|(^|[^0-9])(502|503|504)([^0-9]|$)|bad gateway|gateway time-?out|service (unavailable|temporarily)|server (error|is overloaded)|overloaded|please try again|try again (later|in)|upstream (error|connect)' \
		"$@"
}

# Extract the peer's final message text for the given provider from the captured
# output. Prints the text; returns 1 when a structured response is malformed.
extract_final_message() {
	local provider="$1" out="$2" dir="$3"
	case "$provider" in
	claude)
		# `--output-format json` emits ONE JSON object. Honor the result envelope:
		# only a `type == "result"`, non-error object carries a trustworthy final
		# message. A malformed (non-JSON) response, a non-result `type`, or an
		# `is_error == true` envelope is NOT a usable verdict — return 1 so a pass
		# token buried inside an error/malformed envelope can never become `passed`.
		jq -e . "$out" >/dev/null 2>&1 || return 1
		local etype is_err
		etype="$(jq -r '.type // ""' "$out" 2>/dev/null)"
		is_err="$(jq -r 'if (.is_error == true) then "1" else "0" end' "$out" 2>/dev/null)"
		if [ "$etype" != "result" ] || [ "$is_err" = "1" ]; then
			return 1
		fi
		jq -r '.result // ""' "$out"
		;;
	codex)
		# The final assistant message is captured verbatim in the -o file.
		cat "$dir/codex-last-message.txt" 2>/dev/null || true
		;;
	esac
}

# Normalize a peer's final message to pass | issues | none. The runner parses a
# documented VERDICT token the reviewer emits; it does NOT judge review content
# (that is the caller's/prompt's policy). A missing token is never a pass.
detect_verdict() {
	local text="$1"
	# Anchor to a VERDICT line: the token must begin the line (after only optional
	# markdown/quote decoration — spaces, `>`, `*`, `#`, `-`, backticks), NOT sit
	# mid-sentence, so an inline example like "reviewers end with 'VERDICT: PASS'"
	# is not mistaken for the real verdict. ISSUES is tested FIRST and takes
	# precedence over PASS: a body that both quotes an example pass token and
	# renders a real issues verdict must resolve to issues, never false-pass.
	local anchor='^[[:space:]>*#`-]*VERDICT[[:space:]]*[:=][[:space:]]*'
	# The PASS side uses a STRICTER anchor whose leading-decoration class EXCLUDES
	# the QUOTE markers > (blockquote) and backtick (inline code / code fence): a
	# real pass verdict is not quoted, so a VERDICT token reachable only THROUGH a
	# quote marker at ANY depth in the decoration run — a blockquote, a
	# list-then-blockquote, a list-then-inline-code, etc. — is an ECHOED example and
	# must not pass. Neutral structural decoration (whitespace, list markers * and
	# -, heading #) is still allowed. The ISSUES check (a) keeps the lenient anchor
	# (over-matching issues is the safe direction and can never false-pass).
	local pass_anchor='^[[:space:]*#-]*VERDICT[[:space:]]*[:=][[:space:]]*'
	local issue='(issues?|changes?|blocking|block|reject|rejected|fail|failed|request[[:space:]_-]*changes?)'
	local pass='(passed|pass|approved|approve|lgtm|no[[:space:]_-]*issues?)'
	# A trailing token boundary: the recognized PASS token must END at a non-word
	# char or end-of-line, so a longer word that merely STARTS with it is NOT a
	# pass — `VERDICT: PASSING` must NOT match `pass`, and only a bare `pass`/
	# `passed`/… is a real pass verdict.
	local rb='([^[:alnum:]_]|$)'
	# (a) An issues token at the verdict value → issues. Left unbounded on purpose:
	# over-matching the ISSUES side is the SAFE direction (it can never cause a
	# false pass), so we keep it broad.
	if printf '%s\n' "$text" | grep -Eiq "${anchor}${issue}"; then
		echo issues
		return
	fi
	# Before the PASS-side checks (b, c), strip FENCED and INDENTED code blocks into
	# a scan copy with a proper lexer, so an echoed example verdict inside one never
	# reaches the PASS scan (pass_anchor alone would accept it — a fenced or indented
	# VERDICT line has no decoration of its OWN). A fenced block OPENS on a line that, after optional
	# indentation and optional BLOCK decoration (blockquote >, list markers - * +
	# and ordered N. / N)), is a run of >= 3 identical ` or ~; the char and length
	# are recorded. It CLOSES only on a line that, after optional indentation ONLY
	# (a decorated line is CONTENT, never a closer), is a run of the SAME fence char
	# of length >= the opener's, then nothing but whitespace. Enforcing CommonMark's
	# char+length rule means a LONGER outer fence wrapping a shorter example, a
	# mismatched ~/` delimiter, or a decorated line cannot desync the parity and
	# leak the inner VERDICT line. An INDENTED code block line (>= 4 columns of
	# leading indentation — four spaces, or a tab from column 0-3) is dropped the
	# same way, so an indented `    VERDICT: PASS` example a forfeiting peer echoes
	# never reaches the PASS scan; over-stripping a needlessly indented REAL verdict
	# only forfeits it (SAFE), and a 1-3 space indent stays below the threshold and
	# still passes. QUOTED forms that put a marker on the VERDICT line
	# ITSELF (blockquote, inline code, any nesting) need no stripping here —
	# pass_anchor rejects them by excluding > and backtick from its decoration
	# class. The ISSUES check (a) above deliberately stays on the FULL text:
	# over-matching issues is the SAFE direction and can never false-pass, so a
	# fenced/quoted/indented VERDICT: ISSUES still counts. A peer that needlessly QUOTES its
	# OWN real verdict degrades to `none` (forfeited) — also safe; the caller's
	# prompt asks for a bare VERDICT line. Residuals, honest and irreducible without
	# a full Markdown BLOCK+INLINE parse (this scan is line-oriented) — all exotic,
	# never produced by a compliant peer that emits its own bare VERDICT line:
	#   * a bare UNQUOTED free-standing example line, byte-identical to a real one;
	#   * a genuine verdict following an EXOTICALLY container-nested fenced example
	#     (mixed list+blockquote, whose CommonMark continuation this line-oriented
	#     lexer cannot track) may be forfeited — a false NEGATIVE, SAFE (never a
	#     false pass); resolving it needs a full CommonMark container parser;
	#   * a VERDICT line that is itself bare but enclosed by a MULTILINE inline code
	#     span (single-backtick opened/closed on OTHER lines) reads as bare — the
	#     one non-safe residual, in the R1 class, requiring inline-span lexing.
	local scan_text
	scan_text="$(printf '%s\n' "$text" | awk '
		!inf {
			s = $0
			sub(/^[[:space:]]*/, "", s)
			# Count and strip a leading BLOCKQUOTE prefix (> markers): a
			# blockquote-nested fence closes on a line carrying the SAME > depth, so
			# record it (bqd).
			d = 0
			while (match(s, /^>[[:space:]]*/)) {
				d++
				s = substr(s, RLENGTH + 1)
			}
			# Strip list markers (these appear only on the opener; the content and
			# closer are indented, not re-marked).
			sub(/^([*+-][[:space:]]*|[0-9]+[.)][[:space:]]*)+/, "", s)
			run = ""
			if (match(s, /^`+/) || match(s, /^~+/)) run = substr(s, RSTART, RLENGTH)
			info = substr(s, length(run) + 1)
			# A backtick fence opener may NOT carry a backtick in its info string —
			# that is a single-line inline CODE SPAN, not a fence, so it must not open
			# a block and swallow a following genuine verdict. Tilde fences have no
			# such restriction.
			if (length(run) >= 3 && (substr(run, 1, 1) == "~" || index(info, "`") == 0)) {
				inf = 1
				fc = substr(run, 1, 1)
				fl = length(run)
				bqd = d
			} else if ($0 !~ /^(    |\t| \t|  \t|   \t)/) print
			# else: a CommonMark INDENTED code block line (>= 4 columns of leading
			# indentation — four spaces, or a tab from column 0-3) is DROPPED from the
			# scan copy, exactly like a fenced block, so an echoed `    VERDICT: PASS`
			# example a forfeiting peer indents never reaches the PASS scan. Dropping
			# ONLY over-strips (a genuine but needlessly >=4-indented verdict degrades
			# to a forfeit) — the SAFE direction, never a false pass; a compliant peer
			# emits its own verdict at column 0. A 1-3 space indent stays below the
			# code-block threshold and still passes.
			next
		}
		{
			s = $0
			sub(/^[[:space:]]*/, "", s)
			# A closer must sit at the SAME blockquote depth as its opener: a > prefix
			# where the opener had none is CONTENT (it never closes a plain block —
			# else an example `> ```` inside a plain fence would end it early), and a
			# missing > prefix does not close a blockquote-scoped fence (else the
			# fence would swallow a following genuine top-level verdict).
			d = 0
			while (match(s, /^>[[:space:]]*/)) {
				d++
				s = substr(s, RLENGTH + 1)
			}
			crun = ""
			if (match(s, /^`+/) || match(s, /^~+/)) crun = substr(s, RSTART, RLENGTH)
			rest = substr(s, length(crun) + 1)
			sub(/[[:space:]]*$/, "", rest)
			if (d == bqd && length(crun) >= fl && substr(crun, 1, 1) == fc && rest == "") { inf = 0; fc = ""; fl = 0 }
		}
	')"
	# (b) A MIXED verdict line: a pass token followed LATER ON THE SAME LINE by an
	# issue token — the literal contract template `VERDICT: PASS | ISSUES`, or a
	# reviewer hedging like `VERDICT: APPROVED, CHANGES REQUIRED` — is NOT a clean
	# pass and resolves to issues (an issue token is present), never a false pass.
	# The trailing issue token is boundary-checked on BOTH sides so an ordinary
	# word merely containing one (`unchanged`) cannot trip it, and NEGATED phrases
	# ("no issues", "no blocking changes" — themselves pass language) are scrubbed
	# from the scanned copy first so `VERDICT: PASS — no issues found` stays a
	# pass; the pass check (c) below runs on the SAME fence-stripped copy. BEFORE
	# that scrub, a `no issues`-style alias sitting AT the verdict value — where it
	# IS the pass token — is canonicalized to a literal `pass`, so the scrub cannot
	# delete the verdict's own pass token and hide a mixed line from this scan:
	# `VERDICT: NO ISSUES, CHANGES REQUIRED` must resolve to issues here, while a
	# bare `VERDICT: NO ISSUES` (nothing mixed to find) still passes via (c).
	local nb='[^[:alnum:]_]'
	local scrubbed
	scrubbed="$(printf '%s\n' "$scan_text" |
		sed -E "s/(${anchor})no[[:space:]_-]*issues?(${rb})/\\1pass\\2/I" |
		sed -E "s/(^|${nb})(no|zero|without)([[:space:]_-]+[[:alnum:]]+)?[[:space:]_-]+(issues?|changes?|blockers?|blocking|problems?|failures?)/\\1/gI")"
	if printf '%s\n' "$scrubbed" | grep -Eiq "${pass_anchor}${pass}(${nb}.*)?${nb}${issue}${rb}"; then
		echo issues
		return
	fi
	# (c) A bare pass token as the verdict value, bounded so `PASSING` and any other
	# longer word that only begins with a pass token cannot masquerade as a pass.
	# Uses pass_anchor (no >/backtick), so a quoted or nested-quoted example never
	# reaches a pass here.
	if printf '%s\n' "$scan_text" | grep -Eiq "${pass_anchor}${pass}${rb}"; then
		echo pass
		return
	fi
	echo none
}

# Absolute path of the normalized review file for the CURRENT attempt, or empty
# when this attempt produced no usable review prose. Reset per attempt so a retry
# that ends in a non-success outcome can never report the earlier attempt's file.
REVIEW_FILE=""

# write_review_file <attempt_dir> <parsed_final_message> — normalize the peer's
# already-parsed final message into <dir>/review.txt, the provider-neutral
# payload the result points at, and prove the bytes landed. FAIL CLOSED: a caller
# handed `passed` must never be handed a truncated, empty or absent review, so
# any writer failure ends the run at 70 with no result rather than reporting one
# whose prose cannot be trusted. 70 is the helper's operational status — the
# invocation was well-formed and the filesystem gave out afterwards — so this
# never routes through die_usage, whose synopsis would reprint the required flags
# for an invocation that had nothing wrong with it.
#
# The prose rides through a PIPE with `printf %s`: a here-string appends a
# newline and a $( ) capture strips them, either of which would make the writer's
# byte-equality check pass or fail for reasons unrelated to the code.
#
# The status is tested explicitly because the helper runs without `set -e` —
# nothing else would notice — and the contract's status is 70, not whatever the
# interpreter happened to return.
write_review_file() {
	local dir="$1" text="$2" f rc
	f="$dir/review.txt"
	printf '%s' "$text" | python3 -I -c "$PRR_WRITE_REVIEW_PY" --prr-write-review "$f"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "peer-review-run: the review file '$f' could not be produced (writer exit $rc); discarding an otherwise complete review rather than emitting a result that points at unverified prose" >&2
		exit 70
	fi
	REVIEW_FILE="$f"
}

# --- a single attempt --------------------------------------------------------
# Sets: ATTEMPT_DIR ATT_OUTCOME ATT_VERDICT ATT_EXIT ATT_ELAPSED ATT_REASON
#       ATT_TRANSIENT (1 when the failure is retryable)
run_attempt() {
	local attempt_no="$1"
	ATT_VERDICT=none
	ATT_EXIT=null
	ATT_TRANSIENT=0
	REVIEW_FILE=""
	# 1 only when this attempt was `unavailable` because the peer BINARY is
	# missing (a preflight miss), as opposed to an auth/usage failure. The Claude
	# key-fallback keys off this: a missing binary cannot be fixed by switching
	# auth mode, so it must NOT trigger a pointless second attempt.
	ATT_BINARY_MISSING=0

	ATTEMPT_DIR="$(mktemp -d "${SESSION_DIR}/peer-review-${PROVIDER}-XXXXXX")" ||
		die_usage "cannot create an attempt directory under '$SESSION_DIR'"
	ensure_private_dir "$ATTEMPT_DIR"
	local dir="$ATTEMPT_DIR"
	local out="$dir/provider.stdout" err="$dir/provider.stderr"
	: >"$out"
	: >"$err"

	# Literal prompt: copied in, then fed on stdin. Never on argv, never eval'd.
	cp -- "$PROMPT_FILE" "$dir/prompt.txt"

	# Preflight: a missing peer binary is an unavailable outcome, not a crash.
	if ! command -v "$PEER_BIN" >/dev/null 2>&1; then
		ATT_OUTCOME=unavailable
		ATT_BINARY_MISSING=1
		ATT_ELAPSED=0
		ATT_REASON="provider binary '$PEER_BIN' is not installed on PATH"
		write_meta "$dir" "$attempt_no" "unavailable-preflight"
		return 0
	fi

	# Start the attempt clock BEFORE build_cmd. Both adapters run the bounded
	# provider help capability probe (once per run, on the first
	# attempt) — real wall time the caller waited. elapsedSeconds is the contract's
	# TOTAL wall time across all attempts, so the probe must be COUNTED; timing from
	# after build_cmd would silently drop it (a slow-but-successful probe made the
	# reported elapsedSeconds far shorter than the real wall time).
	local start end child pgid rc timed_out=0 leader_start
	start=$(date +%s.%N)
	case "$PROVIDER" in
	claude) build_cmd_claude ;;
	codex) build_cmd_codex "$dir" ;;
	esac
	write_meta "$dir" "$attempt_no" "launched"

	if [ "$LIVE" = 1 ]; then
		printf '{"event":"note","provider":"%s","liveProgress":true,"message":"streaming provider events"}\n' "$PROVIDER" >&2
	else
		printf '{"event":"note","provider":"%s","liveProgress":false,"message":"buffered final result; no live progress"}\n' "$PROVIDER" >&2
	fi

	# Launch the provider as its OWN process group (set -m gives each job its own
	# group) so the whole tree can be reaped by group id. The subshell execs into
	# the provider and is the group leader.
	FWD_LINES=0
	set -m
	(cd "$WORKTREE" && exec "${CMD[@]}" <"$dir/prompt.txt" >"$out" 2>"$err") &
	child=$!
	# Register the leader with the EXIT trap IMMEDIATELY — before the start-time
	# read, the captured-set seed, and the PGID probe below — so a TERM/INT
	# landing during that setup still lets on_exit reap the child instead of
	# leaking it (on_exit is gated on CURRENT_LEADER). CURRENT_PGID stays EMPTY
	# until the group is validated: an empty pgid makes the trap's reap skip
	# group signalling and rely on the implicit-member direct leader signal plus
	# the start-time-verified captured-set sweep — fail-safe, it can never
	# signal an unowned group. Ordering within the setup window, safest first:
	# leader registration (arms the trap — the reap primitives treat the bare
	# leader as an implicit tree member, probing and signalling it by positive
	# PID while it has no captured entry, so a trap firing in this gap already
	# terminates the fresh child; the previous attempt's set was cleared after
	# its reap, so the gap set is empty and cannot shadow the new leader), then
	# the captured-set seed (the leader's identity baseline: from then on the
	# start-time-verified sweep governs the leader, a later-recycled leader PID
	# is never signalled, and each poll tick's live walk extends coverage to
	# descendants), then the PGID probe — the slowest step, a ps fork — which
	# thus runs fully covered by both. Residual, irreducible in shell: a signal
	# arriving between $! and this very next assignment still predates the
	# trap's knowledge.
	CURRENT_LEADER="$child"
	CURRENT_PGID=""
	set +m
	# Seed the fresh per-attempt captured set with the leader's launch-time
	# identity IMMEDIATELY: every later live walk (capture_descendants) verifies
	# the walk root still matches this baseline before trusting the process
	# table, so once the original leader is gone — or its PID recycled — no walk
	# can enumerate an unrelated process's children and feed them to the sweep.
	# If the leader exits before the baseline can be read (empty), no live walk
	# ever runs — fail-safe: reaping then relies on the group signal alone.
	leader_start="$(proc_starttime "$child" || true)"
	CAPTURED_DESC=" ${child}:${leader_start} "
	# VALIDATE that the child leads its own process group before we ever send a
	# negative-PID (whole-group) signal: confirm its PGID equals its own PID.
	#   * probe == child            → validated group; signal it by PGID.
	#   * probe non-empty && != child → job control did NOT isolate the child (it
	#     shares another group, possibly the helper's own): leave pgid empty and
	#     fall back to single-PID signalling — NEVER TERM/KILL an unowned group.
	#   * probe empty (child already exited before we could read it) → under
	#     `set -m` the job had its own group whose PGID equalled its PID BY
	#     CONSTRUCTION, so trust that. Signalling that group only reaches the
	#     provider's own descendants (an already-empty group is a harmless ESRCH);
	#     this avoids losing group-reaping when a provider exits faster than the
	#     probe and leaves a stray grandchild behind.
	pgid="$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')"
	if [ -z "$pgid" ]; then
		pgid="$child"
	elif [ "$pgid" != "$child" ]; then
		pgid=""
	fi
	CURRENT_PGID="$pgid"

	# Poll: forward progress and enforce the deadline. On the deadline we only flag
	# the timeout and break; the single reap_tree below handles termination for
	# BOTH the timeout and the normal/failed-exit paths identically. EVERY tick
	# also snapshots the leader's live descendants while it is still alive: on the
	# validated-PGID path the snapshot SUPPLEMENTS the group signal — a descendant
	# that moves itself into a new session/process group (e.g. a provider tool
	# calling setsid) has left the group, and only the start-time-verified PID
	# sweep can still reach it after the group kill — and on the unvalidated
	# fallback it is the only reach at all (a walk rooted at the already-dead
	# leader finds nothing once children reparent to init). reap_tree itself
	# re-walks (group_alive/signal_tree call capture_descendants), but a live walk
	# runs ONLY while the original leader still matches its launch-time baseline —
	# see capture_descendants' recapture guard.
	#
	# ACCEPTED RESIDUAL: a descendant the leader forks AND orphans within the
	# final <100ms poll interval, right before the leader exits on its own, can
	# escape the snapshot — and if it ALSO left the process group (setsid), then
	# neither the group signal (validated path) nor the captured-set sweep can
	# reach it. This mirrors the same-UID traversal residual: it is bounded — a
	# sub-100ms window requiring the provider to deliberately daemonize at the
	# last instant; a group-escaping descendant seen by ANY earlier tick IS swept —
	# and the start-time-verified signalling guarantees we never mis-signal a
	# recycled PID while closing it as far as a PID walk can. A fully race-free
	# reap would need the kernel's own process-tree accounting (a private PID
	# namespace), which is out of scope for this helper.
	while kill -0 "$child" 2>/dev/null; do
		forward_tick "$out"
		capture_descendants "$child"
		end=$(date +%s.%N)
		if awk -v a="$end" -v b="$start" -v t="$TIMEOUT" 'BEGIN{exit !((a-b)>t)}'; then
			timed_out=1
			break
		fi
		sleep 0.1
	done

	if [ "$timed_out" = 1 ]; then
		# Deadline hit while the tree was still running: TERM it, wait a bounded
		# grace, escalate to KILL for survivors, and confirm nothing remains.
		reap_tree "$child" "$pgid" || {
			REAP_WARN=1
			printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL after timeout"}\n' "$PROVIDER" >&2
		}
		wait "$child" 2>/dev/null || true
	else
		# The leader exited on its own (that is why the poll loop ended). Collect
		# its real status first, then sweep any stray descendant a completed OR
		# failed provider left behind in the group — TERM, grace, KILL, confirm —
		# so no grandchild outlives the run.
		if wait "$child"; then rc=0; else rc=$?; fi
		reap_tree "$child" "$pgid" || {
			REAP_WARN=1
			printf '{"event":"warn","provider":"%s","message":"a descendant survived KILL after exit"}\n' "$PROVIDER" >&2
		}
	fi
	CURRENT_LEADER=""
	CURRENT_PGID=""
	# Clear the spent set so the NEXT attempt's setup gap starts empty: a stale
	# entry that happened to collide with the next leader's freshly assigned PID
	# would otherwise suppress the implicit-member direct path (entry present,
	# baseline stale → pid_matches fails → nothing signalled) and re-open the
	# gap leak. The probe path does the same after its reap.
	CAPTURED_DESC=" "
	forward_tick "$out" # flush any trailing lines
	end=$(date +%s.%N)
	ATT_ELAPSED=$(awk -v a="$end" -v b="$start" 'BEGIN{printf "%.3f", (a-b)}')

	if [ "$timed_out" = 1 ]; then
		ATT_OUTCOME=timeout
		ATT_EXIT=null
		ATT_REASON="provider exceeded the ${TIMEOUT}s timeout and its process group was reaped"
		write_meta "$dir" "$attempt_no" "timeout"
		return 0
	fi

	ATT_EXIT="$rc"

	if [ "$rc" -ne 0 ]; then
		# Classify the non-zero exit (scan only on failure so a successful review
		# that merely DISCUSSES rate limits or usage errors is never misread). The
		# retry policy is a TRANSIENT ALLOWLIST — retry ONLY a positively identified
		# transient failure; an unknown/unclassified failure is NOT retried:
		#   * auth/login or usage/quota problem   → UNAVAILABLE (non-transient;
		#     retrying wastes quota).
		#   * positively transient (network/5xx/timeout/overloaded) → FAILED,
		#     retried once with a fresh attempt dir.
		#   * anything else (unclassified/deterministic) → FAILED, NOT retried.
		if looks_unavailable "$out" "$err"; then
			ATT_OUTCOME=unavailable
			ATT_REASON="provider reported an authentication or usage/quota problem (exit $rc)"
			write_meta "$dir" "$attempt_no" "unavailable"
			return 0
		fi
		if looks_transient "$out" "$err"; then
			ATT_OUTCOME=failed
			ATT_TRANSIENT=1
			ATT_REASON="provider hit a transient failure (exit $rc); retrying"
			write_meta "$dir" "$attempt_no" "failed-transient"
			return 0
		fi
		ATT_OUTCOME=failed
		ATT_TRANSIENT=0
		ATT_REASON="provider failed (exit $rc); not a recognized transient failure, not retried"
		write_meta "$dir" "$attempt_no" "failed-nontransient"
		return 0
	fi

	# Exit 0: parse the final message.
	local text
	if ! text="$(extract_final_message "$PROVIDER" "$out" "$dir")"; then
		# Ran to a clean exit but its final message is malformed / an error
		# envelope / otherwise unintelligible: the peer FORFEITED a usable verdict.
		# This is a DISTINCT outcome from a deterministic retry-exhausted `failed`
		# (an execution failure) — the process succeeded, the verdict did not. Not
		# retried: a clean exit that produced garbage is deterministic. Never a pass.
		ATT_OUTCOME=forfeited
		ATT_VERDICT=none
		ATT_TRANSIENT=0
		ATT_REASON="provider exited 0 but produced a malformed/unparseable response"
		write_meta "$dir" "$attempt_no" "malformed"
		return 0
	fi

	if [ -z "${text//[[:space:]]/}" ]; then
		# Ran, exited 0, but delivered no usable message: the peer forfeited a
		# verdict. NEVER a pass on empty output.
		ATT_OUTCOME=forfeited
		ATT_REASON="provider exited 0 with an empty final message"
		write_meta "$dir" "$attempt_no" "forfeited-empty"
		return 0
	fi

	ATT_VERDICT="$(detect_verdict "$text")"
	# The review file is written HERE, where the outcome is set, because `text` is
	# a `local` of this function and is gone by the time run_attempt returns.
	case "$ATT_VERDICT" in
	pass)
		ATT_OUTCOME=passed
		ATT_REASON="provider exited 0 with an explicit pass verdict"
		write_review_file "$dir" "$text"
		;;
	issues)
		ATT_OUTCOME=issues
		ATT_REASON="provider exited 0 and reported an issues verdict"
		write_review_file "$dir" "$text"
		;;
	none)
		ATT_OUTCOME=forfeited
		ATT_REASON="provider exited 0 but emitted no recognizable VERDICT token"
		;;
	esac
	write_meta "$dir" "$attempt_no" "$ATT_OUTCOME"
	return 0
}

# Record per-attempt metadata for the retained artifact (the invocation record).
write_meta() {
	local dir="$1" attempt_no="$2" phase="$3"
	jq -n \
		--arg provider "$PROVIDER" \
		--arg worktree "$WORKTREE" \
		--arg base "$BASE" \
		--arg timeout "$TIMEOUT" \
		--arg attempt "$attempt_no" \
		--arg phase "$phase" \
		'{provider:$provider,worktree:$worktree,base:$base,timeoutSeconds:($timeout|tonumber),attempt:($attempt|tonumber),phase:$phase}' \
		>"$dir/meta.json" 2>/dev/null || true
}

# --- Claude peer auth precedence: login PRIMARY, env credential FALLBACK ------
# powbox precedence (README "Cross-Agent Delegation"): a logged-in subscription
# session is PRIMARY (cheaper, the intended path); an env credential —
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or a CLAUDE_CODE_OAUTH_TOKEN setup
# token — is the FALLBACK for when the login is ABSENT or cannot authenticate
# (expired, or hit a session limit). Headless `claude -p` would instead always
# prefer an env credential (Claude Code checks all three AHEAD of the stored
# `.credentials.json` login, with no fall-through in one invocation), so the
# orchestrator drives the precedence: attempt the login first (ALL env
# credentials cleared — see build_cmd_claude), and if that attempt comes back
# `unavailable` (an auth/usage failure that yields no verdict) while an env
# credential IS available, retry ONCE in key mode (env credentials left intact).
# EITHER credential may be expired; if neither authenticates, the peer stays
# `unavailable`. Codex is unaffected (CODEX_API_KEY is a first-class auth path,
# not a login override).
CLAUDE_HAS_LOGIN=0
if [ "$PROVIDER" = claude ]; then
	claude_cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
	# Presence of the credentials file is the login signal (Claude writes it on
	# OAuth login; an API-key-only setup has none).
	[ -s "$claude_cfg/.credentials.json" ] && CLAUDE_HAS_LOGIN=1
fi
# The env-credential fallback: any of these three env vars can authenticate the
# peer, and login mode clears ALL of them (see build_cmd_claude), so ALL three
# count as a usable fallback that justifies the login→key retry. Omitting the
# setup token here would strand an expired stored login beside a WORKING
# CLAUDE_CODE_OAUTH_TOKEN as `unavailable`: login mode strips the token, the
# stored login fails, and no fallback would fire.
CLAUDE_HAS_KEY=0
{ [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ] || [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; } && CLAUDE_HAS_KEY=1
# Start in login mode when a login exists; otherwise the key is the only auth.
if [ "$CLAUDE_HAS_LOGIN" = 1 ]; then
	CLAUDE_AUTH_MODE=login
else
	CLAUDE_AUTH_MODE=key
fi

# --- run with retry-once for transient failures ------------------------------
ATTEMPTS=0
RETRIED=false
# Total wall time across ALL attempts. ATT_ELAPSED is per-attempt and would be
# overwritten by a retry, under-reporting a retried run's real cost to a caller
# using elapsedSeconds for diagnostics or scheduling — so the emitted value is
# the accumulated sum, not the final attempt alone.
TOTAL_ELAPSED=0

run_attempt 1
ATTEMPTS=1
TOTAL_ELAPSED=$(awk -v a="$TOTAL_ELAPSED" -v b="$ATT_ELAPSED" 'BEGIN{printf "%.3f", a+b}')

if [ "$PROVIDER" = claude ] && [ "$CLAUDE_AUTH_MODE" = login ] && [ "$ATT_OUTCOME" = unavailable ] && [ "$ATT_BINARY_MISSING" = 0 ] && [ "$CLAUDE_HAS_KEY" = 1 ]; then
	# The login attempt could not AUTHENTICATE the peer (expired session, or a
	# session limit) — fall back to the documented env-credential path ONCE, in a
	# brand-new attempt dir. Gated on ATT_BINARY_MISSING=0: a missing `claude`
	# binary is also `unavailable`, but switching auth mode cannot fix it, so it
	# must not trigger a pointless second attempt or a misleading retry note. This
	# is a DISTINCT retry from the transient allowlist below (an auth failure is
	# not transient), and it is mutually exclusive with it — total attempts stay
	# capped at 2. The key-mode result then stands as-is; if it too is
	# `unavailable`, neither credential authenticated and we give up.
	printf '{"event":"note","provider":"claude","message":"login peer unavailable; retrying with the env-credential fallback (ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / CLAUDE_CODE_OAUTH_TOKEN)"}\n' >&2
	CLAUDE_AUTH_MODE=key
	run_attempt 2
	ATTEMPTS=2
	TOTAL_ELAPSED=$(awk -v a="$TOTAL_ELAPSED" -v b="$ATT_ELAPSED" 'BEGIN{printf "%.3f", a+b}')
	RETRIED=true
	if [ "$ATT_TRANSIENT" = 1 ]; then
		# The env-credential fallback attempt ITSELF failed transiently. The
		# 2-attempt cap means no further retry, so correct the per-attempt
		# "…; retrying" reason (run_attempt leaves it optimistic) to reflect that
		# this was the last try.
		ATT_REASON="provider failed transiently on the env-credential fallback attempt (exit ${ATT_EXIT}); attempt cap reached, not retried further"
	fi
elif [ "$ATT_TRANSIENT" = 1 ]; then
	# Retry ONCE, with a brand-new attempt directory (never reuse the first).
	printf '{"event":"note","provider":"%s","message":"transient failure; retrying once"}\n' "$PROVIDER" >&2
	run_attempt 2
	ATTEMPTS=2
	TOTAL_ELAPSED=$(awk -v a="$TOTAL_ELAPSED" -v b="$ATT_ELAPSED" 'BEGIN{printf "%.3f", a+b}')
	RETRIED=true
	if [ "$ATT_TRANSIENT" = 1 ]; then
		# Both attempts failed transiently → exhausted.
		ATT_OUTCOME=failed
		ATT_REASON="provider failed on two attempts (retry exhausted); last exit ${ATT_EXIT}"
	fi
fi

# --- emit the versioned result ----------------------------------------------
# If any reap reported a survivor after SIGKILL, the "leave no live peer process"
# guarantee could not be fully met on this run — reflect that honestly in the
# reason so a consumer never reads a clean outcome as proof the tree is gone.
if [ "$REAP_WARN" = 1 ]; then
	ATT_REASON="${ATT_REASON} [WARNING: a provider descendant survived SIGKILL and may still be running]"
fi

exit_json="$ATT_EXIT"
case "$exit_json" in
'' | null) exit_json=null ;;
*[!0-9]*) exit_json=null ;;
esac
live_json=false
[ "$LIVE" = 1 ] && live_json=true
# Empty effective strength → JSON null, not "". A caller checking `.effort` for
# the level it asked for must be able to tell "not applied" from a real value,
# and an empty string reads as neither.
model_json=null
[ -n "$EFFECTIVE_MODEL" ] && model_json="$(jq -n --arg m "$EFFECTIVE_MODEL" '$m')"
effort_json=null
[ -n "$EFFECTIVE_EFFORT" ] && effort_json="$(jq -n --arg e "$EFFECTIVE_EFFORT" '$e')"
# Same null discipline for the additive review payload: only a `passed`/`issues`
# attempt that actually produced and verified the file reports a path.
review_json=null
[ -n "$REVIEW_FILE" ] && review_json="$(jq -n --arg r "$REVIEW_FILE" '$r')"

# Emitting this single JSON object IS the helper's contract with the caller — if
# jq cannot produce it, the run has no parseable result, so fail as an OPERATIONAL
# error (non-zero) rather than exiting 0 with no/garbled output that a caller might
# misread. All inputs here are already validated/normalized, so this is a
# belt-and-suspenders guard.
if ! jq -nc \
	--arg schema "$SCHEMA" \
	--arg provider "$PROVIDER" \
	--arg outcome "$ATT_OUTCOME" \
	--arg verdict "$ATT_VERDICT" \
	--argjson elapsed "$TOTAL_ELAPSED" \
	--argjson exitStatus "$exit_json" \
	--argjson attempts "$ATTEMPTS" \
	--argjson retried "$RETRIED" \
	--argjson liveProgress "$live_json" \
	--argjson model "$model_json" \
	--argjson effort "$effort_json" \
	--arg artifactDir "$ATTEMPT_DIR" \
	--argjson reviewFile "$review_json" \
	--arg reason "$ATT_REASON" \
	'{schema:$schema,provider:$provider,outcome:$outcome,verdict:$verdict,elapsedSeconds:$elapsed,exitStatus:$exitStatus,attempts:$attempts,retried:$retried,liveProgress:$liveProgress,model:$model,effort:$effort,artifactDir:$artifactDir,reviewFile:$reviewFile,reason:$reason}'; then
	echo "peer-review-run: internal error — could not emit the result JSON" >&2
	exit 70
fi

exit 0
