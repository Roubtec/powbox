.claude/settings.local.json
.powbox.local.yml
.claude/worktrees/
node_modules/
.worktrees/
# Host-side staging clone of Roubtec/agent-skills, populated by build.sh for the
# Codex skill bake (see scripts/build-image.sh). Never committed.
.agent-skills-src/
# Host-side staging of the agent instruction template (core template plus the
# selected layer set's agent-notes.md) and of the on-demand agent reference
# directory, written by build.sh for the agent bake (see
# scripts/stage-agent-template.sh and scripts/stage-agent-reference.sh). Never
# committed.
.powbox-staging/
# Host-local layer-set selector: one line naming a docker/layers/<set>; absent
# means the lean image (see .powbox-layers.example).
.powbox-layers
# Host-local egress exceptions for every container this checkout launches;
# absent means the default firewall policy (see .powbox-egress.example).
.powbox-egress
# A user's own layer set; only the placeholder that keeps the directory is
# tracked.
docker/layers/custom/*
!docker/layers/custom/.gitkeep
