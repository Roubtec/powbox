#!/usr/bin/env bash
# pg-dev-up — stand up a throwaway local PostgreSQL for integration suites.
#
# powbox bakes the PostgreSQL 16 server binaries but deliberately does NOT
# auto-start a daemon (most containers never need one, and an always-on server
# would clash with a project's own docker-compose Postgres). This helper does
# the initdb + start + createdb dance on demand, as the unprivileged `node`
# user: the Debian `postgres` system user has no password set, so the usual
# `sudo -u postgres ...` path is a dead end here. Trust auth on a loopback-only
# socket is appropriate — the container itself is the security boundary.
#
# Usage:
#   pg-dev-up [up]      init (first run) + start, ensure role/db, print DATABASE_URL
#   pg-dev-up status    report whether the dev cluster is running (exit 1 if not)
#   pg-dev-up url       print the DATABASE_URL for the configured role/db
#   pg-dev-up down      stop the dev cluster ($PGDATA is kept for a later restart)
#   pg-dev-up check     verify the server binaries are present (no daemon needed)
#   pg-dev-up help
#
# Scoped mode (opt-in) — isolate the cluster per Git worktree so parallel
# worktrees can run database tests concurrently without sharing one cluster,
# data directory, or port. The flag goes BEFORE the command and applies to
# up / status / url / down:
#   pg-dev-up --worktree [up|status|url|down]   scope to the current Git worktree
#   pg-dev-up --profile <id> [up|status|...]    scope to an explicit identifier
# e.g.
#   pg-dev-up --worktree up
#   eval "$(pg-dev-up --worktree url --export)"
#   pg-dev-up --worktree down
# Scoped mode derives an isolated data directory under a private temp root and
# allocates its own free loopback port (recorded next to the data dir so later
# status/url/down resolve the SAME server that up started). `--worktree` requires
# being inside a Git repository; outside one, pass `--profile <id>` with a stable
# identifier rather than guessing. Two different worktrees (or profiles) receive
# distinct data dirs and ports and stop independently. Ordinary `pg-dev-up up`
# (no flag) is UNCHANGED: /tmp/pgdata on port 5432.
#
# Environment overrides (defaults in parentheses):
#   PGDATA            cluster data directory  (/tmp/pgdata; scoped: <root>/<key>/pgdata)
#   PGPORT            listen port             (5432; scoped: an allocated free port)
#   POSTGRES_USER     app role to ensure      (postgres)
#   POSTGRES_PASSWORD app role password       (postgres)
#   POSTGRES_DB       app database to ensure  (postgres)
# An explicit PGDATA or PGPORT is authoritative and REPLACES only that one scoped
# default (the other scoped defaults still apply); POSTGRES_USER/PASSWORD/DB
# behave the same scoped or not. POWBOX_PG_SCOPED_ROOT overrides the scoped temp
# root (default ${TMPDIR:-/tmp}/pg-dev-up-scoped).
#
# To match a project's expected credentials, set the env vars before calling,
# e.g.  POSTGRES_USER=telemed POSTGRES_PASSWORD=telemed POSTGRES_DB=telemed pg-dev-up
#
# Export the connection string into your current shell with:
#   eval "$(pg-dev-up url --export)"
#   eval "$(pg-dev-up --worktree url --export)"   # scoped
set -euo pipefail

# Capture whether the caller set PGDATA/PGPORT EXPLICITLY (to a NON-empty value)
# before we apply any defaults, so scoped mode can honor an explicit override
# while still deriving every other scoped value. An empty value is meaningless
# and must NOT count as explicit — otherwise a stray `PGDATA=` in the environment
# would silently fall back to /tmp/pgdata and let a scoped `down` stop the
# unscoped cluster.
PGDATA_EXPLICIT=""
[ -n "${PGDATA:-}" ] && PGDATA_EXPLICIT="yes"
PGPORT_EXPLICIT=""
[ -n "${PGPORT:-}" ] && PGPORT_EXPLICIT="yes"

PG_HOST="127.0.0.1"
POSTGRES_USER="${POSTGRES_USER:-postgres}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
POSTGRES_DB="${POSTGRES_DB:-postgres}"

# Scoped-mode state (populated by the flag parse + resolve_scope below).
SCOPED=""
SCOPE_MODE=""       # worktree | profile
SCOPE_PROFILE_ID="" # for --profile <id>
SCOPED_ROOT="${POWBOX_PG_SCOPED_ROOT:-${TMPDIR:-/tmp}/pg-dev-up-scoped}"
INSTANCE_DIR=""
PORT_FILE=""
DATADIR_FILE=""

# Snapshot of the scoped port/datadir markers as they were BEFORE this `up` began
# to touch them (captured in resolve_scope). cmd_up rolls the markers back to this
# snapshot if initialization or start fails, so a failed override can never orphan
# the previously-running scoped instance or leave later down/status resolving a
# cluster that never came up.
PRIOR_PORT_EXISTED=""
PRIOR_PORT_CONTENT=""
PRIOR_DATADIR_EXISTED=""
PRIOR_DATADIR_CONTENT=""

# These get their final values in configure_paths(), after the command and any
# scope flag are known: scoped mode replaces the data dir / socket dir / port,
# unscoped mode keeps the historical /tmp defaults.
PGDATA="${PGDATA:-}"
PGPORT="${PGPORT:-}"
PG_SOCKDIR="/tmp"

log() { printf 'pg-dev-up: %s\n' "$*" >&2; }

# Publish a scoped marker file ATOMICALLY: write to a sibling temp file, then
# rename it into place. A concurrent reader (a `down`/`status` in another
# worktree) therefore sees either the previous complete value or the new
# complete one — never an empty/partial file caught mid-write, which could
# otherwise resolve to the wrong (or the unscoped) cluster.
atomic_write() {
	local dest="$1" content="$2" tmp
	tmp="$(mktemp "${dest}.XXXXXX")"
	printf '%s\n' "$content" >"$tmp"
	mv -f "$tmp" "$dest"
}

# Debian keeps the server binaries (initdb, pg_ctl, postgres) off PATH under
# /usr/lib/postgresql/<major>/bin; pick the highest installed major version.
find_bindir() {
	local d best=""
	for d in /usr/lib/postgresql/*/bin; do
		[ -x "$d/initdb" ] || continue
		if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "$best" "$d" | sort -V | tail -1)" = "$d" ]; then
			best="$d"
		fi
	done
	[ -n "$best" ] || return 1
	printf '%s\n' "$best"
}

BINDIR="$(find_bindir || true)"

require_bindir() {
	if [ -z "$BINDIR" ]; then
		log "PostgreSQL server binaries not found (expected /usr/lib/postgresql/*/bin)."
		exit 1
	fi
}

# --- scoped-mode identity + port bookkeeping -------------------------------
#
# The scoped instance KEY is a hash — not a human-readable slug — of the Powbox
# container identity, the repository's common Git dir, and the current worktree
# toplevel (or, for --profile, the explicit id). A basename alone can collide
# across repositories; hashing the common Git dir + toplevel makes two worktrees
# of one repo, and same-named worktrees of different repos, land in distinct
# instances. Truncated SHA-256 is plenty for a per-container temp namespace.
scope_key() {
	local common top
	# NUL-separate the fields so no field value can bleed into the next: a path or
	# id containing the separator can't forge a different tuple that hashes the
	# same. NUL can appear in neither a filesystem path nor an env value, so it is
	# an unambiguous frame. Pipe straight into sha256sum — never store NULs in a
	# shell variable (bash command substitution would strip them).
	if [ "$SCOPE_MODE" = profile ]; then
		printf 'profile\0%s\0%s\0' "${CONTAINER_NAME:-}" "$SCOPE_PROFILE_ID" |
			sha256sum | cut -c1-16
	else
		common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
		top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
		printf 'worktree\0%s\0%s\0%s\0' "${CONTAINER_NAME:-}" "$common" "$top" |
			sha256sum | cut -c1-16
	fi
}

# Populate INSTANCE_DIR / PORT_FILE / DATADIR_FILE / PGDATA / PG_SOCKDIR for
# scoped mode. An explicit PGDATA still wins; the socket dir is always scoped so
# two clusters never share a /tmp socket file (clients connect over TCP anyway).
# `portmode` is up|read|none: on a read command (down/status/url) we resolve the
# data dir `up` recorded, so a `down` finds the SAME cluster `up` started even if
# that `up` used an explicit PGDATA that this call did not repeat.
resolve_scope() {
	local portmode="$1" key
	if ! key="$(scope_key)"; then
		log "scoped --worktree mode requires being inside a Git repository."
		log "Run it from a repo/worktree, or pass an explicit id: pg-dev-up --profile <id> <command>"
		exit 1
	fi
	INSTANCE_DIR="$SCOPED_ROOT/$key"
	PORT_FILE="$INSTANCE_DIR/port"
	DATADIR_FILE="$INSTANCE_DIR/datadir"
	# Only `up` may CREATE the instance dir; a read command (down/status/url)
	# must not materialize an empty instance for a scope that was never `up`ed
	# (it would leave a stray dir behind and mask "no instance yet" errors).
	# Owner-only from the top down: the temp root and the instance dir hold the
	# cluster's data + unix socket, which PostgreSQL requires be private.
	if [ "$portmode" = up ]; then
		(umask 077 && mkdir -p "$INSTANCE_DIR")
		chmod 700 "$SCOPED_ROOT" "$INSTANCE_DIR" 2>/dev/null || true
		# Snapshot the existing markers BEFORE port allocation or an override can
		# rewrite them, so cmd_up can restore them if this `up` fails (see
		# rollback_scoped_markers). $(cat) strips the trailing newline that
		# atomic_write adds; the rollback re-adds it, so the round-trip is exact.
		PRIOR_PORT_EXISTED=""
		PRIOR_PORT_CONTENT=""
		if [ -f "$PORT_FILE" ]; then
			PRIOR_PORT_EXISTED=yes
			PRIOR_PORT_CONTENT="$(cat "$PORT_FILE" 2>/dev/null || true)"
		fi
		PRIOR_DATADIR_EXISTED=""
		PRIOR_DATADIR_CONTENT=""
		if [ -f "$DATADIR_FILE" ]; then
			PRIOR_DATADIR_EXISTED=yes
			PRIOR_DATADIR_CONTENT="$(cat "$DATADIR_FILE" 2>/dev/null || true)"
		fi
	fi
	# Resolve PGDATA. An explicit PGDATA is authoritative. Scoped mode NEVER falls
	# back to the unscoped /tmp/pgdata default: on `up` it is the scoped default; on
	# a read command it MUST come from the marker `up` recorded — if that marker is
	# missing/empty, fail loudly rather than guess (which could otherwise let a
	# scoped `down`/`status` act on an unrelated cluster).
	if [ -z "$PGDATA_EXPLICIT" ]; then
		if [ "$portmode" = up ]; then
			PGDATA="$INSTANCE_DIR/pgdata"
		elif [ -s "$DATADIR_FILE" ]; then
			PGDATA="$(cat "$DATADIR_FILE")"
		else
			log "no scoped instance for this worktree/profile yet (run 'pg-dev-up ... up' first)."
			exit 1
		fi
	else
		# An explicit PGDATA must be made ABSOLUTE before we persist or resolve it:
		# `up` records this path so a later down/status (possibly from a DIFFERENT
		# working directory) can find the same cluster. A relative value recorded
		# verbatim would re-resolve against the other CWD and could target — and
		# stop — an unrelated cluster. Anchor a relative path to the current dir now
		# (realpath -m tolerates not-yet-created components); an already-absolute
		# path is left byte-for-byte so unscoped/default behavior is unchanged.
		case "$PGDATA" in
			/*) : ;;
			*) PGDATA="$(realpath -m -- "$PGDATA")" ;;
		esac
	fi
	PG_SOCKDIR="$INSTANCE_DIR"
}

# 0 if something is already accepting connections on 127.0.0.1:$1. The subshell
# owns fd 3, so it closes automatically when the subshell exits; the subshell's
# status IS the connect result.
port_listening() {
	(exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# The port a running cluster is ACTUALLY listening on (line 4 of postmaster.pid).
# Anchored to PGDATA, so it reports the real port even if $PGPORT was overridden
# to something else — keeping us from ever talking to a different server.
running_port() {
	local pid_file="$PGDATA/postmaster.pid"
	[ -s "$pid_file" ] || return 1
	sed -n '4p' "$pid_file" | tr -cd '0-9'
}

# 0 if a DIFFERENT scoped instance has recorded $1 as its port (even if its
# server is momentarily stopped) — so we never hand the same port to two of them.
port_reserved() {
	local pf p want="$1"
	for pf in "$SCOPED_ROOT"/*/port; do
		[ -f "$pf" ] || continue
		[ "$pf" = "$PORT_FILE" ] && continue
		p="$(cat "$pf" 2>/dev/null || true)"
		[ "$p" = "$want" ] && return 0
	done
	return 1
}

# Pick (or reuse) this scoped instance's port, serialized against other scoped
# instances by a lock on the shared root so two concurrent `up`s never race onto
# the same port. Sets PGPORT and records it in PORT_FILE.
allocate_port() {
	# A wide range so distinct scopes rarely exhaust it — a stopped instance keeps
	# its reservation (so a restart is deterministic), and the scoped root lives on
	# the ephemeral temp fs, so reservations are reclaimed on container recreate.
	local p start=5433 end=6432
	exec 9>"$SCOPED_ROOT/.portlock"
	if ! flock -w 30 9; then
		log "timed out waiting for the scoped port lock ($SCOPED_ROOT/.portlock)."
		exit 1
	fi
	if [ -s "$PORT_FILE" ]; then
		PGPORT="$(cat "$PORT_FILE")"
		flock -u 9
		return 0
	fi
	for ((p = start; p <= end; p++)); do
		port_reserved "$p" && continue
		port_listening "$p" && continue
		PGPORT="$p"
		atomic_write "$PORT_FILE" "$p"
		flock -u 9
		return 0
	done
	flock -u 9
	log "no free loopback port in ${start}-${end} for this scoped instance."
	exit 1
}

# `up` path: resolve the port to start on. Explicit PGPORT wins (used as-is);
# otherwise allocate/reuse under the lock. cmd_up records the EFFECTIVE port in
# PORT_FILE once it knows the real running port, so later url/status/down resolve
# it without re-passing the env var.
scoped_port_for_up() {
	if [ -z "$PGPORT_EXPLICIT" ]; then
		allocate_port
		return 0
	fi
	# Explicit PGPORT still goes through the shared reservation lock, so a
	# concurrent auto-allocating scoped `up` cannot race onto the same port: we
	# take the lock, refuse if ANOTHER scoped instance already reserved this port,
	# then record our reservation before releasing. (The auto-allocator skips any
	# port that appears in another instance's PORT_FILE.)
	exec 9>"$SCOPED_ROOT/.portlock"
	if ! flock -w 30 9; then
		log "timed out waiting for the scoped port lock ($SCOPED_ROOT/.portlock)."
		exit 1
	fi
	if port_reserved "$PGPORT"; then
		flock -u 9
		log "explicit PGPORT $PGPORT is already reserved by another scoped instance; refusing to collide (pick a different PGPORT)."
		exit 1
	fi
	atomic_write "$PORT_FILE" "$PGPORT"
	flock -u 9
}

# read path (url/status/down): resolve the port `up` already chose.
scoped_port_for_read() {
	if [ -n "$PGPORT_EXPLICIT" ]; then
		return 0
	fi
	if [ -s "$PORT_FILE" ]; then
		PGPORT="$(cat "$PORT_FILE")"
	else
		log "no scoped instance for this worktree/profile yet (run 'pg-dev-up ... up' first)."
		exit 1
	fi
}

# Resolve PGDATA / PGPORT / PG_SOCKDIR for the requested command. `portmode` is
# how this command needs the port: `up` allocates, `read` reads a recorded one,
# `none` (check/help) needs neither a port nor a scoped instance.
configure_paths() {
	local portmode="$1"
	if [ -n "$SCOPED" ] && [ "$portmode" != none ]; then
		resolve_scope "$portmode"
		if [ "$portmode" = up ]; then
			scoped_port_for_up
		else
			scoped_port_for_read
		fi
		# resolve_scope + the port helpers set PGDATA and PGPORT to fully scoped
		# values (or already exited on a missing marker). Return BEFORE the unscoped
		# defaults below so a scoped command can NEVER fall back to /tmp/pgdata:5432
		# and act on the unrelated unscoped cluster.
		return 0
	fi
	# Unscoped path (and scoped check/help, which touch no cluster): historical
	# /tmp defaults, byte-for-byte as before scoped mode existed.
	PGDATA="${PGDATA:-/tmp/pgdata}"
	PGPORT="${PGPORT:-5432}"
}

pg_running() {
	[ -f "$PGDATA/postmaster.pid" ] && "$BINDIR/pg_ctl" -D "$PGDATA" status >/dev/null 2>&1
}

psql_postgres() {
	"$BINDIR/psql" -h "$PG_HOST" -p "$PGPORT" -U postgres -d postgres -v ON_ERROR_STOP=1 "$@"
}

# Pass identifiers/literals as psql variables so psql does the SQL quoting
# (:'var' → quoted string literal, :"var" → quoted identifier), never splicing
# $POSTGRES_* straight into SQL where quotes could break it or inject. The SQL
# is fed on stdin, not via -c: psql only performs :var interpolation when
# reading from stdin/-f — a -c argument is sent to the server verbatim.
role_exists() { [ "$(printf '%s\n' "SELECT 1 FROM pg_roles WHERE rolname = :'rolname'" | psql_postgres -tA -v rolname="$1")" = "1" ]; }
db_exists() { [ "$(printf '%s\n' "SELECT 1 FROM pg_database WHERE datname = :'datname'" | psql_postgres -tA -v datname="$1")" = "1" ]; }

ensure_role_db() {
	if [ "$POSTGRES_USER" != "postgres" ] && ! role_exists "$POSTGRES_USER"; then
		log "Creating role $POSTGRES_USER…"
		printf '%s\n' "CREATE ROLE :\"rolname\" LOGIN SUPERUSER PASSWORD :'rolpass';" |
			psql_postgres -v rolname="$POSTGRES_USER" -v rolpass="$POSTGRES_PASSWORD" >/dev/null
	fi
	if ! db_exists "$POSTGRES_DB"; then
		log "Creating database $POSTGRES_DB (owner $POSTGRES_USER)…"
		"$BINDIR/createdb" -h "$PG_HOST" -p "$PGPORT" -U postgres -O "$POSTGRES_USER" "$POSTGRES_DB" >/dev/null
	fi
}

# Percent-encode a string for safe use as a URL component (RFC 3986: keep the
# unreserved set literal, %-encode everything else). LC_ALL=C makes the loop
# iterate byte-wise so multibyte chars encode correctly.
urlencode() {
	local LC_ALL=C s="$1" i c out=""
	for ((i = 0; i < ${#s}; i++)); do
		c="${s:i:1}"
		case "$c" in
			[A-Za-z0-9.~_-]) out+="$c" ;;
			*)
				printf -v c '%%%02X' "'$c"
				out+="$c"
				;;
		esac
	done
	printf '%s' "$out"
}

print_url() {
	# Percent-encode credentials so metacharacters (@ / # & : etc.) don't
	# corrupt the URL; the consumer percent-decodes per RFC 3986.
	local user pass db url
	user="$(urlencode "$POSTGRES_USER")"
	pass="$(urlencode "$POSTGRES_PASSWORD")"
	db="$(urlencode "$POSTGRES_DB")"
	# Use $PG_HOST (127.0.0.1), not "localhost": the server binds IPv4 only, so
	# a client that resolves localhost to ::1 first would fail to connect.
	url="postgresql://${user}:${pass}@${PG_HOST}:${PGPORT}/${db}"
	if [ "${1:-}" = "--export" ]; then
		# %q shell-escapes the value so `eval "$(pg-dev-up url --export)"` is safe.
		printf 'export DATABASE_URL=%q\n' "$url"
	else
		printf '%s\n' "$url"
	fi
}

# Restore the scoped port/datadir markers to their pre-`up` snapshot (captured in
# resolve_scope). Runs from cmd_up's EXIT trap when initialization or start fails,
# so a failed override leaves the previously-running scoped instance's markers
# intact instead of pointing a later down/status at a cluster that never started.
rollback_scoped_markers() {
	[ -n "$SCOPED" ] || return 0
	if [ "$PRIOR_PORT_EXISTED" = yes ]; then
		atomic_write "$PORT_FILE" "$PRIOR_PORT_CONTENT"
	else
		rm -f "$PORT_FILE"
	fi
	if [ "$PRIOR_DATADIR_EXISTED" = yes ]; then
		atomic_write "$DATADIR_FILE" "$PRIOR_DATADIR_CONTENT"
	else
		rm -f "$DATADIR_FILE"
	fi
}

cmd_up() {
	local actual
	require_bindir
	if [ -n "$SCOPED" ]; then
		# Serialize concurrent `up` for the SAME scope so two callers never race
		# through initdb / pg_ctl start against one data directory. Held (via fd 8)
		# until this process exits.
		exec 8>"$INSTANCE_DIR/.uplock"
		if ! flock -w 60 8; then
			log "timed out waiting for the scoped instance lock ($INSTANCE_DIR/.uplock)."
			exit 1
		fi
		# If initialization or start fails below, roll the markers back to the
		# snapshot captured before this `up`. The port reservation had to be written
		# early (see allocate_port) to fence concurrent allocators, but the recorded
		# data dir / port describing THIS cluster are (re)written only AFTER start
		# succeeds — so a failed override never orphans the previously-running scoped
		# instance or corrupts teardown resolution. Cleared once start succeeds.
		trap 'rollback_scoped_markers' EXIT
	fi
	if [ ! -s "$PGDATA/PG_VERSION" ]; then
		log "Initializing cluster at $PGDATA (trust auth, C locale, UTF8)…"
		mkdir -p "$PGDATA"
		"$BINDIR/initdb" -D "$PGDATA" -U postgres --auth=trust --locale=C --encoding=UTF8 >/dev/null
	fi
	if pg_running; then
		# In SCOPED mode only, talk to the port the cluster ACTUALLY listens on (not
		# a possibly-mismatched requested $PGPORT), so we never create roles/db on an
		# unrelated server that happens to sit on the requested port. Unscoped mode
		# keeps its historical behavior byte-for-byte (it just reports the requested
		# port), so existing callers see the same URL as before scoped mode existed.
		if [ -n "$SCOPED" ]; then
			actual="$(running_port || true)"
			if [ -n "$actual" ] && [ "$actual" != "$PGPORT" ]; then
				log "Cluster at $PGDATA is already running on port $actual (ignoring requested $PGPORT; run 'down' first to change it)."
				PGPORT="$actual"
			fi
		fi
		log "Already running on $PG_HOST:$PGPORT."
	else
		# Not our cluster running: in scoped mode, refuse to start onto a port
		# another process already holds (e.g. a stale recorded port now taken),
		# rather than colliding with an unrelated server. Unscoped keeps its
		# historical behavior (pg_ctl surfaces the bind failure).
		if [ -n "$SCOPED" ] && port_listening "$PGPORT"; then
			log "scoped port $PGPORT is already in use by another process; refusing to start (free it or set a different PGPORT)."
			exit 1
		fi
		log "Starting PostgreSQL on $PG_HOST:$PGPORT…"
		# Close the scoped lock fds (8 = instance uplock, 9 = port lock) for the
		# postmaster: it daemonizes and would otherwise inherit fd 8 and hold that
		# advisory flock for its whole lifetime, deadlocking the next `up`.
		"$BINDIR/pg_ctl" -D "$PGDATA" -l "$PGDATA/server.log" \
			-o "-p $PGPORT -h $PG_HOST -k $PG_SOCKDIR" -w start >/dev/null 8>&- 9>&-
	fi
	# Start (or an already-running detection) succeeded: NOW record the effective
	# data dir and port so url/status/down resolve the exact server this `up`
	# settled on, then drop the rollback trap — a later ensure_role_db failure must
	# not undo markers that correctly describe the now-running cluster.
	if [ -n "$SCOPED" ]; then
		atomic_write "$DATADIR_FILE" "$PGDATA"
		atomic_write "$PORT_FILE" "$PGPORT"
		trap - EXIT
	fi
	ensure_role_db
	# Recommend the SCOPE-CORRECT export recipe: an unscoped `url --export` would
	# export the /tmp:5432 cluster's URL, not this scoped instance's.
	local export_cmd="pg-dev-up url --export"
	if [ -n "$SCOPED" ]; then
		if [ "$SCOPE_MODE" = profile ]; then
			export_cmd="pg-dev-up --profile $SCOPE_PROFILE_ID url --export"
		else
			export_cmd="pg-dev-up --worktree url --export"
		fi
	fi
	log "Ready. DATABASE_URL printed below; export it with: eval \"\$($export_cmd)\""
	print_url
}

cmd_down() {
	require_bindir
	if pg_running; then
		"$BINDIR/pg_ctl" -D "$PGDATA" -m fast -w stop >/dev/null
		log "Stopped. Data kept at $PGDATA (run 'pg-dev-up' to restart)."
	else
		log "Not running."
	fi
}

cmd_status() {
	require_bindir
	if pg_running; then
		log "running on $PG_HOST:$PGPORT (PGDATA=$PGDATA)"
	else
		log "not running (PGDATA=$PGDATA)"
		return 1
	fi
}

cmd_check() {
	require_bindir
	"$BINDIR/initdb" --version
	"$BINDIR/postgres" --version
}

usage() { sed -n '2,54p' "$0" | sed 's/^#\{1\} \{0,1\}//; s/^#$//'; }

# Consume a leading scope flag (--worktree / --profile <id>) BEFORE the command;
# everything after the flag is the command and its own arguments (e.g. the
# `--export` that `url` takes), so we stop at the first non-scope token.
while [ $# -gt 0 ]; do
	case "$1" in
		--worktree)
			SCOPED=1
			SCOPE_MODE=worktree
			shift
			;;
		--profile)
			SCOPED=1
			SCOPE_MODE=profile
			shift
			[ $# -gt 0 ] || {
				log "--profile requires an identifier"
				exit 2
			}
			SCOPE_PROFILE_ID="$1"
			shift
			;;
		--profile=*)
			SCOPED=1
			SCOPE_MODE=profile
			SCOPE_PROFILE_ID="${1#--profile=}"
			shift
			;;
		--)
			shift
			break
			;;
		*) break ;;
	esac
done

if [ "$SCOPE_MODE" = profile ]; then
	case "$SCOPE_PROFILE_ID" in
		'') log "--profile requires a non-empty identifier"; exit 2 ;;
		*[!A-Za-z0-9._-]*) log "invalid --profile id (allowed: A-Za-z0-9._-)"; exit 2 ;;
	esac
fi

case "${1:-up}" in
	up | "")
		configure_paths up
		cmd_up
		;;
	down | stop)
		configure_paths read
		cmd_down
		;;
	status)
		configure_paths read
		cmd_status
		;;
	url)
		configure_paths read
		shift
		print_url "${1:-}"
		;;
	check)
		configure_paths none
		cmd_check
		;;
	help | -h | --help)
		usage
		;;
	*)
		log "unknown command '$1' (try: up, down, status, url, check, help)"
		exit 2
		;;
esac
