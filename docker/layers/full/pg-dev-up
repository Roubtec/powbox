#!/usr/bin/env bash
# pg-dev-up — stand up a throwaway local PostgreSQL for integration suites.
#
# powbox bakes the PostgreSQL 16 server binaries but deliberately does NOT
# auto-start a daemon (most containers never need one, and an always-on server
# would clash with a project's own docker-compose Postgres). This helper does
# the initdb + start + createdb dance on demand, as the unprivileged `node`
# user: the Debian `postgres` system user has no password set, so the usual
# `sudo -u postgres ...` path is a dead end here. Trust auth on a loopback-only
# socket is appropriate — the container itself is the security boundary.
#
# Usage:
#   pg-dev-up [up]      init (first run) + start, ensure role/db, print DATABASE_URL
#   pg-dev-up status    report whether the dev cluster is running (exit 1 if not),
#                       and whether it is durable and where its data lives
#   pg-dev-up url       print the DATABASE_URL of the role/db `up` set the cluster up with
#   pg-dev-up down      stop the dev cluster ($PGDATA is kept for a later restart)
#   pg-dev-up destroy   stop the cluster if it runs and delete it with its data, for
#                       good (only a cluster pg-dev-up created; see "Destroying")
#   pg-dev-up list      list every cluster this helper knows about, whose it is,
#                       whether it runs, and the command that removes it
#                       (`list --porcelain`: one tab-separated line per cluster)
#   pg-dev-up check     verify the server binaries are present (no daemon needed)
#   pg-dev-up help
#
# Scoped mode (opt-in) — isolate the cluster per Git worktree so parallel
# worktrees can run database tests concurrently without sharing one cluster,
# data directory, or port. The flag goes BEFORE the command and applies to
# up / status / url / down / destroy:
#   pg-dev-up --worktree [up|status|url|down|destroy]  scope to the current Git worktree
#   pg-dev-up --profile <id> [up|status|...]           scope to an explicit identifier
#   pg-dev-up --instance <key> [status|url|down|destroy]
#                       an existing scoped cluster by the key `list` shows, e.g.
#                       one whose worktree no longer exists (not for `up`)
# e.g.
#   pg-dev-up --worktree up
#   eval "$(pg-dev-up --worktree url --export)"
#   pg-dev-up --worktree down
# Scoped mode derives an isolated data directory under a private temp root and
# allocates its own free loopback port (recorded next to the data dir so later
# status/url/down resolve the SAME server that up started). `--worktree` requires
# being inside a Git repository; outside one, pass `--profile <id>` with a stable
# identifier rather than guessing. Two different worktrees (or profiles) receive
# distinct data dirs and ports and stop independently. Ordinary `pg-dev-up up`
# (no flag) keeps the UNSCOPED defaults: one cluster on port 5432 (data dir below).
#
# Durability and storage. A cluster is NON-DURABLE by default: it runs with
# fsync, synchronous_commit and full_page_writes off, so a test suite never waits
# on a flush to stable storage. Its data does not survive an unclean stop (a
# crash, a killed container); that is the trade for a throwaway test database,
# and a later `up` that cannot start such a leftover recreates it empty. Where
# the container offers RAM-backed storage (a tmpfs at /run/pg-dev-up, which the
# powbox launcher mounts with a size bound), a new non-durable cluster's data
# lives there, which also spares the SSD; it is lost when the container stops.
# Without that storage, or when it has too little room left, the cluster falls
# back to disk, still non-durable. Set POWBOX_PG_DURABLE=1 when CREATING a
# cluster to get a durable one on disk instead (full fsync, as before). The
# choice is recorded in the data directory (pg-dev-up.cluster) and kept for the
# cluster's life, so later commands need not repeat it; a cluster created before
# that record existed counts as durable. `status` reports which kind it is.
#
# Credentials. `up` records the role, password and database it set the cluster
# up with in that same record, so a later `url` or `status` describes the
# cluster whatever the calling shell holds; `up` without POSTGRES_* reuses the
# recorded values. The password is stored in plain text (percent-encoded, not
# encrypted): the cluster uses trust auth on loopback inside the container, and
# the data directory is owner-only. A POSTGRES_* value that disagrees with the
# record makes `url` refuse and `status` say so; `up` with the new value creates
# that role/database and records it. A cluster without a record (made before
# pg-dev-up kept one) remembers nothing, and `url` uses the environment.
#
# Destroying. `destroy` removes only a cluster pg-dev-up created and marked: a
# data directory holding a PostgreSQL cluster AND its pg-dev-up.cluster record
# (or an empty one at a location pg-dev-up itself chose), owned by the caller.
# Anything else (a directory that is not a cluster, a cluster from before the
# record existed, an explicit PGDATA naming such a directory) is refused and
# left untouched. A running cluster is stopped
# first. A scoped `destroy` also removes the scope's markers; with an explicit
# PGDATA it refuses unless that names the scope's own recorded data directory.
#
# Listing. `list` reads markers and records only: it takes no lock and creates
# nothing, so it never disturbs a concurrent `up`. It finds the unscoped cluster
# in its two default places, every scoped instance under the scoped root, and
# RAM-backed data no scoped instance records. An unscoped cluster made with an
# explicit PGDATA leaves no marker anywhere else, so `list` shows it only when
# PGDATA names it.
#
# Environment overrides (defaults in parentheses):
#   PGDATA            cluster data directory  (RAM: /run/pg-dev-up/<uid>/pgdata, else /tmp/pgdata;
#                                              scoped: /run/pg-dev-up/<uid>/<key>/pgdata, else <root>/<key>/pgdata)
#   PGPORT            listen port             (5432; scoped: an allocated free port)
#   POWBOX_PG_DURABLE 1 creates a durable cluster on disk (unset: non-durable)
#   POWBOX_PG_RAM_ROOT          RAM-backed storage root (/run/pg-dev-up; the default
#                               must be a tmpfs, an explicit value is trusted as RAM)
#   POWBOX_PG_RAM_MIN_FREE_MB   free room a new cluster needs there, else disk (256)
#   POSTGRES_USER     app role to ensure      (postgres)
#   POSTGRES_PASSWORD app role password       (postgres)
#   POSTGRES_DB       app database to ensure  (postgres)
# An explicit PGDATA or PGPORT is authoritative and REPLACES only that one scoped
# default (the other scoped defaults still apply); POSTGRES_USER/PASSWORD/DB
# behave the same scoped or not. Because an override is authoritative, a scoped `up`
# REFUSES (rather than silently adapting) when the scope already has a running
# cluster that a new explicit PGPORT conflicts with, or that a new PGDATA would
# orphan — stop it with the scoped `down` first. PGPORT must be a bare 1-65535
# integer. POWBOX_PG_SCOPED_ROOT overrides the scoped temp root (default
# ${TMPDIR:-/tmp}/pg-dev-up-scoped); it is used unquoted in the postmaster command,
# so it must contain only the characters A-Za-z0-9._/- (no spaces/metacharacters).
#
# To match a project's expected credentials, set the env vars before calling,
# e.g.  POSTGRES_USER=myapp POSTGRES_PASSWORD=myapp POSTGRES_DB=myapp pg-dev-up
#
# The emitted DATABASE_URL always ends in `?sslmode=disable`:
#   postgresql://<user>:<pass>@127.0.0.1:<port>/<db>?sslmode=disable
# The cluster is initdb'ed without SSL, and Go's lib/pq does NOT fall back to
# plaintext when the DSN omits sslmode — it fails with "SSL is not enabled on
# the server" — so a Go integration suite pointed at a bare URL breaks until
# someone appends the parameter by hand. Loopback-only + trust auth inside the
# container security boundary makes `disable` the honest description, not a
# weakening, and it is the one spelling every common client accepts: pgx and
# libpq/psql attempt TLS and fall back to plaintext, node-postgres (`pg` 8.x)
# attempts no TLS at all, but all of them honor an explicit `disable`. The URL
# already carries a query string, so append any extra parameter with `&`, not
# `?`.
#
# Export the connection string into your current shell with:
#   eval "$(pg-dev-up url --export)"
#   eval "$(pg-dev-up --worktree url --export)"   # scoped
set -euo pipefail

# Capture whether the caller set PGDATA/PGPORT EXPLICITLY (to a NON-empty value)
# before we apply any defaults, so scoped mode can honor an explicit override
# while still deriving every other scoped value. An empty value is meaningless
# and must NOT count as explicit — otherwise a stray `PGDATA=` in the environment
# would silently fall back to /tmp/pgdata and let a scoped `down` stop the
# unscoped cluster.
PGDATA_EXPLICIT=""
[ -n "${PGDATA:-}" ] && PGDATA_EXPLICIT="yes"
PGPORT_EXPLICIT=""
[ -n "${PGPORT:-}" ] && PGPORT_EXPLICIT="yes"

PG_HOST="127.0.0.1"
# Which credentials the caller gave (non-empty, as for PGDATA/PGPORT): only those
# can disagree with, or replace, the ones a cluster recorded.
POSTGRES_USER_EXPLICIT=""
[ -z "${POSTGRES_USER:-}" ] || POSTGRES_USER_EXPLICIT=yes
POSTGRES_PASSWORD_EXPLICIT=""
[ -z "${POSTGRES_PASSWORD:-}" ] || POSTGRES_PASSWORD_EXPLICIT=yes
POSTGRES_DB_EXPLICIT=""
[ -z "${POSTGRES_DB:-}" ] || POSTGRES_DB_EXPLICIT=yes
POSTGRES_USER="${POSTGRES_USER:-postgres}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
POSTGRES_DB="${POSTGRES_DB:-postgres}"
# The credentials the cluster's record holds (set by resolve_credentials).
REC_HAS_CREDS=""
REC_USER=""
REC_PASS=""
REC_DB=""
CRED_CONFLICT=""

# Scoped-mode state (populated by the flag parse + resolve_scope below).
SCOPED=""
SCOPE_MODE=""         # worktree | profile | instance
SCOPE_PROFILE_ID=""   # for --profile <id>
SCOPE_INSTANCE_KEY="" # for --instance <key>
# Canonicalize the scoped root to an ABSOLUTE path ONCE, up front. A relative
# POWBOX_PG_SCOPED_ROOT or TMPDIR would otherwise re-resolve against whatever the
# current directory happens to be, so two invocations (or a `cd` mid-run) could
# derive different instance/lock/marker paths for the same scope and silently
# split one cluster in two. realpath -m tolerates the root not existing yet;
# an already-absolute value is left byte-for-byte (unscoped behavior unchanged).
# Mirrors the explicit-PGDATA canonicalization in resolve_scope.
SCOPED_ROOT="${POWBOX_PG_SCOPED_ROOT:-${TMPDIR:-/tmp}/pg-dev-up-scoped}"
case "$SCOPED_ROOT" in
	/*) : ;;
	*) SCOPED_ROOT="$(realpath -m -- "$SCOPED_ROOT")" ;;
esac
INSTANCE_DIR=""
PORT_FILE=""
DATADIR_FILE=""
OWNER_FILE=""
SCOPE_KEY=""

# Durability: requested only when a cluster is CREATED; an existing cluster keeps
# the durability its pg-dev-up.cluster record names.
DURABLE_REQUESTED=""
case "${POWBOX_PG_DURABLE:-}" in
	'' | 0 | no | false | off) : ;;
	1 | yes | true | on) DURABLE_REQUESTED=yes ;;
	*)
		printf 'pg-dev-up: %s\n' "invalid POWBOX_PG_DURABLE '$POWBOX_PG_DURABLE' (use 1 for a durable cluster, or leave it unset)." >&2
		exit 2
		;;
esac

# RAM-backed storage. The default root is the tmpfs the launcher mounts
# (compose.shared.yml); it only counts as RAM when it really is a tmpfs, so an
# empty directory left in an image can never pass for one. An explicit
# POWBOX_PG_RAM_ROOT is the caller's assertion and is trusted as RAM. The
# root is world-writable (sticky) like /tmp, so each user keeps an owner-only
# subdirectory in it.
PG_RAM_ROOT_EXPLICIT=""
[ -n "${POWBOX_PG_RAM_ROOT:-}" ] && PG_RAM_ROOT_EXPLICIT="yes"
PG_RAM_ROOT="${POWBOX_PG_RAM_ROOT:-/run/pg-dev-up}"
case "$PG_RAM_ROOT" in
	/*) : ;;
	*) PG_RAM_ROOT="$(realpath -m -- "$PG_RAM_ROOT")" ;;
esac
PG_RAM_ROOT="${PG_RAM_ROOT%/}"
PG_RAM_BASE="$PG_RAM_ROOT/$(id -u)"
# 256 MB holds a fresh cluster (~40 MB) plus the WAL a non-durable cluster keeps
# (max_wal_size below) with room for test data; less than that and a suite would
# soon hit "No space left on device", so a new cluster goes to disk instead.
PG_RAM_MIN_FREE_MB="${POWBOX_PG_RAM_MIN_FREE_MB:-256}"
case "$PG_RAM_MIN_FREE_MB" in
	'' | *[!0-9]*)
		printf 'pg-dev-up: %s\n' "invalid POWBOX_PG_RAM_MIN_FREE_MB '$PG_RAM_MIN_FREE_MB': must be a whole number of megabytes." >&2
		exit 2
		;;
esac
RAM_UNAVAILABLE_REASON=""
UNSCOPED_DISK_PGDATA="/tmp/pgdata"
# The record a cluster keeps about itself, inside its own data directory (the
# server ignores unknown files there). Its presence also marks the directory as
# one pg-dev-up created, which is what lets `up` discard a non-durable leftover.
CLUSTER_RECORD="pg-dev-up.cluster"
# The data directory THIS invocation's initdb just created. Writing the record
# can still fail after initdb (a full RAM disk), leaving a cluster that reads as
# unrecorded, i.e. durable; this lets recovery discard it as the throwaway it is.
CREATED_DATADIR=""

# Snapshot of the scoped port/datadir markers as they were BEFORE this `up` began
# to touch them (captured by snapshot_scoped_markers, under the per-scope
# `.uplock`, in cmd_up). cmd_up rolls the markers back to this snapshot if
# initialization or start fails, so a failed override can never orphan the
# previously-running scoped instance or leave later down/status resolving a
# cluster that never came up. Taking the snapshot under the lock also means a
# concurrent same-scope `up` cannot roll back over the markers a successful holder
# just wrote — the loser snapshots (and can only restore) the winner's state.
PRIOR_PORT_EXISTED=""
PRIOR_PORT_CONTENT=""
PRIOR_DATADIR_EXISTED=""
PRIOR_DATADIR_CONTENT=""

# Set to "yes" the moment THIS `up` is about to run `pg_ctl start` (i.e. it may
# have brought a NEW postmaster live). The rollback trap reads it so a post-start
# failure — a start timeout that still leaves the postmaster running, or a marker
# write that fails after the server went live — stops that newly-started server
# BEFORE restoring the prior markers, instead of orphaning a live cluster that
# scoped status/down can no longer resolve. It stays empty when `up` only found an
# already-running cluster (it started nothing, so there is nothing to stop).
STARTED_NEW_SERVER=""

# These get their final values in configure_paths(), after the command and any
# scope flag are known: scoped mode replaces the data dir / socket dir / port,
# unscoped mode keeps port 5432 and the /tmp socket dir.
PGDATA="${PGDATA:-}"
PGPORT="${PGPORT:-}"
PG_SOCKDIR="/tmp"

log() { printf 'pg-dev-up: %s\n' "$*" >&2; }

# Validate a listen port is a BARE integer in the TCP range. $PGPORT is
# interpolated into the pg_ctl -o option string, which pg_ctl runs through a shell
# (system()), so a value with whitespace or shell/option metacharacters could
# inject extra postmaster options or a shell command; it also goes into the
# DATABASE_URL. Reject anything that is not 1-65535 (the length guard keeps the
# arithmetic comparison from overflowing on an absurdly long digit string).
validate_port() {
	local p="$1"
	case "$p" in
		'' | *[!0-9]*)
			log "invalid PGPORT '$p': must be a bare integer in 1-65535."
			exit 2
			;;
	esac
	if [ "${#p}" -gt 5 ] || [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
		log "invalid PGPORT '$p': out of range (1-65535)."
		exit 2
	fi
}

# Publish a scoped marker file ATOMICALLY: write to a sibling temp file, then
# rename it into place. A concurrent reader (a `down`/`status` in another
# worktree) therefore sees either the previous complete value or the new
# complete one — never an empty/partial file caught mid-write, which could
# otherwise resolve to the wrong (or the unscoped) cluster.
# -T (--no-target-directory) makes a DIRECTORY squatting at the marker path a
# hard failure: plain `mv -f` would "succeed" by moving the temp file INSIDE
# that directory, so cmd_up would believe the marker was recorded (and clear
# its rollback trap) while the marker path stays unreadable as a file — later
# status/down could then never resolve the running server. Failing here keeps
# the rollback trap armed, which stops the newly-started server instead of
# orphaning it.
atomic_write() {
	local dest="$1" content="$2" tmp
	tmp="$(mktemp "${dest}.XXXXXX")"
	printf '%s\n' "$content" >"$tmp"
	if ! mv -f -T "$tmp" "$dest"; then
		rm -f "$tmp"
		return 1
	fi
}

# Debian keeps the server binaries (initdb, pg_ctl, postgres) off PATH under
# /usr/lib/postgresql/<major>/bin; pick the highest installed major version.
find_bindir() {
	local d best=""
	for d in /usr/lib/postgresql/*/bin; do
		[ -x "$d/initdb" ] || continue
		if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "$best" "$d" | sort -V | tail -1)" = "$d" ]; then
			best="$d"
		fi
	done
	[ -n "$best" ] || return 1
	printf '%s\n' "$best"
}

BINDIR="$(find_bindir || true)"

require_bindir() {
	if [ -z "$BINDIR" ]; then
		log "PostgreSQL server binaries not found (expected /usr/lib/postgresql/*/bin)."
		exit 1
	fi
}

# --- durability + storage ---------------------------------------------------

# Free megabytes (for an unprivileged writer) on the filesystem holding $1.
fs_free_mb() {
	local avail bsize
	read -r avail bsize < <(stat -f -c '%a %S' -- "$1" 2>/dev/null) || return 1
	printf '%s\n' "$((avail * bsize / 1048576))"
}

# "<used> MB of <size> MB used" for the filesystem holding $1.
fs_usage_text() {
	local total avail bsize
	read -r total avail bsize < <(stat -f -c '%b %a %S' -- "$1" 2>/dev/null) || return 1
	printf '%s MB of %s MB used\n' "$(((total - avail) * bsize / 1048576))" "$((total * bsize / 1048576))"
}

on_ram_fs() {
	case "$(stat -f -c '%T' -- "$1" 2>/dev/null || true)" in
		tmpfs | ramfs) return 0 ;;
	esac
	return 1
}

# ram | disk: where the data directory $1 lives (or would live).
storage_of() {
	case "$1/" in
		"$PG_RAM_ROOT"/*)
			printf 'ram\n'
			return 0
			;;
	esac
	if on_ram_fs "$1"; then printf 'ram\n'; else printf 'disk\n'; fi
}

# 0 if a NEW cluster may be placed in RAM; otherwise RAM_UNAVAILABLE_REASON says
# why, so the disk fallback is never silent.
ram_usable() {
	local free
	RAM_UNAVAILABLE_REASON=""
	if [ ! -d "$PG_RAM_ROOT" ]; then
		RAM_UNAVAILABLE_REASON="this container has no RAM-backed storage at $PG_RAM_ROOT"
		return 1
	fi
	if [ -z "$PG_RAM_ROOT_EXPLICIT" ] && ! on_ram_fs "$PG_RAM_ROOT"; then
		RAM_UNAVAILABLE_REASON="$PG_RAM_ROOT is not a tmpfs"
		return 1
	fi
	if [ ! -w "$PG_RAM_ROOT" ] && [ ! -w "$PG_RAM_BASE" ]; then
		RAM_UNAVAILABLE_REASON="$PG_RAM_ROOT is not writable"
		return 1
	fi
	free="$(fs_free_mb "$PG_RAM_ROOT" || printf '0')"
	if [ "$free" -lt "$PG_RAM_MIN_FREE_MB" ]; then
		RAM_UNAVAILABLE_REASON="the RAM disk at $PG_RAM_ROOT has only $free MB free (a new cluster needs $PG_RAM_MIN_FREE_MB, POWBOX_PG_RAM_MIN_FREE_MB)"
		return 1
	fi
}

# The data directory pg-dev-up itself chooses for this cluster on storage $1
# (ram | disk): the "managed" locations, as opposed to an explicit PGDATA.
managed_datadir() {
	if [ -n "$SCOPED" ]; then
		if [ "$1" = ram ]; then printf '%s\n' "$PG_RAM_BASE/$SCOPE_KEY/pgdata"; else printf '%s\n' "$INSTANCE_DIR/pgdata"; fi
	else
		if [ "$1" = ram ]; then printf '%s\n' "$PG_RAM_BASE/pgdata"; else printf '%s\n' "$UNSCOPED_DISK_PGDATA"; fi
	fi
}

is_managed_datadir() {
	[ "$1" = "$(managed_datadir ram)" ] || [ "$1" = "$(managed_datadir disk)" ]
}

cluster_running_at() {
	[ -f "$1/postmaster.pid" ] && "$BINDIR/pg_ctl" -D "$1" status >/dev/null 2>&1
}

# Set PGDATA to the managed location a NEW cluster gets: disk when durability
# was requested, else RAM when usable, else disk. `quiet` suppresses the
# fallback notice for read commands, which only report where a cluster would go.
choose_fresh_datadir() {
	if [ -n "$DURABLE_REQUESTED" ]; then
		PGDATA="$(managed_datadir disk)"
	elif ram_usable; then
		PGDATA="$(managed_datadir ram)"
	else
		PGDATA="$(managed_datadir disk)"
		[ "${1:-}" = quiet ] || log "No RAM-backed storage for this cluster ($RAM_UNAVAILABLE_REASON); its data goes on disk, still non-durable."
	fi
}

# Resolve the data directory when no PGDATA was given and no scoped record
# applies: a running managed cluster first, then an existing one (disk first, so
# a durable cluster is always found again), else where a new one would go.
# Unscoped, a default location a scope recorded as its explicit PGDATA is that
# scope's, so it is passed over here (configure_paths refuses it if the fresh
# choice lands there).
resolve_managed_datadir() {
	local d
	for d in "$(managed_datadir disk)" "$(managed_datadir ram)"; do
		if cluster_running_at "$d" && ! foreign_scope_datadir "$d"; then
			PGDATA="$d"
			return 0
		fi
	done
	for d in "$(managed_datadir disk)" "$(managed_datadir ram)"; do
		if [ -s "$d/PG_VERSION" ] && ! foreign_scope_datadir "$d"; then
			PGDATA="$d"
			return 0
		fi
	done
	choose_fresh_datadir "${1:-}"
}

# 0 if this is an unscoped run and $1 is a scoped instance's data directory.
# A scoped run's own managed locations are its own, never foreign.
foreign_scope_datadir() {
	[ -z "$SCOPED" ] && scoped_key_of_datadir "$1" >/dev/null
}

# Create the owner-only parents of a managed RAM data directory. The root is a
# shared sticky tmpfs, so the per-user base must be ours and private.
prepare_datadir_parent() {
	case "$PGDATA/" in
		"$PG_RAM_BASE"/*)
			(umask 077 && mkdir -p "$(dirname "$PGDATA")") || return 1
			enforce_owner_only "$PG_RAM_BASE"
			# Only when the data lies there: a scope's explicit PGDATA elsewhere
			# under the base (such as the unscoped default) makes no scope dir.
			case "$PGDATA/" in
				"$PG_RAM_BASE/$SCOPE_KEY"/*) [ -z "$SCOPED" ] || enforce_owner_only "$PG_RAM_BASE/$SCOPE_KEY" ;;
			esac
			;;
	esac
}

# kv_get <file> <key>: the value of the first `<key>=` line, or status 1 when the
# file or the key is missing. Records and markers are `key=value` lines.
kv_get() {
	local line
	[ -f "$1" ] || return 1
	line="$(grep -m 1 -e "^$2=" -- "$1" 2>/dev/null)" || return 1
	printf '%s\n' "${line#*=}"
}

# kv_get_decoded <var> <file> <key>: kv_get, percent-decoded into <var>.
# Free-form values (credentials, paths) are stored percent-encoded so that one
# value is always one line.
kv_get_decoded() {
	local raw
	raw="$(kv_get "$2" "$3")" || return 1
	printf -v "$1" '%b' "${raw//%/\\x}"
}

cluster_record_value() { kv_get "$1/$CLUSTER_RECORD" "$2"; }

# durable | nondurable. A cluster without a record predates it and ran with
# full durability, so it stays durable.
cluster_durability() {
	if [ "$(cluster_record_value "$1" durability || true)" = nondurable ]; then
		printf 'nondurable\n'
	else
		printf 'durable\n'
	fi
}

# The record's text: <durability> <created> [<user> <password> <database>].
# Format 2 added the credentials; a format-1 record (task 088) has none.
cluster_record_text() {
	printf 'format=2\ndurability=%s\ncreated=%s\n' "$1" "$2" || return 1
	[ $# -ge 5 ] || return 0
	printf 'user=%s\npassword=%s\ndatabase=%s\n' "$(urlencode "$3")" "$(urlencode "$4")" "$(urlencode "$5")"
}

write_cluster_record() {
	local durability=nondurable
	[ -z "$DURABLE_REQUESTED" ] || durability=durable
	cluster_record_text "$durability" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$1/$CLUSTER_RECORD"
}

# Load the credentials $1's record holds into REC_*; REC_HAS_CREDS says whether
# it holds any (a format-1 record, or none at all, does not).
load_recorded_credentials() {
	REC_HAS_CREDS=""
	REC_USER=""
	REC_PASS=""
	REC_DB=""
	kv_get_decoded REC_USER "$1/$CLUSTER_RECORD" user || return 0
	kv_get_decoded REC_PASS "$1/$CLUSTER_RECORD" password || return 0
	kv_get_decoded REC_DB "$1/$CLUSTER_RECORD" database || return 0
	[ -n "$REC_USER" ] && [ -n "$REC_DB" ] || return 0
	REC_HAS_CREDS=yes
}

# Settle POSTGRES_USER/PASSWORD/DB for $PGDATA. Where the cluster recorded
# credentials, a value the caller did not give comes from the record. On `up` a
# given value replaces the recorded one (cmd_up records the new set); on a read
# command the record wins and CRED_CONFLICT lists every given value that
# disagrees, for `url` to refuse on and `status` to report.
resolve_credentials() {
	local mode="$1"
	CRED_CONFLICT=""
	load_recorded_credentials "$PGDATA"
	[ -n "$REC_HAS_CREDS" ] || return 0
	if [ -z "$POSTGRES_USER_EXPLICIT" ] || [ "$mode" != up ]; then
		[ -z "$POSTGRES_USER_EXPLICIT" ] || [ "$POSTGRES_USER" = "$REC_USER" ] ||
			CRED_CONFLICT+="${CRED_CONFLICT:+; }POSTGRES_USER=$POSTGRES_USER, but the cluster's role is $REC_USER"
		POSTGRES_USER="$REC_USER"
	fi
	if [ -z "$POSTGRES_PASSWORD_EXPLICIT" ] || [ "$mode" != up ]; then
		[ -z "$POSTGRES_PASSWORD_EXPLICIT" ] || [ "$POSTGRES_PASSWORD" = "$REC_PASS" ] ||
			CRED_CONFLICT+="${CRED_CONFLICT:+; }POSTGRES_PASSWORD differs from the recorded password"
		POSTGRES_PASSWORD="$REC_PASS"
	fi
	if [ -z "$POSTGRES_DB_EXPLICIT" ] || [ "$mode" != up ]; then
		[ -z "$POSTGRES_DB_EXPLICIT" ] || [ "$POSTGRES_DB" = "$REC_DB" ] ||
			CRED_CONFLICT+="${CRED_CONFLICT:+; }POSTGRES_DB=$POSTGRES_DB, but the cluster's database is $REC_DB"
		POSTGRES_DB="$REC_DB"
	fi
}

credential_conflict_text() {
	printf '%s\n' "your environment disagrees with the credentials 'up' recorded for the cluster at $PGDATA ($CRED_CONFLICT). Unset those POSTGRES_* variables to use the recorded ones, or run 'up' with them to add that role/database to the cluster and record it."
}

# After `up` ensured the role and database: record them in the cluster's record,
# rewritten atomically. Only a cluster pg-dev-up created has a record; one
# without (made before the record existed, or by something else) gets none, so
# the record stays the proof that pg-dev-up created the directory.
record_credentials() {
	local text had="$REC_HAS_CREDS" was_user="$REC_USER" was_pass="$REC_PASS" was_db="$REC_DB" was=""
	if [ ! -f "$PGDATA/$CLUSTER_RECORD" ]; then
		log "The cluster at $PGDATA has no pg-dev-up record (it predates one), so its credentials are not remembered: a later 'url' or 'status' uses your environment's POSTGRES_* values."
		return 0
	fi
	# Compare with the record as it is NOW: recovery may have replaced the
	# cluster resolve_credentials read with a fresh one that records nothing.
	load_recorded_credentials "$PGDATA"
	if [ -n "$REC_HAS_CREDS" ] && [ "$REC_USER" = "$POSTGRES_USER" ] &&
		[ "$REC_PASS" = "$POSTGRES_PASSWORD" ] && [ "$REC_DB" = "$POSTGRES_DB" ]; then
		return 0
	fi
	if ! text="$(cluster_record_text "$(cluster_durability "$PGDATA")" "$(cluster_record_value "$PGDATA" created || true)" \
		"$POSTGRES_USER" "$POSTGRES_PASSWORD" "$POSTGRES_DB")" ||
		! atomic_write "$PGDATA/$CLUSTER_RECORD" "$text"; then
		log "warning: could not record the credentials in $PGDATA/$CLUSTER_RECORD; a later 'url' or 'status' may describe other ones."
		return 0
	fi
	[ -n "$had" ] || return 0
	[ "$was_user" = "$POSTGRES_USER" ] || was+="${was:+, }role $was_user"
	[ "$was_db" = "$POSTGRES_DB" ] || was+="${was:+, }database $was_db"
	[ "$was_pass" = "$POSTGRES_PASSWORD" ] || was+="${was:+, }the previous password"
	[ -z "$was" ] ||
		log "Recorded new credentials for this cluster: role $POSTGRES_USER, database $POSTGRES_DB (replacing $was)."
}

# Postmaster options. A non-durable cluster skips every flush to stable storage
# (fsync, synchronous_commit) and full-page images in WAL, and keeps its WAL
# small: with fsync off a checkpoint costs no flush, and a small max_wal_size
# bounds how much RAM a cluster's WAL holds on a tmpfs (the default is 1 GB).
server_options() {
	local opts="-p $PGPORT -h $PG_HOST -k $PG_SOCKDIR"
	if [ "$(cluster_durability "$PGDATA")" = nondurable ]; then
		opts+=" -c fsync=off -c synchronous_commit=off -c full_page_writes=off -c max_wal_size=256MB -c min_wal_size=32MB"
	fi
	printf '%s\n' "$opts"
}

# Initialize $PGDATA if it holds no cluster yet, then start it. Every step's
# failure is returned, not fatal, so cmd_up can recover a throwaway cluster.
init_and_start() {
	if [ ! -s "$PGDATA/PG_VERSION" ]; then
		prepare_datadir_parent || return 1
		if [ -n "$DURABLE_REQUESTED" ]; then
			log "Initializing durable cluster at $PGDATA (trust auth, C locale, UTF8)…"
		else
			local where="on disk"
			[ "$(storage_of "$PGDATA")" != ram ] || where="in RAM"
			log "Initializing non-durable cluster $where at $PGDATA (trust auth, C locale, UTF8)…"
		fi
		mkdir -p "$PGDATA" || return 1
		"$BINDIR/initdb" -D "$PGDATA" -U postgres --auth=trust --locale=C --encoding=UTF8 >/dev/null || return 1
		CREATED_DATADIR="$PGDATA"
		write_cluster_record "$PGDATA" || return 1
	fi
	# Validate the effective port immediately before it is interpolated into the
	# pg_ctl -o option string (pg_ctl runs -o through a shell). Covers an explicit
	# PGPORT, an auto-allocated one, and a value reused from a recorded marker.
	validate_port "$PGPORT"
	log "Starting PostgreSQL on $PG_HOST:$PGPORT…"
	# Mark that we are about to bring a NEW postmaster live, BEFORE running
	# pg_ctl. `pg_ctl -w start` can return non-zero on a startup TIMEOUT while
	# the postmaster keeps coming up in the background — so the rollback trap
	# must treat a failed start as possibly-live and stop it. Setting this only
	# in scoped mode keeps unscoped behavior byte-for-byte (no rollback there).
	[ -z "$SCOPED" ] || STARTED_NEW_SERVER=yes
	# Close the scoped lock fds (8 = instance uplock, 9 = port lock) for the
	# postmaster: it daemonizes and would otherwise inherit fd 8 and hold that
	# advisory flock for its whole lifetime, deadlocking the next `up`.
	"$BINDIR/pg_ctl" -D "$PGDATA" -l "$PGDATA/server.log" \
		-o "$(server_options)" -w start >/dev/null 8>&- 9>&-
}

# When $1 sits in RAM and the RAM disk is (nearly) full, or its server log shows
# a write that failed for lack of room, say so plainly: the suite then sees
# "No space left on device" / "could not extend file", which is not a test bug.
ram_full_hint() {
	local free tail_text=""
	[ "$(storage_of "$1")" = ram ] || return 0
	[ -d "$PG_RAM_ROOT" ] || return 0
	free="$(fs_free_mb "$PG_RAM_ROOT" || printf '0')"
	[ ! -f "$1/server.log" ] || tail_text="$(tail -n 50 "$1/server.log" 2>/dev/null || true)"
	local remedy="Free room by stopping and deleting clusters you no longer need under $PG_RAM_BASE, relaunch the container with a larger POWBOX_PG_RAM_SIZE, or create the cluster on disk (an explicit PGDATA on disk, or POWBOX_PG_DURABLE=1)."
	if [ "$free" -lt 16 ]; then
		log "THE RAM DISK IS FULL: $PG_RAM_ROOT ($(fs_usage_text "$PG_RAM_ROOT" || printf 'usage unknown')). Database writes fail with 'No space left on device' — that is storage, not a test failure. $remedy"
	elif [[ $tail_text == *"No space left on device"* ]]; then
		# The log keeps the line after room is freed, so this is past tense.
		log "THE RAM DISK WAS FULL: $1/server.log shows a write that failed with 'No space left on device' — that is storage, not a test failure. $PG_RAM_ROOT now has $free MB free ($(fs_usage_text "$PG_RAM_ROOT" || printf 'usage unknown')). If it fills again: $remedy"
	fi
}

# Remove the data directory of a stopped cluster that could not be started, but
# only one pg-dev-up created as non-durable (its record says so) or that this
# invocation's initdb just created, or one a failed initdb left empty. Anything
# else is refused, so this can never delete a durable cluster that held data
# or a directory pg-dev-up did not make.
discard_cluster_dir() {
	local d="${1:?}"
	if [ -O "$d" ] && { [ "$d" = "$CREATED_DATADIR" ] ||
		{ [ -s "$d/PG_VERSION" ] && [ "$(cluster_durability "$d")" = nondurable ]; }; }; then
		rm -rf -- "$d"
	elif [ -d "$d" ]; then
		rmdir -- "$d" 2>/dev/null
	fi
}

# `up` could not initialize or start $PGDATA. A non-durable cluster held only
# throwaway data and an unclean stop may have left it unstartable, so recreate
# it empty rather than fail confusingly; a durable one is never discarded unless
# this same `up` had just initialized it, so it never held data. A
# managed cluster that failed in RAM is recreated on disk, the RAM disk being
# the likeliest culprit; an explicit PGDATA is recreated where it is.
recover_unstartable_cluster() {
	local failed="$PGDATA" failed_storage
	failed_storage="$(storage_of "$failed")"
	ram_full_hint "$failed"
	if cluster_running_at "$failed"; then
		log "pg_ctl stopped waiting for the cluster at $failed to start; see $failed/server.log."
		exit 1
	fi
	if port_listening "$PGPORT"; then
		log "port $PGPORT is already in use by another process; the cluster at $failed was left as it is (free the port or set a different PGPORT)."
		exit 1
	fi
	if [ "$failed" = "$CREATED_DATADIR" ]; then
		log "The cluster this 'up' just created at $failed could not be recorded or started (see above); recreating it."
	elif [ -s "$failed/PG_VERSION" ] && [ "$(cluster_durability "$failed")" != nondurable ]; then
		log "could not start the durable cluster at $failed; see $failed/server.log. pg-dev-up never discards a durable cluster."
		exit 1
	elif [ -s "$failed/PG_VERSION" ]; then
		log "Could not start the non-durable cluster at $failed (see its server.log); its data was throwaway, so recreating it empty."
	elif [ -n "$(ls -A -- "$failed" 2>/dev/null)" ]; then
		log "$failed is not empty and holds no PostgreSQL cluster, so it is not one pg-dev-up created; it was left alone. Point PGDATA at an empty or new directory."
		exit 1
	fi
	if ! discard_cluster_dir "$failed"; then
		log "could not clear $failed to recreate the cluster; remove it and run 'up' again."
		exit 1
	fi
	if [ -z "$PGDATA_EXPLICIT" ] && is_managed_datadir "$failed"; then
		if [ "$failed_storage" = ram ]; then
			PGDATA="$(managed_datadir disk)"
			log "Retrying on disk, still non-durable."
		else
			choose_fresh_datadir
		fi
	fi
	if ! init_and_start; then
		ram_full_hint "$PGDATA"
		if [ -f "$PGDATA/server.log" ]; then
			log "could not start a fresh cluster at $PGDATA either; see $PGDATA/server.log."
		else
			log "could not create a fresh cluster at $PGDATA either; see the error above."
		fi
		exit 1
	fi
}

# A durability request must never be silently ignored: refuse to bring up an
# existing non-durable cluster as if it were the durable one asked for.
refuse_durability_mismatch() {
	[ -n "$DURABLE_REQUESTED" ] || return 0
	[ -s "$PGDATA/PG_VERSION" ] || return 0
	[ "$(cluster_durability "$PGDATA")" = nondurable ] || return 0
	log "POWBOX_PG_DURABLE=1 asks for a durable cluster, but the cluster at $PGDATA was created non-durable, and durability is fixed when a cluster is created. Stop it ('down'), delete $PGDATA, then run 'up' again with POWBOX_PG_DURABLE=1 (or give it another PGDATA)."
	exit 1
}

# One line on what kind of cluster $PGDATA is, for status and up.
describe_cluster() {
	local storage text
	if [ ! -s "$PGDATA/PG_VERSION" ]; then
		if [ -n "$SCOPED" ] && [ -s "$DATADIR_FILE" ] && [ "$(storage_of "$PGDATA")" = ram ]; then
			log "its data directory is gone (RAM-backed data does not survive a container restart); the next 'up' creates a fresh cluster."
		elif [ -n "$SCOPED" ] && [ -s "$DATADIR_FILE" ]; then
			log "its data directory is gone; the next 'up' creates a fresh cluster."
		else
			log "no cluster has been created at $PGDATA yet."
		fi
		return 0
	fi
	storage="$(storage_of "$PGDATA")"
	if [ "$(cluster_durability "$PGDATA")" = nondurable ]; then
		text="non-durable (fsync off; lost on an unclean stop)"
	elif [ -f "$PGDATA/$CLUSTER_RECORD" ]; then
		text="durable"
	else
		text="durable (created before pg-dev-up recorded durability)"
	fi
	if [ "$storage" = ram ]; then
		text+=", data in RAM at $PGDATA (lost when the container stops; $PG_RAM_ROOT: $(fs_usage_text "$PG_RAM_ROOT" || printf 'usage unknown'))"
	else
		text+=", data on disk at $PGDATA"
	fi
	log "cluster: $text"
}

# --- scoped-mode identity + port bookkeeping -------------------------------
#
# The scoped instance KEY is a hash — not a human-readable slug — of the Powbox
# container identity, the repository's common Git dir, and the current worktree
# toplevel (or, for --profile, the explicit id). A basename alone can collide
# across repositories; hashing the common Git dir + toplevel makes two worktrees
# of one repo, and same-named worktrees of different repos, land in distinct
# instances. Truncated SHA-256 is plenty for a per-container temp namespace.
scope_key() {
	local common top
	# NUL-separate the fields so no field value can bleed into the next: a path or
	# id containing the separator can't forge a different tuple that hashes the
	# same. NUL can appear in neither a filesystem path nor an env value, so it is
	# an unambiguous frame. Pipe straight into sha256sum — never store NULs in a
	# shell variable (bash command substitution would strip them).
	if [ "$SCOPE_MODE" = instance ]; then
		printf '%s\n' "$SCOPE_INSTANCE_KEY"
	elif [ "$SCOPE_MODE" = profile ]; then
		printf 'profile\0%s\0%s\0' "${CONTAINER_NAME:-}" "$SCOPE_PROFILE_ID" |
			sha256sum | cut -c1-16
	else
		common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
		top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
		printf 'worktree\0%s\0%s\0%s\0' "${CONTAINER_NAME:-}" "$common" "$top" |
			sha256sum | cut -c1-16
	fi
}

# Reject a scoped root containing whitespace or shell/option metacharacters. The
# scoped socket dir ($SCOPED_ROOT/<key>, used as $PG_SOCKDIR) is interpolated
# UNQUOTED into the pg_ctl -o option string, which pg_ctl executes via a shell
# (system()): a space would re-split it into extra postmaster options and a
# metacharacter could inject a shell command. The default root and any sane
# POWBOX_PG_SCOPED_ROOT are plain paths, so constrain it to a conservative safe set.
validate_scoped_root() {
	case "$SCOPED_ROOT" in
		*[!A-Za-z0-9._/-]*)
			log "invalid POWBOX_PG_SCOPED_ROOT '$SCOPED_ROOT': only A-Za-z0-9 . _ / - are allowed (it is interpolated unquoted into the postmaster command)."
			exit 2
			;;
	esac
}

# READ-side defense-in-depth (see resolve_scope): every existing path given must be
# owned by the caller and carry no group/other permission bits, else refuse. This
# blocks a DIFFERENT user's planted or widened scoped marker/dir from steering a
# scoped down/status at an unrelated (but same-container) cluster. Same-UID forgery
# is out of scope: it requires write access inside the 0700 node-owned root, i.e.
# code already executing as this user, which can do anything regardless. Non-existent
# paths are skipped (a not-yet-created marker is handled by the caller's "no scoped
# instance" path). Mirrors the up-side enforce_owner_only hard-fail.
validate_scoped_owner() {
	local path owner perms me
	me="$(id -u)"
	for path in "$@"; do
		[ -e "$path" ] || continue
		owner="$(stat -c '%u' "$path" 2>/dev/null || true)"
		if [ "$owner" != "$me" ]; then
			log "refusing scoped operation: $path is owned by uid ${owner:-?}, not the current user (uid $me); a foreign-owned scoped marker/dir must not drive teardown."
			exit 1
		fi
		perms="$(stat -c '%a' "$path" 2>/dev/null || true)"
		case "$perms" in
			*00) : ;;
			*)
				log "refusing scoped operation: $path is not owner-only (perms=$perms); a group/world-accessible scoped marker/dir must not drive teardown."
				exit 1
				;;
		esac
	done
}

# Force each given directory to owner-only (0700) and VERIFY it stuck, FAILING
# hard otherwise. PostgreSQL refuses to run with a group/world-accessible data or
# socket dir, and — more importantly — a pre-existing scoped dir with wider perms
# (or one owned by another user we cannot chmod) would expose the cluster's data
# and unix socket. We must never let the server start on such a directory, so a
# chmod failure or lingering group/other bits are a clear error, not a warning.
enforce_owner_only() {
	local d perms
	for d in "$@"; do
		if ! chmod 700 "$d" 2>/dev/null; then
			log "cannot secure scoped directory $d (chmod 700 failed — not owner?); refusing to proceed with group/world-accessible cluster data."
			exit 1
		fi
		perms="$(stat -c '%a' "$d" 2>/dev/null || true)"
		# Any non-zero group/other bit (the last two octal digits) is a leak.
		case "$perms" in
			*00) : ;;
			*)
				log "scoped directory $d is not owner-only (perms=$perms); refusing to proceed."
				exit 1
				;;
		esac
	done
}

# Snapshot the current scoped port/datadir markers so cmd_up can restore them if
# this `up` fails (see rollback_scoped_markers). MUST run while holding the
# per-scope `.uplock` and BEFORE port allocation or an override rewrites them, so
# a concurrent same-scope `up` that loses the lock snapshots the WINNER's markers
# (and thus can only ever restore them) instead of an empty/stale pre-winner
# state. $(cat) strips the trailing newline atomic_write adds; the rollback
# re-adds it, so the round-trip is exact.
snapshot_scoped_markers() {
	PRIOR_PORT_EXISTED=""
	PRIOR_PORT_CONTENT=""
	if [ -f "$PORT_FILE" ]; then
		PRIOR_PORT_EXISTED=yes
		PRIOR_PORT_CONTENT="$(cat "$PORT_FILE" 2>/dev/null || true)"
	fi
	PRIOR_DATADIR_EXISTED=""
	PRIOR_DATADIR_CONTENT=""
	if [ -f "$DATADIR_FILE" ]; then
		PRIOR_DATADIR_EXISTED=yes
		PRIOR_DATADIR_CONTENT="$(cat "$DATADIR_FILE" 2>/dev/null || true)"
	fi
}

# Populate INSTANCE_DIR / PORT_FILE / DATADIR_FILE / PGDATA / PG_SOCKDIR for
# scoped mode. An explicit PGDATA still wins; the socket dir is always scoped so
# two clusters never share a /tmp socket file (clients connect over TCP anyway).
# `portmode` is up|read|stop|destroy|none: on a read command (down/status/url —
# `stop` is `read` minus the port requirement) we resolve the data dir `up`
# recorded, so a `down` finds the SAME cluster `up` started even if that `up`
# used an explicit PGDATA that this call did not repeat. `destroy` is `stop`
# that also tolerates a missing data dir marker (cmd_destroy looks for the data
# itself, and a scope with nothing left is nothing to destroy).
resolve_scope() {
	local portmode="$1" key
	# The scoped root becomes the socket dir interpolated (unquoted) into the pg_ctl
	# -o option string, which pg_ctl runs through a shell; reject a root with
	# whitespace or shell/option metacharacters before we build any path from it.
	validate_scoped_root
	if ! key="$(scope_key)"; then
		log "scoped --worktree mode requires being inside a Git repository."
		log "Run it from a repo/worktree, or pass an explicit id: pg-dev-up --profile <id> <command>"
		exit 1
	fi
	SCOPE_KEY="$key"
	INSTANCE_DIR="$SCOPED_ROOT/$key"
	PORT_FILE="$INSTANCE_DIR/port"
	DATADIR_FILE="$INSTANCE_DIR/datadir"
	OWNER_FILE="$INSTANCE_DIR/owner"
	# Only `up` may CREATE the instance dir; a read command (down/status/url)
	# must not materialize an empty instance for a scope that was never `up`ed
	# (it would leave a stray dir behind and mask "no instance yet" errors).
	if [ "$portmode" = up ]; then
		(umask 077 && mkdir -p "$INSTANCE_DIR")
		# The temp root and the instance dir hold the cluster's data + unix socket,
		# which PostgreSQL requires be private. Enforce owner-only perms and FAIL if
		# they cannot be locked down, rather than serving from a group/world-readable
		# directory (a pre-existing wide-open or foreign-owned dir must not slip
		# through). The markers are snapshotted later, under the `.uplock` in cmd_up,
		# so a failing concurrent same-scope `up` cannot roll back over the markers a
		# successful holder just wrote.
		enforce_owner_only "$SCOPED_ROOT" "$INSTANCE_DIR"
	else
		# READ path (down/status/url): we are about to TRUST a recorded marker to
		# point down/status at a data dir. Before doing so, confirm the scoped root,
		# this scope's instance dir, and the marker files are owned by the caller and
		# owner-only — a marker planted or widened by a DIFFERENT user could otherwise
		# redirect scoped teardown at an unrelated (same-container) cluster. Same-UID
		# forgery stays out of scope (it needs write access inside the 0700 node-owned
		# root, i.e. code already running as this user).
		validate_scoped_owner "$SCOPED_ROOT" "$INSTANCE_DIR" "$PORT_FILE" "$DATADIR_FILE"
	fi
	# Resolve PGDATA. An explicit PGDATA is authoritative. Scoped mode NEVER falls
	# back to the unscoped /tmp/pgdata default: on `up` it starts from the scoped
	# default (cmd_up then adopts the data dir this scope RECORDED, if any, under
	# the uplock — see the resume block there); on a read command it MUST come from
	# the marker `up` recorded — if that marker is missing/empty, fail loudly
	# rather than guess (which could otherwise let a scoped `down`/`status` act on
	# an unrelated cluster).
	if [ -z "$PGDATA_EXPLICIT" ]; then
		if [ "$portmode" = up ]; then
			PGDATA="$INSTANCE_DIR/pgdata"
		elif [ -s "$DATADIR_FILE" ]; then
			PGDATA="$(cat "$DATADIR_FILE")"
		elif [ "$portmode" = destroy ]; then
			PGDATA=""
		else
			log "no scoped instance for this worktree/profile yet (run 'pg-dev-up ... up' first)."
			exit 1
		fi
	else
		# An explicit PGDATA must be made ABSOLUTE before we persist or resolve it:
		# `up` records this path so a later down/status (possibly from a DIFFERENT
		# working directory) can find the same cluster. A relative value recorded
		# verbatim would re-resolve against the other CWD and could target — and
		# stop — an unrelated cluster. Anchor a relative path to the current dir now
		# (realpath -m tolerates not-yet-created components); an already-absolute
		# path is left byte-for-byte so unscoped/default behavior is unchanged.
		case "$PGDATA" in
			/*) : ;;
			*) PGDATA="$(realpath -m -- "$PGDATA")" ;;
		esac
	fi
	PG_SOCKDIR="$INSTANCE_DIR"
}

# 0 if something is already accepting connections on 127.0.0.1:$1. The subshell
# owns fd 3, so it closes automatically when the subshell exits; the subshell's
# status IS the connect result.
port_listening() {
	(exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# The port a running cluster is ACTUALLY listening on (line 4 of postmaster.pid).
# Anchored to PGDATA, so it reports the real port even if $PGPORT was overridden
# to something else — keeping us from ever talking to a different server.
running_port() {
	local pid_file="$PGDATA/postmaster.pid"
	[ -s "$pid_file" ] || return 1
	sed -n '4p' "$pid_file" | tr -cd '0-9'
}

# 0 if a DIFFERENT scoped instance has recorded $1 as its port (even if its
# server is momentarily stopped) — so we never hand the same port to two of them.
port_reserved() {
	local pf p want="$1"
	for pf in "$SCOPED_ROOT"/*/port; do
		[ -f "$pf" ] || continue
		[ "$pf" = "$PORT_FILE" ] && continue
		p="$(cat "$pf" 2>/dev/null || true)"
		[ "$p" = "$want" ] && return 0
	done
	return 1
}

# 0 if the prior recorded port ($PRIOR_PORT_CONTENT) is currently held by THIS
# scope's OWN prior cluster (its recorded datadir has a running postmaster
# actually listening on that port) — as opposed to a FOREIGN scope or an
# unrelated process. rollback_scoped_markers uses this so it never mistakes our
# own already-running server for a cross-scope claimant and wrongly drops the
# marker that points at it (which would itself orphan a live server).
prior_port_owned_by_our_scope() {
	local p
	[ -n "$PRIOR_DATADIR_CONTENT" ] || return 1
	[ -f "$PRIOR_DATADIR_CONTENT/postmaster.pid" ] || return 1
	"$BINDIR/pg_ctl" -D "$PRIOR_DATADIR_CONTENT" status >/dev/null 2>&1 || return 1
	p="$(sed -n '4p' "$PRIOR_DATADIR_CONTENT/postmaster.pid" | tr -cd '0-9')"
	[ "$p" = "$PRIOR_PORT_CONTENT" ]
}

# Pick (or reuse) this scoped instance's port, serialized against other scoped
# instances by a lock on the shared root so two concurrent `up`s never race onto
# the same port. Sets PGPORT and records it in PORT_FILE.
allocate_port() {
	# A wide range so distinct scopes rarely exhaust it — a stopped instance keeps
	# its reservation (so a restart is deterministic), and the scoped root lives on
	# the ephemeral temp fs, so reservations are reclaimed on container recreate.
	local p start=5433 end=6432
	exec 9>"$SCOPED_ROOT/.portlock"
	if ! flock -w 30 9; then
		log "timed out waiting for the scoped port lock ($SCOPED_ROOT/.portlock)."
		exit 1
	fi
	if [ -s "$PORT_FILE" ]; then
		PGPORT="$(cat "$PORT_FILE")"
		flock -u 9
		return 0
	fi
	for ((p = start; p <= end; p++)); do
		port_reserved "$p" && continue
		port_listening "$p" && continue
		PGPORT="$p"
		atomic_write "$PORT_FILE" "$p"
		flock -u 9
		return 0
	done
	flock -u 9
	log "no free loopback port in ${start}-${end} for this scoped instance."
	exit 1
}

# `up` path: resolve the port to start on. Explicit PGPORT wins (used as-is);
# otherwise allocate/reuse under the lock. cmd_up records the EFFECTIVE port in
# PORT_FILE once it knows the real running port, so later url/status/down resolve
# it without re-passing the env var.
scoped_port_for_up() {
	if [ -z "$PGPORT_EXPLICIT" ]; then
		allocate_port
		return 0
	fi
	# Explicit PGPORT still goes through the shared reservation lock, so a
	# concurrent auto-allocating scoped `up` cannot race onto the same port: we
	# take the lock, refuse if ANOTHER scoped instance already reserved this port,
	# then record our reservation before releasing. (The auto-allocator skips any
	# port that appears in another instance's PORT_FILE.)
	exec 9>"$SCOPED_ROOT/.portlock"
	if ! flock -w 30 9; then
		log "timed out waiting for the scoped port lock ($SCOPED_ROOT/.portlock)."
		exit 1
	fi
	if port_reserved "$PGPORT"; then
		flock -u 9
		log "explicit PGPORT $PGPORT is already reserved by another scoped instance; refusing to collide (pick a different PGPORT)."
		exit 1
	fi
	atomic_write "$PORT_FILE" "$PGPORT"
	flock -u 9
}

# read path (url/status/down): resolve the port `up` already chose.
scoped_port_for_read() {
	if [ -n "$PGPORT_EXPLICIT" ]; then
		return 0
	fi
	if [ -s "$PORT_FILE" ]; then
		PGPORT="$(cat "$PORT_FILE")"
	else
		log "no scoped instance for this worktree/profile yet (run 'pg-dev-up ... up' first)."
		exit 1
	fi
}

# Resolve PGDATA / PGPORT / PG_SOCKDIR for the requested command. `portmode` is
# how this command needs the port: `up` allocates, `read` reads a recorded one,
# `stop` resolves the scoped instance but tolerates a MISSING recorded port
# (`down` stops via the recorded data dir alone), `none` (check/help) needs
# neither a port nor a scoped instance.
configure_paths() {
	local portmode="$1"
	# An explicit PGPORT flows into the pg_ctl -o option string (run via a shell) and
	# the DATABASE_URL, so reject anything that is not a bare TCP port up front, in
	# BOTH scoped and unscoped mode, for any command that touches a port. The
	# auto-allocated scoped port is always a safe integer; a value recovered from a
	# marker is re-validated at the point of use in cmd_up.
	if [ -n "$PGPORT_EXPLICIT" ] && [ "$portmode" != none ]; then
		validate_port "$PGPORT"
	fi
	if [ -n "$SCOPED" ] && [ "$portmode" != none ]; then
		resolve_scope "$portmode"
		# For `up`, the port is allocated LATER, inside cmd_up, under the per-scope
		# `.uplock` — together with the marker snapshot and rollback — so a concurrent
		# same-scope `up` cannot race on the reservation or clobber the winner's
		# markers. A read command has no such contention and resolves its recorded
		# port here. `stop` (down) does NOT require the port marker: stopping needs
		# only the recorded data dir, and rollback_scoped_markers legitimately drops
		# the port marker (a prior port now foreign-held) while keeping the datadir
		# marker — teardown must still work then. url/status DO fail on a missing
		# port marker: they report the connection endpoint, which without the
		# recorded port is unknowable.
		case "$portmode" in
			up | stop | destroy) : ;;
			*) scoped_port_for_read ;;
		esac
		# resolve_scope (+ scoped_port_for_read on a read command) set PGDATA and
		# PGPORT to fully scoped values (or already exited on a missing marker); the
		# `up` path sets PGPORT in cmd_up. Return BEFORE the unscoped defaults below so
		# a scoped command can NEVER fall back to /tmp/pgdata:5432 and act on the
		# unrelated unscoped cluster.
		return 0
	fi
	# Unscoped path (and scoped check/help, which touch no cluster): port 5432,
	# and the one unscoped cluster wherever it already is (RAM or disk), else
	# where a new one goes. An explicit PGDATA is taken as given.
	PGPORT="${PGPORT:-5432}"
	if [ -z "$PGDATA_EXPLICIT" ]; then
		if [ "$portmode" = none ]; then
			PGDATA="$UNSCOPED_DISK_PGDATA"
		elif [ "$portmode" = up ]; then
			resolve_managed_datadir
		else
			resolve_managed_datadir quiet
		fi
	fi
	# A scope may record an unscoped default location as its explicit PGDATA, and
	# an explicit PGDATA may point into a scope. Either way the cluster is the
	# scope's: unscoped, `down` would stop it, `status`/`url` would report it on
	# 5432 rather than the scope's port, and `up` would take it over on 5432.
	# `destroy` judges its own candidates (cmd_destroy); check/help touch none.
	case "$portmode" in
		up | stop | read)
			local key
			if key="$(scoped_key_of_datadir "$PGDATA")"; then
				if [ "$portmode" = up ]; then
					log "$PGDATA belongs to scoped instance $key, so an unscoped 'up' will not start it on port $PGPORT. Bring it up through its own scope ('pg-dev-up list' shows its worktree or profile), or give another PGDATA. Nothing was changed."
				else
					log "$PGDATA belongs to scoped instance $key; address it with 'pg-dev-up --instance $key down|status|url'. Nothing was changed."
				fi
				exit 1
			fi
			;;
	esac
}

pg_running() {
	[ -f "$PGDATA/postmaster.pid" ] && "$BINDIR/pg_ctl" -D "$PGDATA" status >/dev/null 2>&1
}

psql_postgres() {
	"$BINDIR/psql" -h "$PG_HOST" -p "$PGPORT" -U postgres -d postgres -v ON_ERROR_STOP=1 "$@"
}

# Pass identifiers/literals as psql variables so psql does the SQL quoting
# (:'var' → quoted string literal, :"var" → quoted identifier), never splicing
# $POSTGRES_* straight into SQL where quotes could break it or inject. The SQL
# is fed on stdin, not via -c: psql only performs :var interpolation when
# reading from stdin/-f — a -c argument is sent to the server verbatim.
role_exists() { [ "$(printf '%s\n' "SELECT 1 FROM pg_roles WHERE rolname = :'rolname'" | psql_postgres -tA -v rolname="$1")" = "1" ]; }
db_exists() { [ "$(printf '%s\n' "SELECT 1 FROM pg_database WHERE datname = :'datname'" | psql_postgres -tA -v datname="$1")" = "1" ]; }

ensure_role_db() {
	if [ "$POSTGRES_USER" != "postgres" ] && ! role_exists "$POSTGRES_USER"; then
		log "Creating role $POSTGRES_USER…"
		printf '%s\n' "CREATE ROLE :\"rolname\" LOGIN SUPERUSER PASSWORD :'rolpass';" |
			psql_postgres -v rolname="$POSTGRES_USER" -v rolpass="$POSTGRES_PASSWORD" >/dev/null
	fi
	if ! db_exists "$POSTGRES_DB"; then
		log "Creating database $POSTGRES_DB (owner $POSTGRES_USER)…"
		"$BINDIR/createdb" -h "$PG_HOST" -p "$PGPORT" -U postgres -O "$POSTGRES_USER" "$POSTGRES_DB" >/dev/null
	fi
}

# Percent-encode a string for safe use as a URL component (RFC 3986: keep the
# unreserved set literal, %-encode everything else). LC_ALL=C makes the loop
# iterate byte-wise so multibyte chars encode correctly.
urlencode() {
	local LC_ALL=C s="$1" i c out=""
	for ((i = 0; i < ${#s}; i++)); do
		c="${s:i:1}"
		case "$c" in
			[A-Za-z0-9.~_-]) out+="$c" ;;
			*)
				printf -v c '%%%02X' "'$c"
				out+="$c"
				;;
		esac
	done
	printf '%s' "$out"
}

print_url() {
	# Percent-encode credentials so metacharacters (@ / # & : etc.) don't
	# corrupt the URL; the consumer percent-decodes per RFC 3986.
	local user pass db url
	user="$(urlencode "$POSTGRES_USER")"
	pass="$(urlencode "$POSTGRES_PASSWORD")"
	db="$(urlencode "$POSTGRES_DB")"
	# Use $PG_HOST (127.0.0.1), not "localhost": the server binds IPv4 only, so
	# a client that resolves localhost to ::1 first would fail to connect.
	#
	# ?sslmode=disable is not decoration: this cluster is initdb'ed without SSL,
	# and Go's lib/pq does NOT fall back to plaintext when the DSN omits the
	# parameter — it fails with "SSL is not enabled on the server", so a Go
	# integration suite pointed at a bare URL breaks until someone appends it by
	# hand. Stating it explicitly is the honest description of a loopback-only
	# trust-auth cluster inside the container security boundary, not a weakening,
	# and `disable` is the one spelling every common client accepts: pgx and
	# libpq/psql attempt TLS and fall back to plaintext when the parameter is
	# absent, node-postgres (`pg` 8.x) attempts no TLS at all (and treats
	# `prefer`/`require` as verify-full aliases, so those spellings FAIL here),
	# but all of them honor an explicit `disable`. Single construction site:
	# `up`, `url`, and `url --export` all emit it.
	url="postgresql://${user}:${pass}@${PG_HOST}:${PGPORT}/${db}?sslmode=disable"
	if [ "${1:-}" = "--export" ]; then
		# %q shell-escapes the value so `eval "$(pg-dev-up url --export)"` is safe
		# — it backslash-escapes the `?` (a glob character), which eval strips
		# back to a literal, so the query parameter survives the round-trip.
		printf 'export DATABASE_URL=%q\n' "$url"
	else
		printf '%s\n' "$url"
	fi
}

# Restore the scoped port/datadir markers to their pre-`up` snapshot (captured by
# snapshot_scoped_markers). Runs from cmd_up's EXIT trap when initialization or
# start fails, so a failed override leaves the previously-running scoped instance's
# markers intact instead of pointing a later down/status at a cluster that never
# started.
#
# FIRST, if THIS `up` may have brought a NEW postmaster live (STARTED_NEW_SERVER),
# STOP it before touching any marker. Otherwise a post-start failure — a start
# that timed out with the postmaster still coming up, or a marker write that
# failed after the server went live — would restore the prior markers and leave a
# LIVE server that scoped status/down can no longer resolve (orphaned). The prior
# markers cannot describe this new server (it is the very thing we are rolling
# back), so the only safe rollback of a started server is to stop it.
#
# The PORT marker is a cross-scope reservation (other scopes' allocate_port scan
# every */port under the shared root), so its restore MUST happen under the shared
# `.portlock`: that keeps the reservation set's mutation atomic w.r.t. a concurrent
# allocator and prevents another scope from allocating the port we release here and
# then colliding with the reservation we recreate. The datadir marker carries no
# cross-scope semantics, so it is restored without the lock.
rollback_scoped_markers() {
	[ -n "$SCOPED" ] || return 0
	# Stop a server THIS invocation started, so rollback can never leave a live
	# postmaster orphaned from scoped status/down. Guard on an actually-running
	# postmaster at $PGDATA: a start that failed with no server left running (e.g.
	# port truly unavailable) leaves nothing to stop, and initdb-only failures never
	# set STARTED_NEW_SERVER at all. A stop failure is loud — a still-running,
	# now-unreferenced server is the exact hazard we must not hide.
	if [ "$STARTED_NEW_SERVER" = yes ] && [ -f "$PGDATA/postmaster.pid" ] &&
		"$BINDIR/pg_ctl" -D "$PGDATA" status >/dev/null 2>&1; then
		if ! "$BINDIR/pg_ctl" -D "$PGDATA" -m fast -w stop >/dev/null 2>&1; then
			log "CRITICAL: this failed 'up' left a postmaster running at $PGDATA and could not stop it; it is now UNREFERENCED by scoped markers. Stop it manually: $BINDIR/pg_ctl -D $PGDATA -m fast stop"
		fi
	fi
	# Reopen + lock the shared port lock (best-effort: still restore on a lock
	# timeout rather than leaking a bogus reservation). fd 9 is closed for the
	# daemonized postmaster in cmd_up, so reopening here is safe.
	exec 9>"$SCOPED_ROOT/.portlock"
	# The port marker is a CROSS-SCOPE reservation; mutating it WITHOUT the shared
	# lock could race a concurrent allocator into a duplicate-port collision — the
	# very hazard locking exists to prevent, and most acute exactly when contention
	# is high enough to time out the lock. So if we cannot take the lock, do NOT
	# mutate the reservation unlocked: surface loudly that it could not be safely
	# rolled back and leave it as-is (the transient reservation keeps that port fenced
	# off, which is safe; a later scoped down+up for this scope reconciles it).
	if flock -w 30 9; then
		if [ "$PRIOR_PORT_EXISTED" = yes ]; then
			# Do NOT blindly recreate the prior reservation. If this `up` used a
			# DIFFERENT port ($PGPORT) from the prior one, the prior port was FREED
			# while we ran — and another scope (or an unrelated process) may have
			# taken it since. Recreating our reservation for a port another SCOPE now
			# holds would double-reserve it and could make a later scoped url resolve
			# to the OTHER scope's server. Detect that under the lock and, if so, drop
			# our own port marker and surface loudly rather than clobbering theirs.
			# `prior_port_owned_by_our_scope` excludes our own already-running prior
			# cluster (whose listener/marker must, of course, be restored, not treated
			# as a foreign claim).
			if [ "$PGPORT" != "$PRIOR_PORT_CONTENT" ] &&
				! prior_port_owned_by_our_scope &&
				{ port_reserved "$PRIOR_PORT_CONTENT" || port_listening "$PRIOR_PORT_CONTENT"; }; then
				rm -f "$PORT_FILE"
				log "cannot restore this scope's prior port reservation ($PRIOR_PORT_CONTENT): it was freed while this 'up' used port $PGPORT and is now reserved by another scope or held by a live server. Leaving that reservation intact and dropping this scope's port marker — run the scoped 'down' then 'up' to get a fresh port."
			else
				atomic_write "$PORT_FILE" "$PRIOR_PORT_CONTENT"
			fi
		else
			rm -f "$PORT_FILE"
		fi
		flock -u 9
	else
		log "could not acquire the scoped port lock ($SCOPED_ROOT/.portlock) to roll back the port reservation; leaving it untouched to avoid an unlocked mutation. If a later scoped url/status resolves the wrong port, run the scoped 'down' then 'up' again."
	fi
	if [ "$PRIOR_DATADIR_EXISTED" = yes ]; then
		atomic_write "$DATADIR_FILE" "$PRIOR_DATADIR_CONTENT"
	else
		rm -f "$DATADIR_FILE"
	fi
}

cmd_up() {
	local actual
	require_bindir
	if [ -n "$SCOPED" ]; then
		# Serialize concurrent `up` for the SAME scope so two callers never race
		# through initdb / pg_ctl start against one data directory. Held (via fd 8)
		# until this process exits.
		exec 8>"$INSTANCE_DIR/.uplock"
		if ! flock -w 60 8; then
			log "timed out waiting for the scoped instance lock ($INSTANCE_DIR/.uplock)."
			exit 1
		fi
		# A `destroy` that held the lock first has removed the instance dir, and
		# with it the file this lock is on; carrying on would re-create the dir
		# outside the owner-only checks in resolve_scope.
		if [ ! -d "$INSTANCE_DIR" ]; then
			log "this scope's cluster was destroyed while this 'up' waited for it; run 'up' again."
			exit 1
		fi
		# Now that we hold the per-scope lock, snapshot the markers and allocate the
		# port — BOTH under the lock. Snapshotting here (not earlier, unlocked) means a
		# concurrent same-scope `up` that lost the lock captures the WINNER's markers
		# once it acquires the lock, so its rollback can only ever restore the winner's
		# state — it can never wipe or orphan the running cluster the winner recorded.
		snapshot_scoped_markers
		# A plain scoped `up` (no explicit PGDATA) must RESUME the instance this
		# scope recorded — which may be an explicit data dir a prior `up` was given —
		# not fall back to the scoped default: `down` advertises a plain scoped `up`
		# as the restart recipe, and a fallback would abandon the recorded cluster's
		# data and start a fresh default cluster on the recorded port. Adopt the
		# recorded dir from the snapshot just taken UNDER the uplock, so a
		# concurrent same-scope `up` can never feed this one a stale marker.
		#
		# The one exception is a recorded MANAGED data dir whose data is gone — a
		# RAM-backed one after a container restart, the marker here having outlived
		# it on disk. There is nothing to resume, and its storage may no longer
		# exist, so choose afresh exactly as for a new scope. A recorded explicit
		# dir is reused even when empty: an explicit location stays authoritative.
		if [ -z "$PGDATA_EXPLICIT" ]; then
			if [ -n "$PRIOR_DATADIR_CONTENT" ] &&
				{ [ -s "$PRIOR_DATADIR_CONTENT/PG_VERSION" ] || ! is_managed_datadir "$PRIOR_DATADIR_CONTENT"; }; then
				PGDATA="$PRIOR_DATADIR_CONTENT"
			else
				[ -z "$PRIOR_DATADIR_CONTENT" ] ||
					log "The data directory this scope recorded ($PRIOR_DATADIR_CONTENT) is gone; creating a fresh cluster."
				resolve_managed_datadir
			fi
		fi
		# Orphan guard: if this scope ALREADY recorded a DIFFERENT data dir whose
		# server is still running, a new explicit PGDATA (one different from the
		# recorded dir — a plain `up` adopts the recorded dir above and cannot
		# trip this) would start a SECOND server and
		# strand the prior one — scoped down/status resolve only the recorded markers,
		# so the old server would never be stopped by scoped teardown. Refuse and
		# require an explicit stop. This runs BEFORE any marker or reservation is
		# mutated, so the plain exit leaves the prior instance and its markers fully
		# intact (no rollback needed).
		if [ "$PRIOR_DATADIR_EXISTED" = yes ] && [ -n "$PRIOR_DATADIR_CONTENT" ] &&
			[ "$PRIOR_DATADIR_CONTENT" != "$PGDATA" ] &&
			[ -f "$PRIOR_DATADIR_CONTENT/postmaster.pid" ] &&
			"$BINDIR/pg_ctl" -D "$PRIOR_DATADIR_CONTENT" status >/dev/null 2>&1; then
			log "this scope already has a running cluster at $PRIOR_DATADIR_CONTENT; starting a new one at $PGDATA would orphan it from scoped teardown. Stop it first (scoped 'down'), then 'up' again."
			exit 1
		fi
		refuse_durability_mismatch
		scoped_port_for_up
		# If initialization or start fails below, roll the markers back to the snapshot
		# just captured. The port reservation is written early (see allocate_port) to
		# fence concurrent allocators, but the recorded data dir / port describing THIS
		# cluster are (re)written only AFTER start succeeds — so a failed override never
		# orphans the previously-running scoped instance or corrupts teardown
		# resolution. Cleared once start succeeds.
		trap 'rollback_scoped_markers' EXIT
	fi
	[ -n "$SCOPED" ] || refuse_durability_mismatch
	resolve_credentials up
	if pg_running; then
		# In SCOPED mode only, talk to the port the cluster ACTUALLY listens on (not
		# a possibly-mismatched requested $PGPORT), so we never create roles/db on an
		# unrelated server that happens to sit on the requested port. Unscoped mode
		# keeps its historical port behavior — it just reports the requested port
		# rather than probing for the one the cluster actually listens on.
		if [ -n "$SCOPED" ]; then
			actual="$(running_port || true)"
			if [ -n "$actual" ] && [ "$actual" != "$PGPORT" ]; then
				# An EXPLICIT PGPORT is authoritative: if it conflicts with the port the
				# cluster is actually running on, FAIL rather than silently adopting the
				# running port and ignoring the override. A non-explicit (auto-allocated
				# or recorded) PGPORT that disagrees with reality is corrected to the real
				# running port — a stale marker must not make us report the wrong port.
				if [ -n "$PGPORT_EXPLICIT" ]; then
					log "scope already running on port $actual; explicit PGPORT=$PGPORT conflicts — stop it first (scoped 'down') or drop the PGPORT override."
					exit 1
				fi
				log "Cluster at $PGDATA is already running on port $actual (ignoring recorded $PGPORT; run 'down' first to change it)."
				PGPORT="$actual"
			fi
		fi
		log "Already running on $PG_HOST:$PGPORT."
	else
		# Not our cluster running: in scoped mode, refuse to start onto a port
		# another process already holds (e.g. a stale recorded port now taken),
		# rather than colliding with an unrelated server. Unscoped keeps its
		# historical behavior (pg_ctl surfaces the bind failure).
		if [ -n "$SCOPED" ] && port_listening "$PGPORT"; then
			log "scoped port $PGPORT is already in use by another process; refusing to start (free it or set a different PGPORT)."
			exit 1
		fi
		if ! init_and_start; then
			recover_unstartable_cluster
		fi
	fi
	# Start (or an already-running detection) succeeded: NOW record the effective
	# data dir and port so url/status/down resolve the exact server this `up`
	# settled on, then drop the rollback trap — a later ensure_role_db failure must
	# not undo markers that correctly describe the now-running cluster.
	if [ -n "$SCOPED" ]; then
		atomic_write "$DATADIR_FILE" "$PGDATA"
		atomic_write "$PORT_FILE" "$PGPORT"
		trap - EXIT
		write_owner_record
	fi
	ensure_role_db
	record_credentials
	# Recommend the SCOPE-CORRECT export recipe: an unscoped `url --export` would
	# export the /tmp:5432 cluster's URL, not this scoped instance's.
	local export_cmd="pg-dev-up url --export"
	if [ -n "$SCOPED" ]; then
		if [ "$SCOPE_MODE" = profile ]; then
			export_cmd="pg-dev-up --profile $SCOPE_PROFILE_ID url --export"
		else
			export_cmd="pg-dev-up --worktree url --export"
		fi
	fi
	describe_cluster
	log "Ready. DATABASE_URL printed below; export it with: eval \"\$($export_cmd)\""
	print_url
}

cmd_down() {
	require_bindir
	if pg_running; then
		"$BINDIR/pg_ctl" -D "$PGDATA" -m fast -w stop >/dev/null
		# Show the SCOPE-CORRECT restart recipe: for a scoped instance a plain
		# `pg-dev-up` would start the UNSCOPED /tmp:5432 cluster, not this one.
		local restart="run 'pg-dev-up' to restart"
		if [ -n "$SCOPED" ]; then
			case "$SCOPE_MODE" in
				profile) restart="run 'pg-dev-up --profile $SCOPE_PROFILE_ID up' to restart" ;;
				instance) restart="restart it with 'up' from its worktree or profile; 'pg-dev-up --instance $SCOPE_KEY destroy' removes it" ;;
				*) restart="run 'pg-dev-up --worktree up' to restart" ;;
			esac
		fi
		if [ "$(storage_of "$PGDATA")" = ram ]; then
			log "Stopped. Data kept in RAM at $PGDATA until the container stops ($restart)."
		else
			log "Stopped. Data kept at $PGDATA ($restart)."
		fi
	else
		log "Not running."
	fi
}

# One line on the credentials `url` prints for $PGDATA, and any disagreement.
describe_credentials() {
	if [ -n "$REC_HAS_CREDS" ]; then
		log "credentials: role $POSTGRES_USER, database $POSTGRES_DB (as 'up' recorded them)"
	elif [ -s "$PGDATA/PG_VERSION" ]; then
		log "credentials: not recorded for this cluster; 'url' uses your environment (role $POSTGRES_USER, database $POSTGRES_DB)"
	fi
	[ -z "$CRED_CONFLICT" ] || log "WARNING: $(credential_conflict_text) Until then 'url' refuses."
}

cmd_status() {
	require_bindir
	resolve_credentials read
	if pg_running; then
		log "running on $PG_HOST:$PGPORT (PGDATA=$PGDATA)"
		describe_cluster
		describe_credentials
		ram_full_hint "$PGDATA"
	else
		log "not running (PGDATA=$PGDATA)"
		describe_cluster
		describe_credentials
		ram_full_hint "$PGDATA"
		return 1
	fi
}

cmd_url() {
	resolve_credentials read
	if [ -n "$CRED_CONFLICT" ]; then
		log "refusing to print a URL: $(credential_conflict_text)"
		exit 1
	fi
	print_url "${1:-}"
}

cmd_check() {
	require_bindir
	"$BINDIR/initdb" --version
	"$BINDIR/postgres" --version
	if ram_usable; then
		log "RAM-backed storage: available at $PG_RAM_ROOT ($(fs_usage_text "$PG_RAM_ROOT" || printf 'usage unknown'))."
	else
		log "RAM-backed storage: not available ($RAM_UNAVAILABLE_REASON); new clusters go on disk."
	fi
}

# --- owner record, list, destroy --------------------------------------------

is_scope_key() { [[ $1 =~ ^[0-9a-f]{16}$ ]]; }

# Record whose scoped instance this is, so `list` can tell after the instance's
# name (a hash) no longer does: the worktree's toplevel and common Git dir, or
# the profile id. Rewritten by every scoped `up`; a marker like the others, so
# losing it costs only the owner `list` shows.
write_owner_record() {
	local text common top
	text="format=1"
	if [ "$SCOPE_MODE" = profile ]; then
		text+=$'\nmode=profile\nprofile='"$(urlencode "$SCOPE_PROFILE_ID")"
	else
		common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
		top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
		text+=$'\nmode=worktree\ntoplevel='"$(urlencode "$top")"$'\ngitdir='"$(urlencode "$common")"
	fi
	text+=$'\ncontainer='"$(urlencode "${CONTAINER_NAME:-}")"
	atomic_write "$OWNER_FILE" "$text" ||
		log "warning: could not record this scope's owner in $OWNER_FILE; 'list' will show it as unknown."
}

# 0 if $1 is still the toplevel of a Git worktree. A directory that lost its
# `.git` resolves upward to an enclosing repository and so does not count.
worktree_present() {
	[ -d "$1" ] && [ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null || true)" = "$1" ]
}

# Set O_KIND (worktree | profile | scoped), O_STATE (present | gone | unknown
# | -) and O_OWNER for the scoped instance dir $1, from its owner record.
owner_info() {
	local mode=""
	O_KIND=scoped
	O_STATE=unknown
	O_OWNER=""
	mode="$(kv_get "$1/owner" mode || true)"
	case "$mode" in
		worktree)
			kv_get_decoded O_OWNER "$1/owner" toplevel || O_OWNER=""
			[ -n "$O_OWNER" ] || return 0
			O_KIND=worktree
			if worktree_present "$O_OWNER"; then O_STATE=present; else O_STATE=gone; fi
			;;
		profile)
			kv_get_decoded O_OWNER "$1/owner" profile || O_OWNER=""
			[ -n "$O_OWNER" ] || return 0
			O_KIND=profile
			O_STATE=-
			;;
	esac
}

# One tab-separated line; an empty field becomes `-`, and a tab or newline in a
# value becomes `?`, so every line has the same eleven fields.
tsv_row() {
	local f out="" first=yes
	for f in "$@"; do
		f="${f:--}"
		f="${f//$'\t'/?}"
		f="${f//$'\n'/?}"
		if [ -n "$first" ]; then out="$f"; else out+=$'\t'"$f"; fi
		first=""
	done
	printf '%s\n' "$out"
}

# Add a `list --porcelain` row: kind key state port durability storage
# owner-state owner user database datadir. <datadir> may be empty (unknown).
LIST_ROWS=()
list_cluster() {
	local kind="$1" key="$2" d="$3" port="" mport="$4" ostate="$5" owner="$6"
	local state=nodata dur="" storage="" user="" db="" u="" b=""
	if [ -n "$d" ]; then
		if cluster_running_at "$d"; then
			state=running
			port="$(sed -n '4p' "$d/postmaster.pid" 2>/dev/null | tr -cd '0-9' || true)"
		elif [ -s "$d/PG_VERSION" ]; then
			state=stopped
		fi
	fi
	if [ "$state" != nodata ]; then
		if [ -f "$d/$CLUSTER_RECORD" ]; then dur="$(cluster_durability "$d")"; else dur=unrecorded; fi
		storage="$(storage_of "$d")"
		if kv_get_decoded u "$d/$CLUSTER_RECORD" user && kv_get_decoded b "$d/$CLUSTER_RECORD" database; then
			user="$u"
			db="$b"
		fi
	fi
	[ -n "$port" ] || port="$mport"
	LIST_ROWS+=("$(tsv_row "$kind" "$key" "$state" "$port" "$dur" "$storage" "$ostate" "$owner" "$user" "$db" "$d")")
}

# The human form of one porcelain row ($1..$11 as in list_cluster).
render_cluster() {
	local kind="$1" key="$2" state="$3" port="$4" dur="$5" storage="$6" ostate="$7" owner="$8" user="$9" db="${10}" d="${11}"
	local title what remove="pg-dev-up --instance $key destroy"
	case "$kind" in
		unscoped)
			title="unscoped cluster"
			remove="pg-dev-up destroy"
			;;
		explicit)
			title="cluster at the PGDATA you gave"
			remove="PGDATA=$(printf '%q' "$d") pg-dev-up destroy"
			;;
		worktree)
			title="scoped instance $key, worktree $owner"
			[ "$ostate" != gone ] || title+=" (which no longer exists)"
			;;
		profile) title="scoped instance $key, profile $owner" ;;
		*) title="scoped instance $key, owner not recorded" ;;
	esac
	case "$state" in
		running) what="running on $PG_HOST:$port" ;;
		stopped)
			what="stopped"
			[ "$port" = - ] || what+=" (port $port reserved)"
			;;
		*) what="no data (its data directory is gone; only markers remain)" ;;
	esac
	if [ "$state" != nodata ]; then
		case "$dur" in
			nondurable) what+=", non-durable" ;;
			durable) what+=", durable" ;;
			*) what+=", durable, without a pg-dev-up record" ;;
		esac
		if [ "$storage" = ram ]; then what+=", data in RAM"; else what+=", data on disk"; fi
	fi
	printf '%s\n  %s\n' "$title" "$what"
	[ "$d" = - ] || printf '  data: %s\n' "$d"
	[ "$user" = - ] || printf '  role %s, database %s\n' "$user" "$db"
	if [ "$dur" = unrecorded ]; then
		printf '  remove: %s refuses it, as nothing proves pg-dev-up created it\n' "$remove"
	else
		printf '  remove: %s\n' "$remove"
	fi
}

# Read-only by design: no lock, no mkdir, no write, so a concurrent `up` (whose
# port reservation the .portlock guards) is never disturbed. Instances owned by
# another user are skipped, as every scoped command refuses them.
cmd_list() {
	local fmt="$1" inst key d c mport row
	# Keyed by resolved path, so one data directory is listed once however its
	# record spells it.
	local -A seen_dirs=() seen_keys=()
	local -a f
	case "$fmt" in
		'' | --porcelain) : ;;
		*)
			log "unknown 'list' option '$fmt' (try: --porcelain)"
			exit 2
			;;
	esac
	require_bindir
	for d in "$PG_RAM_BASE/pgdata" "$UNSCOPED_DISK_PGDATA"; do
		[ -s "$d/PG_VERSION" ] || continue
		# A scope may record an unscoped default location as its explicit
		# PGDATA; its own row below lists it, with the removal that works.
		! scoped_key_of_datadir "$d" >/dev/null || continue
		list_cluster unscoped "" "$d" "" "" ""
		seen_dirs["$(realpath -m -- "$d")"]=1
	done
	for inst in "$SCOPED_ROOT"/*/; do
		[ -d "$inst" ] || continue
		inst="${inst%/}"
		key="${inst##*/}"
		is_scope_key "$key" && [ -O "$inst" ] || continue
		d=""
		[ ! -s "$inst/datadir" ] || d="$(cat -- "$inst/datadir" 2>/dev/null || true)"
		if [ -z "$d" ]; then
			for c in "$inst/pgdata" "$PG_RAM_BASE/$key/pgdata"; do
				if [ -e "$c" ]; then
					d="$c"
					break
				fi
			done
		fi
		mport=""
		[ ! -s "$inst/port" ] || mport="$(cat -- "$inst/port" 2>/dev/null || true)"
		owner_info "$inst"
		list_cluster "$O_KIND" "$key" "$d" "$mport" "$O_STATE" "$O_OWNER"
		seen_keys["$key"]=1
		[ -z "$d" ] || seen_dirs["$(realpath -m -- "$d")"]=1
	done
	# RAM data no listed instance records: an instance made under another
	# POWBOX_PG_SCOPED_ROOT, one whose markers were removed, or one whose scope
	# has since recorded another data directory. It still holds memory, so it is
	# listed, under its scope's owner where that scope is listed (whose own
	# `destroy` removes it), else with an unknown owner.
	for d in "$PG_RAM_BASE"/*/pgdata; do
		[ -e "$d" ] || continue
		key="${d%/pgdata}"
		key="${key##*/}"
		is_scope_key "$key" && [ -z "${seen_dirs["$(realpath -m -- "$d")"]:-}" ] || continue
		if [ -n "${seen_keys["$key"]:-}" ]; then
			owner_info "$SCOPED_ROOT/$key"
			list_cluster "$O_KIND" "$key" "$d" "" "$O_STATE" "$O_OWNER"
		else
			list_cluster scoped "$key" "$d" "" unknown ""
		fi
		seen_dirs["$(realpath -m -- "$d")"]=1
	done
	if [ -n "$PGDATA_EXPLICIT" ]; then
		d="$PGDATA"
		case "$d" in /*) : ;; *) d="$(realpath -m -- "$d")" ;; esac
		if [ -s "$d/PG_VERSION" ] && [ -z "${seen_dirs["$(realpath -m -- "$d")"]:-}" ]; then
			list_cluster explicit "" "$d" "" "" ""
		fi
	fi
	if [ "$fmt" = --porcelain ]; then
		[ "${#LIST_ROWS[@]}" -eq 0 ] || printf '%s\n' "${LIST_ROWS[@]}"
		return 0
	fi
	if [ "${#LIST_ROWS[@]}" -eq 0 ]; then
		printf 'No pg-dev-up clusters found.\n'
	else
		c=""
		for row in "${LIST_ROWS[@]}"; do
			IFS=$'\t' read -r -a f <<<"$row"
			[ -z "$c" ] || printf '\n'
			render_cluster "${f[@]}"
			c=yes
		done
	fi
	log "An unscoped cluster made with an explicit PGDATA is listed only while PGDATA names it."
}

# If $1 lies inside a scoped instance (its instance dir under the scoped root, or
# its RAM-backed data) or is the data directory an instance recorded, print that
# instance's key. Both the lexical and the symlink-resolved path are compared, so
# neither `//`, `.` nor a link can disguise a scope's data as unscoped.
scoped_key_of_datadir() {
	local p root rest f
	local -a paths roots
	paths=("$(realpath -m -s -- "$1")" "$(realpath -m -- "$1")")
	roots=("$SCOPED_ROOT" "$(realpath -m -- "$SCOPED_ROOT")" "$PG_RAM_BASE" "$(realpath -m -- "$PG_RAM_BASE")")
	for p in "${paths[@]}"; do
		for root in "${roots[@]}"; do
			case "$p/" in
				"$root"/*/*)
					rest="${p#"$root"/}"
					rest="${rest%%/*}"
					if is_scope_key "$rest"; then
						printf '%s\n' "$rest"
						return 0
					fi
					;;
			esac
		done
	done
	for f in "$SCOPED_ROOT"/*/datadir; do
		[ -s "$f" ] && [ -O "$f" ] || continue
		rest="${f%/datadir}"
		rest="${rest##*/}"
		is_scope_key "$rest" || continue
		if [ "$(realpath -m -- "$(cat -- "$f" 2>/dev/null)" 2>/dev/null)" = "${paths[1]}" ]; then
			printf '%s\n' "$rest"
			return 0
		fi
	done
	return 1
}

# Judge whether `destroy` may remove the data directory $1. Sets VERDICT to
# absent | empty | ours | refuse, and DESTROY_REASON for a refusal. `ours`
# needs both a cluster and the record only pg-dev-up writes, in a directory the
# caller owns, so an explicit PGDATA can never point destroy at anything else.
destroy_verdict() {
	local d="$1"
	VERDICT=refuse
	DESTROY_REASON=""
	if [ -L "$d" ]; then
		DESTROY_REASON="$d is a symbolic link, not a data directory pg-dev-up made"
	elif [ ! -e "$d" ]; then
		VERDICT=absent
	elif [ ! -d "$d" ]; then
		DESTROY_REASON="$d is not a directory"
	elif [ ! -O "$d" ]; then
		DESTROY_REASON="$d is owned by another user"
	elif [ -z "$(ls -A -- "$d" 2>/dev/null)" ]; then
		VERDICT=empty
	elif [ -s "$d/PG_VERSION" ] && [ -f "$d/$CLUSTER_RECORD" ]; then
		VERDICT=ours
	elif [ -s "$d/PG_VERSION" ]; then
		DESTROY_REASON="$d holds a PostgreSQL cluster without pg-dev-up's $CLUSTER_RECORD record (made before pg-dev-up kept one, or not by pg-dev-up), so nothing proves pg-dev-up created it"
	else
		DESTROY_REASON="$d is not empty and holds no PostgreSQL cluster, so pg-dev-up did not create it"
	fi
}

cmd_destroy() {
	local d recorded="" key refused="" i what
	local -a cands=() found=() verdicts=() kept=() managed=()
	require_bindir
	if [ -n "$SCOPED" ]; then
		# Hold the scope's `up` lock, so a concurrent same-scope `up` either
		# finishes first (and is destroyed) or finds the scope gone.
		if [ -d "$INSTANCE_DIR" ]; then
			exec 8>"$INSTANCE_DIR/.uplock"
			if ! flock -w 60 8; then
				log "timed out waiting for the scoped instance lock ($INSTANCE_DIR/.uplock)."
				exit 1
			fi
		fi
		[ ! -s "$DATADIR_FILE" ] || recorded="$(cat -- "$DATADIR_FILE")"
		if [ -n "$PGDATA_EXPLICIT" ] && { [ -z "$recorded" ] ||
			[ "$(realpath -m -s -- "$PGDATA")" != "$(realpath -m -s -- "$recorded")" ]; }; then
			log "a scoped 'destroy' removes the cluster this scope recorded${recorded:+ ($recorded)}; PGDATA=$PGDATA names another directory, so nothing was removed. Drop PGDATA, or run 'destroy' without a scope flag to destroy the cluster at that PGDATA."
			exit 1
		fi
		[ -z "$recorded" ] || cands+=("$recorded")
		cands+=("$INSTANCE_DIR/pgdata" "$PG_RAM_BASE/$SCOPE_KEY/pgdata")
	elif [ -n "$PGDATA_EXPLICIT" ]; then
		# Lexically (`-s` follows no symlink), so a link stays a link for
		# destroy_verdict to refuse, however it is spelled: relative, or with the
		# trailing slash tab completion adds (which `[ -L ]` would see through).
		PGDATA="$(realpath -m -s -- "$PGDATA")"
		if key="$(scoped_key_of_datadir "$PGDATA")"; then
			log "$PGDATA belongs to scoped instance $key; destroy it with 'pg-dev-up --instance $key destroy', which removes its markers too. Nothing was removed."
			exit 1
		fi
		cands+=("$PGDATA")
	else
		# A scope may record either default location as its explicit PGDATA,
		# and then the cluster there is that scope's, exactly as above.
		for d in "$(managed_datadir disk)" "$(managed_datadir ram)"; do
			if { [ -e "$d" ] || [ -L "$d" ]; } && key="$(scoped_key_of_datadir "$d")"; then
				log "$d belongs to scoped instance $key; destroy it with 'pg-dev-up --instance $key destroy', which removes its markers too. Nothing was removed."
				exit 1
			fi
			cands+=("$d")
		done
	fi
	managed=("$(realpath -m -s -- "$(managed_datadir disk)")" "$(realpath -m -s -- "$(managed_datadir ram)")")
	# Judge every candidate before touching any, so a refusal removes nothing.
	# An empty directory is pg-dev-up's only at a location it chose itself; an
	# explicit one may be any empty directory the caller owns, so it stays.
	for d in "${cands[@]}"; do
		d="$(realpath -m -s -- "$d")"
		for i in "${found[@]}" "${kept[@]}"; do [ "$i" != "$d" ] || continue 2; done
		destroy_verdict "$d"
		case "$VERDICT" in
			absent) ;;
			refuse) refused+="${refused:+ }$DESTROY_REASON." ;;
			empty)
				if [ "$d" = "${managed[0]}" ] || [ "$d" = "${managed[1]}" ]; then
					found+=("$d")
					verdicts+=(empty)
				else
					kept+=("$d")
				fi
				;;
			*)
				found+=("$d")
				verdicts+=("$VERDICT")
				;;
		esac
	done
	if [ -n "$refused" ]; then
		log "refusing to destroy: $refused Nothing was removed; if it is yours, delete it yourself, then run 'destroy' again."
		exit 1
	fi
	for d in "${found[@]}"; do
		cluster_running_at "$d" || continue
		log "Stopping the cluster at $d…"
		if ! "$BINDIR/pg_ctl" -D "$d" -m fast -w stop >/dev/null; then
			log "could not stop the cluster at $d (see $d/server.log); it was not removed."
			exit 1
		fi
	done
	for i in "${!found[@]}"; do
		d="${found[$i]}"
		if [ "${verdicts[$i]}" = ours ]; then
			what="the cluster"
			rm -rf -- "$d" || {
				log "could not remove all of $d."
				exit 1
			}
		else
			what="the empty data directory"
			rmdir -- "$d" || exit 1
		fi
		log "Removed $what at $d."
	done
	for d in "${kept[@]}"; do
		log "Left the empty directory at $d in place: it is not a location pg-dev-up chose, so nothing marks it as one pg-dev-up created."
	done
	if [ -n "$SCOPED" ]; then
		[ ! -d "$PG_RAM_BASE/$SCOPE_KEY" ] || rmdir -- "$PG_RAM_BASE/$SCOPE_KEY" 2>/dev/null || true
		if [ -d "$INSTANCE_DIR" ]; then
			# Only the files pg-dev-up keeps there: the markers (and a temp file an
			# interrupted atomic_write left), the lock, and the server's socket.
			rm -f -- "$PORT_FILE" "$DATADIR_FILE" "$OWNER_FILE" "$PORT_FILE".?????? "$DATADIR_FILE".?????? \
				"$OWNER_FILE".?????? "$INSTANCE_DIR"/.s.PGSQL.* "$INSTANCE_DIR/.uplock"
			if ! rmdir -- "$INSTANCE_DIR" 2>/dev/null; then
				log "$INSTANCE_DIR holds files pg-dev-up did not put there, so it was left in place: $(find "$INSTANCE_DIR" -mindepth 1 -maxdepth 1 -printf '%f ')"
				exit 1
			fi
			log "Removed scoped instance $SCOPE_KEY."
			return 0
		fi
	fi
	[ "${#found[@]}" -eq 0 ] && [ "${#kept[@]}" -eq 0 ] || return 0
	if [ -n "$SCOPED" ]; then
		log "No cluster to destroy: scoped instance $SCOPE_KEY has no markers or data."
	else
		log "No cluster to destroy (nothing at ${cands[*]})."
	fi
}

# Print the header comment block as help. Derive its extent (line 2 through the
# first line that is neither a `#` comment nor blank, i.e. everything before
# `set -euo pipefail`) instead of hard-coding an end line: a hard-coded range
# silently truncates the help the next time someone adds a paragraph to the
# header. Blank lines are tolerated as well as bare `#` separators, so a future
# editor cannot truncate the help by separating paragraphs the other way — but
# the header must stay one uninterrupted block ending immediately before the
# first real statement.
usage() { sed -n '2,${/^\(#\|$\)/!q; s/^#\{1\} \{0,1\}//; p; }' "$0"; }

# Consume a leading scope flag (--worktree / --profile <id>) BEFORE the command;
# everything after the flag is the command and its own arguments (e.g. the
# `--export` that `url` takes), so we stop at the first non-scope token.
while [ $# -gt 0 ]; do
	case "$1" in
		--worktree)
			SCOPED=1
			SCOPE_MODE=worktree
			shift
			;;
		--profile)
			SCOPED=1
			SCOPE_MODE=profile
			shift
			[ $# -gt 0 ] || {
				log "--profile requires an identifier"
				exit 2
			}
			SCOPE_PROFILE_ID="$1"
			shift
			;;
		--profile=*)
			SCOPED=1
			SCOPE_MODE=profile
			SCOPE_PROFILE_ID="${1#--profile=}"
			shift
			;;
		--instance)
			SCOPED=1
			SCOPE_MODE=instance
			shift
			[ $# -gt 0 ] || {
				log "--instance requires the key 'pg-dev-up list' shows"
				exit 2
			}
			SCOPE_INSTANCE_KEY="$1"
			shift
			;;
		--instance=*)
			SCOPED=1
			SCOPE_MODE=instance
			SCOPE_INSTANCE_KEY="${1#--instance=}"
			shift
			;;
		--)
			shift
			break
			;;
		*) break ;;
	esac
done

if [ "$SCOPE_MODE" = profile ]; then
	case "$SCOPE_PROFILE_ID" in
		'') log "--profile requires a non-empty identifier"; exit 2 ;;
		*[!A-Za-z0-9._-]*) log "invalid --profile id (allowed: A-Za-z0-9._-)"; exit 2 ;;
	esac
fi
if [ "$SCOPE_MODE" = instance ] && ! is_scope_key "$SCOPE_INSTANCE_KEY"; then
	log "invalid --instance key '$SCOPE_INSTANCE_KEY': it is the 16-hex-digit key 'pg-dev-up list' shows."
	exit 2
fi

case "${1:-up}" in
	up | "")
		if [ "$SCOPE_MODE" = instance ]; then
			log "--instance selects an existing cluster for status, url, down or destroy; 'up' needs --worktree or --profile."
			exit 2
		fi
		configure_paths up
		cmd_up
		;;
	down | stop)
		configure_paths stop
		cmd_down
		;;
	status)
		configure_paths read
		cmd_status
		;;
	url)
		configure_paths read
		shift
		cmd_url "${1:-}"
		;;
	destroy)
		configure_paths destroy
		cmd_destroy
		;;
	list)
		if [ -n "$SCOPED" ]; then
			log "'list' shows every cluster; it takes no --worktree, --profile or --instance."
			exit 2
		fi
		shift
		cmd_list "${1:-}"
		;;
	check)
		configure_paths none
		cmd_check
		;;
	help | -h | --help)
		usage
		;;
	*)
		log "unknown command '$1' (try: up, down, destroy, status, url, list, check, help)"
		exit 2
		;;
esac
